{
  "name": "@onwidget/astrowind",
  "version": "1.0.0-beta.52",
  "description": "AstroWind: A free template using Astro 5.0 and Tailwind CSS. Astro starter theme.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/psa-content-gate.mjs && astro build",
    "gate": "node scripts/psa-content-gate.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "npm run check:astro && npm run check:eslint && npm run check:prettier",
    "check:astro": "astro check",
    "check:eslint": "eslint .",
    "check:prettier": "prettier --check .",
    "fix": "npm run fix:eslint && npm run fix:prettier",
    "fix:eslint": "eslint --fix .",
    "fix:prettier": "prettier -w .",
    "indexnow": "node scripts/indexnow-submit.mjs",
    "check-blog": "node scripts/check-blog.mjs",
    "check-links": "node scripts/check-links.mjs",
    "publish-gate": "node scripts/publish-gate.mjs",
    "smoke": "node scripts/smoke-routes.mjs",
    "setup-hooks": "node scripts/install-hooks.mjs",
    "test:scripts": "node --test scripts/tests/*.test.mjs",
    "sitemap-diff": "node scripts/competitor-sitemap-diff.mjs",
    "llm-citations": "node scripts/llm-citation-check.mjs",
    "keyword-check": "node scripts/check-keyword-registry.mjs",
    "target-positions": "node scripts/target-positions.mjs",
    "change-log": "node scripts/change-log.mjs",
    "site-hygiene": "node scripts/site-hygiene.mjs",
    "competitor-watch": "node scripts/competitor-page-watch.mjs",
    "cold-read": "node scripts/cold-read-score.mjs",
    "gsc-pull": "node scripts/gsc-pull.mjs",
    "gsc-diagnose": "node scripts/gsc-diagnose.mjs",
    "seo-desk": "node seo-desk/server.mjs",
    "test:seo-desk": "node --test seo-desk/tests/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.1.2",
    "@astrolib/analytics": "^0.6.1",
    "@astrolib/seo": "^1.0.0-beta.8",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.6",
    "astro": "^7.4.7",
    "astro-icon": "^1.2.0",
    "limax": "4.1.0",
    "lodash.merge": "^4.6.2",
    "svelte": "^5.57.3",
    "unpic": "^4.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/partytown": "^2.1.9",
    "@eslint/js": "^9.33.0",
    "@iconify-json/flat-color-icons": "^1.2.1",
    "@iconify-json/tabler": "^1.2.20",
    "@tailwindcss/typography": "^0.5.16",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash.merge": "^4.6.9",
    "@types/mdx": "^2.0.13",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "astro-compress": "2.4.3",
    "astro-eslint-parser": "^1.2.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.33.0",
    "eslint-plugin-astro": "^1.3.1",
    "globals": "^16.3.0",
    "js-yaml": "^4.1.0",
    "mdast-util-to-string": "^4.0.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "reading-time": "^1.5.0",
    "sharp": "0.35.5",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1",
    "unist-util-visit": "^5.0.0"
  },
  "overrides": {
    "sharp": "$sharp",
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^6.1.5"
    },
    "picomatch@^2": "^2.3.2",
    "astro-compress": {
      "svgo": "^4.1.0",
      "deepmerge-ts": "^8.0.2"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    },
    "@astrolib/seo": {
      "astro": "$astro"
    },
    "@astrolib/analytics": {
      "astro": "$astro"
    }
  }
}
