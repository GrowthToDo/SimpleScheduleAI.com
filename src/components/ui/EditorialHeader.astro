---
// Editorial section header: left-aligned eyebrow + serif title, supporting
// text in a right column, oversized ghost numeral. Replaces centered Headline
// for homepage narrative sections.
export interface Props {
  number?: string;
  tagline?: string;
  title: string;
  subtitle?: string;
  isDark?: boolean;
  class?: string;
}

const { number, tagline, title, subtitle, isDark = false, class: className = 'mb-9 md:mb-11' } = Astro.props;
---

<div class:list={['grid gap-5 lg:grid-cols-12 lg:items-end relative', className]} data-reveal>
  {
    number && (
      <span
        class:list={[
          'hidden lg:block absolute -top-[5.25rem] left-0 font-heading text-[5.5rem] leading-none select-none pointer-events-none',
          isDark ? 'text-[#8FB3A3]/15' : 'text-primary/10',
        ]}
        aria-hidden="true"
      >
        {number}
      </span>
    )
  }
  <div class="lg:col-span-7">
    {
      tagline && (
        <p
          class:list={[
            'mb-3 text-xs font-medium uppercase tracking-[0.18em]',
            isDark ? 'text-[#8FB3A3]' : 'text-primary',
          ]}
          set:html={tagline}
        />
      )
    }
    <h2
      class:list={[
        'font-semibold leading-tight tracking-tight font-heading text-3xl sm:text-4xl text-left',
        isDark ? 'text-[#F2F5F5]' : 'text-default',
      ]}
      set:html={title}
    />
  </div>
  {
    subtitle && (
      <div class="lg:col-span-5">
        <p
          class:list={['text-lg leading-relaxed lg:pb-1', isDark ? 'text-[#F2F5F5]/60' : 'text-muted']}
          set:html={subtitle}
        />
      </div>
    )
  }
</div>
