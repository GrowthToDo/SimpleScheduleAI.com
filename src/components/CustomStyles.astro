---
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces';
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Fraunces Variable';
    --aw-font-heading: 'Fraunces Variable';

    /* Warm Editorial palette — see docs/superpowers/specs/2026-06-12-premium-redesign-warm-editorial-design.md */
    --aw-color-primary: rgb(45 90 74); /* forest green */
    --aw-color-secondary: rgb(35 71 57); /* green hover */
    --aw-color-accent: rgb(45 90 74);

    --aw-color-text-heading: rgb(26 35 50); /* ink navy */
    --aw-color-text-default: rgb(26 35 50);
    --aw-color-text-muted: rgb(26 35 50 / 64%);
    --aw-color-bg-page: rgb(250 247 242); /* warm ivory */

    --aw-color-bg-page-dark: rgb(26 35 50); /* ink navy anchor */

    --aw-color-hairline: rgb(26 35 50 / 12%);

    ::selection {
      background-color: rgb(45 90 74 / 18%);
    }
  }

  h1,
  h2,
  h3 {
    font-family: var(--aw-font-heading);
    font-weight: 560;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  body {
    font-feature-settings:
      'liga' 1,
      'kern' 1;
    -webkit-font-smoothing: antialiased;
  }

  a {
    text-underline-offset: 3px;
  }
</style>
