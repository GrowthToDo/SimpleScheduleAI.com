---
// Clinical Calm design system (docs/design/DESIGN.md) — Erode + Author, self-hosted
// variable fonts from Fontshare (public/fonts), slate/sage/mist tokens.
---

<style is:inline>
  @font-face {
    font-family: 'Erode-Variable';
    src: url('/fonts/Erode-Variable.woff2') format('woff2');
    font-weight: 300 700;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Erode-Variable';
    src: url('/fonts/Erode-VariableItalic.woff2') format('woff2');
    font-weight: 300 700;
    font-style: italic;
    font-display: swap;
  }
  @font-face {
    font-family: 'Author-Variable';
    src: url('/fonts/Author-Variable.woff2') format('woff2');
    font-weight: 200 700;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Author-Variable';
    src: url('/fonts/Author-VariableItalic.woff2') format('woff2');
    font-weight: 200 700;
    font-style: italic;
    font-display: swap;
  }

  :root {
    --aw-font-sans: 'Author-Variable';
    --aw-font-serif: 'Erode-Variable';
    --aw-font-heading: 'Erode-Variable';

    /* Clinical Calm palette — see docs/design/DESIGN.md */
    --aw-color-primary: rgb(52 73 92); /* slate blue */
    --aw-color-secondary: rgb(42 59 76); /* slate hover */
    --aw-color-accent: rgb(52 73 92);

    --aw-color-text-heading: rgb(42 49 56); /* graphite ink */
    --aw-color-text-default: rgb(42 49 56);
    --aw-color-text-muted: rgb(42 49 56 / 64%);
    --aw-color-bg-page: rgb(242 245 245); /* mist */

    --aw-color-bg-page-dark: rgb(42 49 56); /* graphite anchor */

    --aw-color-hairline: rgb(42 49 56 / 12%);

    ::selection {
      background-color: rgb(52 73 92 / 18%);
    }
  }

  /* Author/Erode have a smaller x-height than the previous Inter/Fraunces;
     +6.25% root compensation keeps effective text size unchanged for readers. */
  html {
    font-size: 106.25%;
  }

  h1,
  h2,
  h3 {
    font-family: var(--aw-font-heading);
    font-weight: 600;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  body {
    font-feature-settings:
      'liga' 1,
      'kern' 1;
    -webkit-font-smoothing: antialiased;
  }
</style>
