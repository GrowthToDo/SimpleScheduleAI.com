---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { Widget } from '~/types';

type Props = Widget;

const { id, isDark = false, classes = {}, bg = await Astro.slots.render('bg') } = Astro.props;

const rows = [
  { attr: 'Who builds the schedule', soft: 'You do, in the tool', serv: 'We do, and a human checks it' },
  { attr: 'Where the rules live', soft: 'You configure and maintain them', serv: 'We map them to your unit, once' },
  {
    attr: 'When someone calls out',
    soft: 'You work the phone tree',
    serv: 'You get the top 3 candidates, with reasons',
  },
  {
    attr: 'How fairness is tracked',
    soft: 'By hand, in spreadsheets',
    serv: 'Automatically: weekends, holidays, overtime',
  },
  { attr: 'What you do each week', soft: 'Build it, check it, chase it', serv: 'Review it, then approve' },
];

const cols = 'md:grid-cols-[minmax(0,0.85fr)_minmax(0,1fr)_minmax(0,1fr)]';
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl ${classes?.container ?? ''}`} bg={bg}>
  <div class="max-w-2xl" data-reveal>
    <p class="mb-3 text-xs font-medium uppercase tracking-[0.18em] text-primary">Software vs service</p>
    <h2 class="font-heading text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">
      Most tools hand you the <span class="text-primary">work</span>.
    </h2>
    <p class="mt-4 text-lg leading-relaxed text-muted">
      Scheduling software gives you a blank grid and rules to enforce yourself. We deliver the finished schedule.
    </p>
  </div>

  <div class="mt-10 md:mt-14" data-reveal>
    <!-- Column headers (desktop) -->
    <div class={`hidden md:grid ${cols} gap-x-8 pb-3`}>
      <div></div>
      <div class="text-xs font-semibold uppercase tracking-[0.14em] text-muted">Scheduling software</div>
      <div class="text-xs font-semibold uppercase tracking-[0.14em] text-primary">SimpleScheduleAI</div>
    </div>

    {
      rows.map((row) => (
        <div class={`grid grid-cols-1 ${cols} gap-x-8 gap-y-1 border-t border-ink/10 py-5`}>
          <div class="font-semibold text-default">{row.attr}</div>
          <div class="text-default/70">
            <span class="mr-1 text-xs uppercase tracking-wider text-muted md:hidden">Software:</span>
            {row.soft}
          </div>
          <div class="text-default">
            <span class="mr-1 text-xs uppercase tracking-wider text-primary md:hidden">SimpleScheduleAI:</span>
            {row.serv}
          </div>
        </div>
      ))
    }
  </div>
</WidgetWrapper>
