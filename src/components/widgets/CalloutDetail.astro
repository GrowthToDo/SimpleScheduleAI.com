---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import ShowcaseCalloutCoverage from './ShowcaseCalloutCoverage.svelte';
import type { Widget } from '~/types';

type Props = Widget;

const { id, isDark = false, classes = {}, bg = await Astro.slots.render('bg') } = Astro.props;

const title = 'Call-outs become a workflow, not a fire drill';
const subtitle =
  "A nurse cancels at 9 PM. You're off the clock. The system logs the callout, finds charge-qualified replacements, flags overtime risks, and has a name ready for your approval before your shift starts.";

const details = [
  'Eligible staff are checked first: skills, role, charge',
  'Your escalation order ranks candidates: float staff first, then voluntary overtime, then fill any remaining gaps if needed',
  'Every change lands in the Exceptions and Decisions Log for later review',
];

const logExample = {
  title: 'Exceptions Log Entry Example',
  event: '9PM CALL-OUT (MS UNIT) - Emma C.',
  eligibility: '2 CHARGE-QUALIFIED',
  escalation: 'STEP 1 (FLOAT POOL)',
  decision: 'CAROL A. ASSIGNED (FLOAT POOL)',
  reason: 'PROTECT CHARGE MIX ON NEXT SHIFT',
  note: 'Defendable in a huddle, ready for staffing committee.',
};
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-7xl ${classes?.container ?? ''}`} bg={bg}>
  <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
    <!-- Left: text + bullets + log box -->
    <div data-reveal>
      <Headline
        title={title}
        subtitle={subtitle}
        classes={{ title: 'text-3xl sm:text-4xl text-left', subtitle: 'text-lg text-left' }}
      />

      <ul class="mt-8 space-y-4">
        {
          details.map((detail) => (
            <li class="flex items-start gap-3">
              <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[#8FB3A3]" />
              <span class="text-default/80">{detail}</span>
            </li>
          ))
        }
      </ul>

      <div class="mt-10 rounded-xl bg-[#2A3138] p-6 font-mono text-sm text-[#F2F5F5]">
        <p class="font-bold">{logExample.title}</p>
        <div class="mt-4 space-y-2">
          <p><span class="text-[#8FB3A3]">EVENT:</span> {logExample.event}</p>
          <p><span class="text-[#8FB3A3]">ELIGIBILITY CHECK:</span> {logExample.eligibility}</p>
          <p><span class="text-[#8FB3A3]">ESCALATION:</span> {logExample.escalation}</p>
          <p><span class="text-[#8FB3A3]">DECISION:</span> {logExample.decision}</p>
          <p><span class="text-[#8FB3A3]">REASON:</span> {logExample.reason}</p>
        </div>
        <p class="mt-4 text-xs italic text-[#F2F5F5]/60">{logExample.note}</p>
      </div>
    </div>

    <!-- Right: animated callout coverage widget -->
    <div data-reveal>
      <ShowcaseCalloutCoverage client:visible />
    </div>
  </div>
</WidgetWrapper>
