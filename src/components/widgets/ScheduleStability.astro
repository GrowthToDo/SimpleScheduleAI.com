---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { Widget } from '~/types';

type Props = Widget;

const { id, isDark = true, classes = {}, bg = await Astro.slots.render('bg') } = Astro.props;

const title = 'The schedule arrives built and checked. You approve.';
const subtitle = "We don't just fill slots. We manage the integrity of the unit.";

const metrics = [
  {
    title: 'On Time, Every Time',
    description: 'Schedule posted by Thursday 3pm, before the weekend team needs to know.',
  },
  {
    title: 'Zero Coverage Gaps',
    description: 'Gaps caught before staff see the board, not after.',
  },
  {
    title: 'Call-Outs Handled',
    description: 'Replacements surface automatically. Call-outs stop coming to your phone.',
  },
  {
    title: 'OT Flagged Early',
    description: 'Overtime risk surfaced before it hits payroll.',
  },
  {
    title: 'Audit-Ready',
    description: 'Staffing committee packet ready in one click, always current.',
  },
];
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-7xl ${classes?.container ?? ''}`} bg={bg}>
  <Fragment slot="bg">
    <div class="absolute inset-0 bg-dark">
      <div
        class="absolute inset-0"
        style="background: radial-gradient(ellipse 70% 60% at 20% 0%, rgb(123 175 155 / 0.10), transparent 70%);"
      >
      </div>
    </div>
  </Fragment>

  <div class="grid gap-5 lg:grid-cols-12 lg:items-end mb-14" data-reveal>
    <div class="lg:col-span-7">
      <h2 class="font-semibold leading-tight tracking-tight font-heading text-3xl sm:text-4xl text-left text-ivory">
        {title}
      </h2>
    </div>
    <div class="lg:col-span-5">
      <p class="text-lg leading-relaxed text-ivory/60 lg:pb-1">{subtitle}</p>
    </div>
  </div>

  <div class="grid gap-8 sm:grid-cols-2 md:grid-cols-5" data-reveal-group>
    {
      metrics.map((metric) => (
        <div class="border-t border-ivory/15 pt-5">
          <h3 class="text-lg font-bold text-ivory">{metric.title}</h3>
          <p class="mt-2 text-sm text-ivory/60">{metric.description}</p>
        </div>
      ))
    }
  </div>
</WidgetWrapper>
