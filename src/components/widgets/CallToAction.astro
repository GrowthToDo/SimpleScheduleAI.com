---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { CallToAction, Widget } from '~/types';
import Headline from '~/components/ui/Headline.astro';
import Button from '~/components/ui/Button.astro';

interface Props extends Widget {
  title?: string;
  subtitle?: string;
  tagline?: string;
  callToAction?: CallToAction;
  actions?: string | CallToAction[];
}

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  content = await Astro.slots.render('content'),
  actions = await Astro.slots.render('actions'),

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <div class="max-w-3xl mx-auto text-center rounded-2xl bg-[#1A2332] text-[#FAF7F2] px-6 py-12 md:px-12 md:py-14">
    <Headline
      title={title}
      subtitle={subtitle}
      tagline={tagline}
      classes={{
        container: 'mb-0 md:mb-0',
        title: 'text-3xl md:text-4xl font-semibold tracking-tight mb-4 font-heading text-[#FAF7F2]',
        subtitle: 'text-xl text-[#FAF7F2]/70',
        tagline: 'text-xs font-medium uppercase tracking-[0.18em] text-[#7BAF9B] mb-3',
      }}
    />
    {content && <Fragment set:html={content} />}
    {
      actions && (
        <div class="max-w-xs sm:max-w-xl m-auto flex flex-nowrap flex-col sm:flex-row sm:justify-center gap-4 mt-8">
          {Array.isArray(actions) ? (
            actions.map((action) => (
              <div class="flex w-full sm:w-auto">
                <Button
                  {...(action || {})}
                  class={`w-full sm:mb-0 ${action.variant !== 'primary' ? 'text-[#FAF7F2] border-[#FAF7F2]/30 hover:bg-[#FAF7F2]/10 hover:border-[#FAF7F2]/60' : ''}`}
                />
              </div>
            ))
          ) : (
            <Fragment set:html={actions} />
          )}
        </div>
      )
    }
  </div>
</WidgetWrapper>
