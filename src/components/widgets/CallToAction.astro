---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { CallToAction, Widget } from '~/types';
import Headline from '~/components/ui/Headline.astro';
import Button from '~/components/ui/Button.astro';

interface Props extends Widget {
  title?: string;
  subtitle?: string;
  tagline?: string;
  content?: string;
  callToAction?: CallToAction;
  actions?: string | CallToAction[];
}

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  content = await Astro.slots.render('content'),
  actions = await Astro.slots.render('actions'),

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <div
    class="relative overflow-hidden max-w-3xl mx-auto text-center rounded-2xl bg-[#2A3138] text-[#F2F5F5] px-6 py-12 md:px-12 md:py-14 shadow-[0_14px_40px_-28px_rgb(42_49_56/0.4)]"
    data-reveal
  >
    <Headline
      title={title}
      subtitle={subtitle}
      tagline={tagline}
      classes={{
        container: 'mb-0 md:mb-0 relative',
        title: 'text-3xl md:text-4xl font-semibold tracking-tight mb-4 font-heading text-[#F2F5F5]',
        subtitle: 'text-xl text-[#F2F5F5]/70',
        tagline: 'text-xs font-medium uppercase tracking-[0.18em] text-[#8FB3A3] mb-3',
      }}
    />
    {
      content && (
        <div class="relative">
          <Fragment set:html={content} />
        </div>
      )
    }
    {
      actions && (
        <div class="relative max-w-xs sm:max-w-xl m-auto flex flex-nowrap flex-col sm:flex-row sm:justify-center gap-4 mt-8">
          {Array.isArray(actions) ? (
            actions.map((action) => (
              <div class="flex w-full sm:w-auto">
                <Button
                  {...(action || {})}
                  class={`w-full sm:mb-0 ${
                    action.variant !== 'primary'
                      ? 'text-[#F2F5F5] border-[#F2F5F5]/30 hover:bg-[#F2F5F5]/10 hover:border-[#F2F5F5]/60'
                      : 'bg-[#8FB3A3] border-[#8FB3A3] text-[#212930] hover:bg-[#A9C8BA] hover:border-[#A9C8BA] hover:text-[#212930]'
                  }`}
                />
              </div>
            ))
          ) : (
            <Fragment set:html={actions} />
          )}
        </div>
      )
    }
  </div>
</WidgetWrapper>
