---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import ROICalculatorWidget from './ROICalculatorWidget.svelte';
import type { Widget } from '~/types';

interface Props extends Widget {}

const { id, isDark = false, classes = {}, bg = await Astro.slots.render('bg') } = Astro.props;

const title = 'See what these costs add up to at your hospital';
const subtitle =
  'Nurse managers tell us the schedule, callouts and swaps take 8 to 12 hours of their week. Overtime, agency and turnover add up fast. Move the sliders to see your numbers.';
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-5xl ${classes?.container ?? ''}`} bg={bg}>
  <div class="text-center mb-12">
    <p class="mb-4 text-xs font-semibold uppercase tracking-widest text-primary">Scheduling Cost Calculator</p>
    <Headline title={title} subtitle={subtitle} classes={{ title: 'text-3xl sm:text-4xl', subtitle: 'text-lg' }} />
  </div>

  <ROICalculatorWidget client:load />
</WidgetWrapper>
