---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import EditorialHeader from '~/components/ui/EditorialHeader.astro';
import type { Widget } from '~/types';

type Props = Widget;

const { id, isDark = false, classes = {}, bg = await Astro.slots.render('bg') } = Astro.props;

const title = 'A scheduling cadence that fits a CAH';

const steps = [
  {
    number: '01',
    title: 'Lock the rules once',
    description:
      'Minimum coverage, charge requirements, and skill mix expectations. We hardcode your weekend/holiday rotations and overtime boundaries into our workflow.',
  },
  {
    number: '02',
    title: 'Weekly inputs (10 to 15 min)',
    description:
      'Send us PTO, known constraints, or ED spikes. We take the "messy" data and process it into a clean, logical draft.',
  },
  {
    number: '03',
    title: 'Your draft posts ready',
    description:
      'The validation pass runs and the post-ready draft lands in your inbox. You approve before it posts. No back-and-forth on the core schedule.',
  },
];
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-7xl ${classes?.container ?? ''}`} bg={bg}>
  <EditorialHeader number="04" tagline="How a week runs" title={title} />

  <div class="mx-auto max-w-4xl space-y-10" data-reveal-group>
    {
      steps.map((step, index) => (
        <div class={`flex items-start gap-8 ${index < steps.length - 1 ? 'border-b border-hairline pb-10' : ''}`}>
          <span class="shrink-0 font-heading text-5xl sm:text-6xl leading-none text-primary/30 select-none w-20">
            {step.number}
          </span>
          <div class="flex-1">
            <h3 class="text-xl font-semibold">{step.title}</h3>
            <p class="mt-3 text-muted">{step.description}</p>
          </div>
        </div>
      ))
    }
  </div>
</WidgetWrapper>
