---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import { Icon } from 'astro-icon/components';
import ShowcaseShiftStatus from './ShowcaseShiftStatus.svelte';
import type { Widget } from '~/types';

type Props = Widget;

const { id, isDark = true, classes = {}, bg = await Astro.slots.render('bg') } = Astro.props;

const title = 'Every schedule is compliant before it posts.';
const subtitle =
  '13 rules protect safe staffing on every schedule. 8 more track fairness for your team. All checked automatically. Nothing slips through.';
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-7xl ${classes?.container ?? ''}`} bg={bg}>
  <Fragment slot="bg">
    <div class="absolute inset-0 bg-dark">
      <div
        class="absolute inset-0"
        style="background: radial-gradient(ellipse 70% 60% at 80% 100%, rgb(123 175 155 / 0.10), transparent 70%);"
      >
      </div>
    </div>
  </Fragment>

  <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
    <!-- Left: existing text content -->
    <div class="text-left" data-reveal>
      <p class="mb-4 text-xs font-medium uppercase tracking-[0.18em] text-[#7BAF9B]">What we check every cycle</p>
      <div class="mb-2 text-8xl font-semibold font-heading text-[#7BAF9B] sm:text-9xl leading-none" data-countup="21">
        21
      </div>
      <p class="text-sm font-medium text-[#FAF7F2]/60 mb-4">rules checked on every schedule</p>
      <Headline
        title={title}
        subtitle={subtitle}
        classes={{
          container: 'text-left md:mx-0',
          title: 'text-3xl sm:text-4xl text-[#FAF7F2]',
          subtitle: 'text-lg text-[#FAF7F2]/60',
        }}
      />
      <a
        href="/how-it-works"
        class="mt-8 inline-flex items-center gap-2 text-[#7BAF9B] font-medium hover:text-[#FAF7F2] transition-colors duration-200"
      >
        See every rule we check
        <Icon name="tabler:arrow-right" class="w-4 h-4" />
      </a>
    </div>

    <!-- Right: animated shift status widget. pb reserves space for the mobile
         popup (absolute, below the last cell) so it cannot bleed into the next section. -->
    <div class="relative pb-20 lg:pb-0" data-reveal>
      <ShowcaseShiftStatus client:visible />
    </div>
  </div>
</WidgetWrapper>
