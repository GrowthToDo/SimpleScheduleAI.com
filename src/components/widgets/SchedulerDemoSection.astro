---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import SchedulerDemo from './SchedulerDemo.svelte';
import type { Widget } from '~/types';

type Props = Widget & {
  title?: string;
  subtitle?: string;
  tagline?: string;
  ctaText?: string;
  ctaHref?: string;
};

const {
  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
  title = 'From blank grid to full schedule in seconds.',
  subtitle = 'The engine checks 13 safety rules and 8 fairness rules as it fills every slot, then ranks callout replacements the same way. Automatically.',
  tagline = 'AI Scheduling Engine',
  ctaText = 'Get your first schedule',
  ctaHref = '/contact',
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-7xl pt-2 md:pt-4 ${classes?.container ?? ''}`} bg={bg}>
  <div data-reveal>
    <Headline title={title} subtitle={subtitle} tagline={tagline} />
  </div>
  <div class="mt-2 flex justify-center" data-reveal>
    <div class="w-full max-w-[920px] overflow-x-auto overscroll-x-contain" style="contain: layout;">
      <div class="min-w-[460px] sm:min-w-0 min-h-[640px] sm:min-h-[660px]">
        <SchedulerDemo client:visible />
      </div>
    </div>
  </div>
  {
    ctaText && ctaHref && (
      <div class="mt-10 flex justify-center" data-reveal>
        <a
          href={ctaHref}
          class="inline-flex items-center gap-2 rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-secondary"
        >
          {ctaText}
        </a>
      </div>
    )
  }
</WidgetWrapper>
