---
// Full-bleed calm nurse-station photograph behind the hero, washed with an
// ivory gradient so the ink-navy headline stays dominant. Counter and warm
// lamp emerge toward the bottom of the hero.
---

<div class="absolute inset-0 overflow-hidden" aria-hidden="true">
  <img
    src="/images/hero/nurse-station-2000.webp"
    srcset="/images/hero/nurse-station-1100.webp 1100w, /images/hero/nurse-station-2000.webp 2000w"
    sizes="100vw"
    alt=""
    class="absolute inset-0 h-full w-full object-cover object-[center_60%]"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <div
    class="absolute inset-0"
    style="background: linear-gradient(to bottom, rgb(250 247 242 / 0.97) 0%, rgb(250 247 242 / 0.9) 40%, rgb(250 247 242 / 0.66) 64%, rgb(250 247 242 / 0.22) 88%, rgb(250 247 242 / 0.08) 100%);"
  >
  </div>
  <div
    class="absolute inset-x-0 bottom-0 h-40"
    style="background: linear-gradient(to top, rgb(250 247 242 / 1) 0%, rgb(250 247 242 / 0.75) 35%, rgb(250 247 242 / 0) 100%);"
  >
  </div>
</div>
