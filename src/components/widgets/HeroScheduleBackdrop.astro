---
// Decorative hero backdrop: a faded but literal weekly schedule that fills
// itself on an infinite loop. Pure CSS, no hydration, aria-hidden.
// Desktop only; static under prefers-reduced-motion.
const rows = [
  { day: 'Mon', date: 'Jun 2', dayShift: ['Maria G.', 'Emily D.'], nightShift: ['James W.', 'Sarah C.'] },
  { day: 'Tue', date: 'Jun 3', dayShift: ['James W.', 'Michael B.'], nightShift: ['Maria G.', 'Jessica R.'] },
  { day: 'Wed', date: 'Jun 4', dayShift: ['Maria G.', 'Sarah C.'], nightShift: ['James W.', 'Emily D.'] },
  { day: 'Thu', date: 'Jun 5', dayShift: ['James W.', 'Jessica R.'], nightShift: ['Michael B.', 'Sarah C.'] },
  { day: 'Fri', date: 'Jun 6', dayShift: ['Maria G.', 'Michael B.'], nightShift: ['James W.', 'Jessica R.'] },
  { day: 'Sat', date: 'Jun 7', dayShift: ['James W.', 'Emily D.'], nightShift: ['Maria G.', 'Sarah C.'] },
  { day: 'Sun', date: 'Jun 8', dayShift: ['Maria G.', 'Jessica R.'], nightShift: ['James W.', 'Michael B.'] },
];
---

<div class="hero-backdrop" aria-hidden="true">
  <div class="hb-grid">
    <div class="hb-head">
      <span class="hb-h-day"></span>
      <span class="hb-h">Day Shift · 07:00–19:00</span>
      <span class="hb-h">Night Shift · 19:00–07:00</span>
    </div>
    {
      rows.map((row, r) => (
        <div class="hb-row">
          <span class="hb-day">
            {row.day}
            <em>{row.date}</em>
          </span>
          <div class="hb-cell">
            {row.dayShift.map((n, i) => (
              <span class="hb-chip hb-fill" style={`--d:${r * 0.85 + i * 0.4}s`}>
                {n}
              </span>
            ))}
            <span class="hb-ok hb-fill" style={`--d:${r * 0.85 + 1}s`}>
              ✓
            </span>
          </div>
          <div class="hb-cell">
            {row.nightShift.map((n, i) => (
              <span class="hb-chip hb-green hb-fill" style={`--d:${r * 0.85 + 0.2 + i * 0.4}s`}>
                {n}
              </span>
            ))}
            <span class="hb-ok hb-fill" style={`--d:${r * 0.85 + 1.2}s`}>
              ✓
            </span>
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .hero-backdrop {
    position: absolute;
    inset: 0;
    overflow: hidden;
    display: none;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(ellipse 80% 72% at 50% 38%, rgb(0 0 0 / 1), transparent 82%);
    mask-image: radial-gradient(ellipse 80% 72% at 50% 38%, rgb(0 0 0 / 1), transparent 82%);
  }
  @media (min-width: 768px) {
    .hero-backdrop {
      display: block;
    }
  }
  .hb-grid {
    position: absolute;
    left: 50%;
    top: 47%;
    width: min(880px, 80vw);
    transform: translate(-50%, -50%);
    opacity: 0.32;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hb-grid {
      animation: hb-pan 70s linear infinite alternate;
    }
  }
  @keyframes hb-pan {
    from {
      transform: translate(-51.5%, -51%);
    }
    to {
      transform: translate(-48.5%, -49%);
    }
  }
  .hb-head,
  .hb-row {
    display: grid;
    grid-template-columns: 72px 1fr 1fr;
    gap: 12px;
    align-items: center;
  }
  .hb-head {
    padding-bottom: 8px;
    border-bottom: 2px solid rgb(26 35 50 / 0.18);
  }
  .hb-h {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(26 35 50 / 0.55);
    padding-left: 12px;
  }
  .hb-row {
    padding: 9px 0;
    border-bottom: 1px solid rgb(26 35 50 / 0.12);
  }
  .hb-day {
    font-size: 12px;
    font-weight: 700;
    color: rgb(26 35 50 / 0.6);
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }
  .hb-day em {
    font-style: normal;
    font-weight: 400;
    font-size: 9px;
    color: rgb(26 35 50 / 0.4);
  }
  .hb-cell {
    display: flex;
    gap: 6px;
    align-items: center;
    border-left: 1px solid rgb(26 35 50 / 0.1);
    padding-left: 12px;
  }
  .hb-chip {
    font-size: 10px;
    font-weight: 600;
    color: rgb(26 35 50 / 0.6);
    background: rgb(26 35 50 / 0.07);
    border-radius: 6px;
    padding: 2px 8px;
    white-space: nowrap;
  }
  .hb-green {
    color: rgb(45 90 74 / 0.75);
    background: rgb(45 90 74 / 0.12);
  }
  .hb-ok {
    font-size: 10px;
    font-weight: 800;
    color: rgb(45 90 74 / 0.65);
    margin-left: 2px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hb-fill {
      opacity: 0;
      transform: scale(0.92);
      animation: hb-pop 13s cubic-bezier(0.22, 1, 0.36, 1) infinite;
      animation-delay: var(--d, 0s);
    }
  }
  @keyframes hb-pop {
    0% {
      opacity: 0;
      transform: scale(0.92);
    }
    4% {
      opacity: 1;
      transform: scale(1);
    }
    80% {
      opacity: 1;
    }
    90%,
    100% {
      opacity: 0;
      transform: scale(0.92);
    }
  }
</style>
