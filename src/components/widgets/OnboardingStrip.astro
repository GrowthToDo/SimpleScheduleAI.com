---
/**
 * OnboardingStrip — the "getting started" chapter of the landing narrative.
 * Numbered-circle timeline (same pattern as the How It Works Steps section)
 * with a Day 1 -> Day 14 visual. Canonical service claims: first schedule in
 * under two weeks; rules configured before the first cycle; no IT involvement.
 */
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { Widget } from '~/types';

type Props = Widget;

const { id, isDark = false, classes = {}, bg = await Astro.slots.render('bg') } = Astro.props;

const steps = [
  {
    title: 'Send the Excel you already keep',
    description: 'Your staff list and shift structure, as they are. No cleanup project.',
  },
  {
    title: 'We configure your rules',
    description: 'Charge coverage, skill mix, on-call limits: mapped to your unit before your first cycle.',
  },
  {
    title: 'You check a test cycle',
    description: 'A draft schedule against your real roster. You tell us what a spreadsheet cannot know.',
  },
  {
    title: 'Your first live schedule posts',
    description: 'From then on it arrives every week, checked and post-ready.',
  },
];
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-7xl ${classes?.container ?? ''}`} bg={bg}>
  <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
    <div data-reveal>
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-primary">Getting started</p>
      <h2 class="font-heading text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">
        First schedule in under two weeks
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-muted">No IT involvement at any step.</p>

      <ol class="mt-8">
        {
          steps.map((s, i) => (
            <li class="relative flex items-start gap-5 pb-8 last:pb-0">
              {i < steps.length - 1 && (
                <span class="absolute left-[19px] top-10 h-[calc(100%-2.5rem)] w-px bg-hairline" aria-hidden="true" />
              )}
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border-2 border-primary font-heading text-base font-semibold text-primary">
                {i + 1}
              </span>
              <div class="pt-1">
                <h3 class="text-lg font-bold">{s.title}</h3>
                <p class="mt-1 leading-relaxed text-muted">{s.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div data-reveal>
      <div class="rounded-2xl border border-hairline bg-white p-6 shadow-[0_14px_40px_-28px_rgb(26_35_50/0.35)]">
        <div class="flex items-center justify-between">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted">Day 1</p>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">Day 14</p>
        </div>
        <div class="relative mt-3 h-1.5 rounded-full bg-hairline">
          <div class="absolute inset-y-0 left-0 w-full rounded-full bg-gradient-to-r from-primary/30 to-primary"></div>
        </div>

        <div class="mt-6 grid items-stretch gap-3 sm:grid-cols-[1fr_auto_1fr]">
          <div class="rounded-xl border border-hairline p-4">
            <p class="font-mono text-xs font-semibold text-muted">YourRoster.xlsx</p>
            <p class="mt-1 text-sm text-muted">The staff Excel you already keep, uploaded as it is.</p>
          </div>
          <div class="flex items-center justify-center text-muted" aria-hidden="true">
            <span class="hidden sm:block">&rarr;</span>
            <span class="sm:hidden">&darr;</span>
          </div>
          <div class="rounded-xl border-2 border-primary bg-primary/5 p-4">
            <p class="font-mono text-xs font-semibold text-primary">Unit_Schedule_Cycle-1.pdf</p>
            <p class="mt-1 text-sm">Checked against your rules, post-ready for the unit board.</p>
          </div>
        </div>
        <p class="mt-4 text-xs text-muted">Rules mapped once in between. Nothing installed, no IT ticket opened.</p>
      </div>
    </div>
  </div>
</WidgetWrapper>
