---
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';

import type { Hero as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  announcement,

  content = await Astro.slots.render('content'),
  actions = await Astro.slots.render('actions'),
  image = await Astro.slots.render('image'),

  id,
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<section class="relative md:-mt-[76px] not-prose" {...id ? { id } : {}}>
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <slot name="bg">
      {
        bg ? (
          <Fragment set:html={bg} />
        ) : (
          <div
            class="absolute inset-0"
            style="background: radial-gradient(ellipse 80% 55% at 50% -10%, rgb(45 90 74 / 0.07), transparent 70%);"
          />
        )
      }
    </slot>
  </div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="pt-0 md:pt-[76px] pointer-events-none"></div>
    <div class="pt-12 md:pt-16 pb-4 md:pb-6">
      <div class="text-center pb-4 md:pb-6 max-w-5xl mx-auto">
        {
          announcement && (
            <div class="mb-4" data-reveal>
              <span class="inline-flex items-center rounded-full bg-primary px-4 py-1.5 text-sm font-medium text-white">
                {announcement}
              </span>
            </div>
          )
        }
        {
          tagline && (
            <p
              class="text-base text-secondary dark:text-[#FAF7F2]/70 font-bold tracking-wide uppercase"
              data-reveal
              set:html={tagline}
            />
          )
        }
        {
          title && (
            <h1
              class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-semibold leading-[1.05] tracking-tight mb-6 font-heading reveal-delay-1"
              data-reveal
              set:html={title}
            />
          )
        }
        <div class="max-w-3xl mx-auto">
          {
            subtitle && (
              <p
                class="text-lg md:text-xl leading-relaxed text-muted mb-8 reveal-delay-2"
                data-reveal
                set:html={subtitle}
              />
            )
          }
          {
            actions && (
              <div
                class="max-w-xs sm:max-w-xl m-auto flex flex-nowrap flex-col sm:flex-row sm:justify-center gap-4 reveal-delay-3"
                data-reveal
              >
                {Array.isArray(actions) ? (
                  actions.map((action) => (
                    <div class="flex w-full sm:w-auto">
                      <Button {...(action || {})} class="w-full sm:mb-0" />
                    </div>
                  ))
                ) : (
                  <Fragment set:html={actions} />
                )}
              </div>
            )
          }
        </div>
        {content && <Fragment set:html={content} />}
      </div>
      <div
        class="intersect-once intersect-no-queue intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
      >
        {
          image && (
            <div class="relative m-auto max-w-5xl">
              {typeof image === 'string' ? (
                <Fragment set:html={image} />
              ) : (
                <Image
                  class="mx-auto rounded-md w-full"
                  widths={[400, 768, 1024, 2040]}
                  sizes="(max-width: 767px) 400px, (max-width: 1023px) 768px, (max-width: 2039px) 1024px, 2040px"
                  loading="eager"
                  fetchpriority="high"
                  width={1024}
                  height={576}
                  {...image}
                />
              )}
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
