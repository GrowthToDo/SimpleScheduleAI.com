---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import EditorialHeader from '~/components/ui/EditorialHeader.astro';
import type { Widget } from '~/types';

type Props = Widget;

const { id, isDark = false, classes = {}, bg = await Astro.slots.render('bg') } = Astro.props;

const title = 'We talked to nurse managers before writing code';
const subtitle =
  'Not surveys. Real conversations about real scheduling problems, and a schedule model built from what they told us.';

const founders = [
  {
    name: 'Pradeep Pandey',
    title: 'Co-founder',
    bio: 'Deputy General Manager of Operations, Apollo Hospitals. 7 years inside hospital ops managing 2,000+ beds across 19 hospitals. Building the scheduling fix he watched them need every week.',
    imageAlt: 'Pradeep Pandey, Co-founder of SimpleScheduleAI',
    imageSrc: '/founders/pradeep.webp',
    profileUrl: '/about/pradeep-pandey',
  },
  {
    name: 'Gautham',
    title: 'Co-founder',
    bio: '3x founder, 15 years in tech. Built a system your nurses never have to log into. You upload, the schedule comes back ready.',
    imageAlt: 'Gautham, Co-founder of SimpleScheduleAI',
    imageSrc: '/founders/gautham.png',
    profileUrl: undefined,
  },
];
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-7xl ${classes?.container ?? ''}`} bg={bg}>
  <EditorialHeader tagline="The team" title={title} subtitle={subtitle} />

  <div class="grid gap-12 lg:grid-cols-12 lg:items-start">
    <div class="lg:col-span-7 space-y-10" data-reveal-group>
      {
        founders.map((founder) => (
          <div class="flex items-start gap-6 border-t border-hairline pt-8">
            <img
              src={founder.imageSrc}
              alt={founder.imageAlt}
              class="h-20 w-20 sm:h-24 sm:w-24 shrink-0 rounded-full object-cover ring-2 ring-primary/20"
              loading="lazy"
              decoding="async"
            />
            <div>
              <h3 class="text-lg font-bold">
                {founder.profileUrl ? (
                  <a href={founder.profileUrl} class="hover:text-primary transition-colors">
                    {founder.name}
                  </a>
                ) : (
                  founder.name
                )}
              </h3>
              <p class="text-sm font-semibold text-primary">{founder.title}</p>
              <p class="mt-3 text-sm leading-relaxed text-muted">{founder.bio}</p>
            </div>
          </div>
        ))
      }
    </div>

    <blockquote class="lg:col-span-5 border-l-4 border-primary pl-6 py-2 lg:mt-8" data-reveal>
      <p class="font-heading text-xl sm:text-2xl italic leading-snug text-default/85">
        "I spend my Sunday evenings rebuilding the schedule because someone called out on Friday. Every week. I just
        want to hand it off and know it is right."
      </p>
      <footer class="mt-4 text-sm font-semibold text-primary">
        CNO, Critical Access Hospital, Texas (from our pre-build research interviews)
      </footer>
    </blockquote>
  </div>
</WidgetWrapper>
