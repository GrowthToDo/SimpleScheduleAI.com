---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import type { Widget } from '~/types';

type Props = Widget;

const { id, isDark = false, classes = {}, bg = await Astro.slots.render('bg') } = Astro.props;

const title = 'Built by listening to people in the room';
const subtitle =
  'We interviewed 30+ nurse managers before writing a single line of code. Not surveys. Real conversations about real scheduling problems.';

const founders = [
  {
    name: 'Pradeep Pandey',
    title: 'Co-founder',
    bio: 'Deputy General Manager of Operations, Apollo Hospitals. 7 years inside hospital ops managing 2,000+ beds across 19 hospitals. Building the scheduling fix he watched them need every week.',
    imageAlt: 'Pradeep Pandey, Co-founder of SimpleScheduleAI',
    imageSrc: '/founders/pradeep.webp',
    profileUrl: '/about/pradeep-pandey',
  },
  {
    name: 'Gautham',
    title: 'Co-founder',
    bio: '3x founder, 15 years in tech. Built a system your nurses never have to log into. You upload, the schedule comes back ready.',
    imageAlt: 'Gautham, Co-founder of SimpleScheduleAI',
    imageSrc: '/founders/gautham.png',
    profileUrl: undefined,
  },
];
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-7xl ${classes?.container ?? ''}`} bg={bg}>
  <div class="mx-auto max-w-3xl text-center mb-14">
    <p class="mb-4 text-xs font-medium uppercase tracking-[0.18em] text-primary">The team</p>
    <Headline title={title} subtitle={subtitle} classes={{ title: 'text-3xl sm:text-4xl', subtitle: 'text-lg' }} />
  </div>

  <div class="flex flex-col items-center justify-center gap-12 sm:flex-row sm:items-start sm:gap-20">
    {
      founders.map((founder) => (
        <div class="flex max-w-xs flex-col items-center text-center">
          <img
            src={founder.imageSrc}
            alt={founder.imageAlt}
            class="h-24 w-24 rounded-full object-cover ring-2 ring-primary/20"
            loading="lazy"
            decoding="async"
          />
          <h3 class="mt-5 text-lg font-bold">
            {founder.profileUrl ? (
              <a href={founder.profileUrl} class="hover:text-primary transition-colors">
                {founder.name}
              </a>
            ) : (
              founder.name
            )}
          </h3>
          <p class="text-sm font-semibold text-primary">{founder.title}</p>
          <p class="mt-3 text-sm leading-relaxed text-muted">{founder.bio}</p>
        </div>
      ))
    }
  </div>

  <blockquote class="mx-auto mt-16 max-w-2xl rounded-xl border border-hairline bg-white px-8 py-6 text-center">
    <p class="text-base italic leading-relaxed text-default/80">
      "I spend my Sunday evenings rebuilding the schedule because someone called out on Friday. Every week. I just want
      to hand it off and know it is right."
    </p>
    <footer class="mt-3 text-sm font-semibold text-primary">
      CNO, Critical Access Hospital, Texas (from our pre-build research interviews)
    </footer>
  </blockquote>
</WidgetWrapper>
