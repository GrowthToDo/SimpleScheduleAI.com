---
import Layout from '~/layouts/PageLayout.astro';
import SchemaOrg from '~/components/common/SchemaOrg.astro';
import ContactForm from '~/components/ui/forms/ContactForm.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Contact',
  description:
    'Talk to a human. We respond within 24 hours. Tell us about your unit and we will reply with your onboarding plan and timeline.',
};

const contactPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact SimpleScheduleAI',
  description: 'Talk to a human. We respond within 24 hours.',
  url: 'https://simplescheduleai.com/contact',
  mainEntity: { '@id': 'https://simplescheduleai.com/#organization' },
};

const contactBreadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://simplescheduleai.com' },
    { '@type': 'ListItem', position: 2, name: 'Contact', item: 'https://simplescheduleai.com/contact' },
  ],
};

const contactDetails = {
  address: '440 N Barranca Ave #3696, Covina, CA 91723',
  phone: '+1 (415) 216-5224',
  email: 'support@simplescheduleai.com',
};

const ctaLink = 'https://cal.com/gautham-8bdvdx/30min';
---

<Layout metadata={metadata}>
  <SchemaOrg slot="head" schema={[contactPageSchema, contactBreadcrumbSchema]} />
  <!-- Form + details -->
  <section class="bg-page">
    <div class="mx-auto max-w-7xl px-4 pb-10 pt-14 sm:px-6 lg:px-8">
      <div class="mb-10">
        <p class="text-sm font-semibold uppercase tracking-widest text-primary mb-2">Talk to us</p>
        <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-3">Contact</h1>
        <p class="text-lg text-muted max-w-2xl">{metadata.description}</p>
      </div>
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-10">
        <div class="rounded-2xl border border-hairline bg-white p-6 dark:bg-slate-800 sm:p-8">
          <div class="mb-6">
            <h2 class="text-xl font-semibold">Get your first schedule</h2>
            <p class="mt-2 text-default">
              Tell us about your unit and we will reply within 24 hours with your onboarding plan and timeline. If you
              are not a fit, we will tell you quickly. Want a one-page overview to share internally? Just ask.
            </p>
          </div>

          <ContactForm />

          <p class="mt-4 text-sm text-muted">No spam. No software rollout. Excel is fine.</p>
        </div>

        <div class="lg:pl-6">
          <h2 class="text-xl font-semibold">Contact details</h2>
          <p class="mt-2 text-default">
            If you prefer, email us and include a sample schedule format or a description of your constraints.
          </p>

          <div class="mt-6 space-y-5">
            <div class="flex gap-x-4">
              <Icon name="tabler:map-pin" class="mt-0.5 w-6 h-6 shrink-0 text-primary" />
              <div class="grow">
                <p class="font-semibold">Address</p>
                <p class="text-sm text-default">{contactDetails.address}</p>
              </div>
            </div>

            <div class="flex gap-x-4">
              <Icon name="tabler:phone" class="mt-0.5 w-6 h-6 shrink-0 text-primary" />
              <div class="grow">
                <p class="font-semibold">Phone</p>
                <a
                  class="text-sm text-default underline decoration-gray-300 dark:decoration-gray-600 underline-offset-4 transition-colors hover:text-primary"
                  href="tel:+14152165224"
                >
                  {contactDetails.phone}
                </a>
              </div>
            </div>

            <div class="flex gap-x-4">
              <Icon name="tabler:calendar" class="mt-0.5 w-6 h-6 shrink-0 text-primary" />
              <div class="grow">
                <p class="font-semibold">Book a call with our team</p>
                <a
                  class="text-sm text-default underline decoration-gray-300 dark:decoration-gray-600 underline-offset-4 transition-colors hover:text-primary"
                  href={ctaLink}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Schedule a 30-minute call with our team
                </a>
              </div>
            </div>

            <div class="flex gap-x-4">
              <Icon name="tabler:mail" class="mt-0.5 w-6 h-6 shrink-0 text-primary" />
              <div class="grow">
                <p class="font-semibold">Email</p>
                <a
                  class="text-sm text-default underline decoration-gray-300 dark:decoration-gray-600 underline-offset-4 transition-colors hover:text-primary"
                  href={`mailto:${contactDetails.email}`}
                >
                  {contactDetails.email}
                </a>
              </div>
            </div>
          </div>

          <div class="mt-8 border-t border-hairline pt-6">
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-primary">
              What to include in your message
            </p>
            <ul class="mt-4 space-y-2">
              {
                [
                  'Unit size and shift pattern (12h, 8h, mixed)',
                  'How schedules are built today (Excel, paper, vendor tool)',
                  'Rules that cause the most pain (coverage, overtime, fairness, time off)',
                  'How often you publish schedules (weekly, biweekly, monthly)',
                ].map((item) => (
                  <li class="flex items-start gap-3">
                    <span class="mt-1.5 w-1.5 h-1.5 shrink-0 rounded-full bg-primary" />
                    <span class="text-sm text-default">{item}</span>
                  </li>
                ))
              }
            </ul>
            <p class="mt-4 text-sm text-muted">We will reply with a simple next step and a clear timeline.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    document.addEventListener('astro:page-load', () => {
      const textarea = document.querySelector('#input-message');
      if (!textarea) return;

      const resize = (offsetTop = 0) => {
        textarea.style.height = 'auto';
        textarea.style.height = `${textarea.scrollHeight + offsetTop}px`;
      };

      resize(3);
      textarea.addEventListener('input', () => resize(3));
    });
  </script>
</Layout>
