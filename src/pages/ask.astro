---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Make a Warm Intro | SimpleScheduleAI',
  description:
    'Know a nursing manager, hospital admin, or investor? Watch these two short videos and, if this resonates, I would love a warm introduction.',
  robots: { index: false, follow: false },
};

const calLink = 'https://cal.com/gautham-8bdvdx/30min';

// Placeholder YouTube video IDs - swap these when real videos are uploaded
const videoGenericIntro = 'E3EE-2lpBL0'; // Video 1: Generic Warm Intro
const videoProductDemo = 'AeqOsd2dFX8'; // Video 2: Detailed Product Demo
---

<Layout metadata={metadata}>
  <!-- Hero -->
  <section class="bg-page">
    <div class="mx-auto max-w-4xl px-4 pt-14 pb-10 sm:px-6 lg:px-8 text-center">
      <span
        class="inline-block mb-5 rounded-full border border-primary/25 bg-primary/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-primary"
      >
        Warm Intro Request
      </span>
      <h1 class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl">
        Can you make an introduction?
      </h1>
      <p class="mt-5 text-lg text-muted max-w-2xl mx-auto">
        We're building SimpleScheduleAI, AI-powered nurse scheduling for Critical Access Hospitals. If you know a
        nursing manager, hospital admin, or someone who might invest in this space, I'd love a warm intro.
      </p>
    </div>
  </section>

  <!-- Videos -->
  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-2">
        <!-- Video 1 -->
        <div
          class="rounded-3xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-800 overflow-hidden shadow-sm"
        >
          <div class="p-6 pb-4">
            <p class="text-xs font-semibold uppercase tracking-widest text-primary mb-1">Video 1 · 90 seconds</p>
            <h2 class="text-xl font-bold text-gray-900 dark:text-white">The Quick Overview</h2>
            <p class="mt-2 text-muted text-sm">
              What we're building, who it's for, and the three ways you can help, in 90 seconds.
            </p>
          </div>
          <div class="aspect-video w-full">
            <iframe
              class="w-full h-full"
              src={`https://www.youtube.com/embed/${videoGenericIntro}`}
              title="SimpleScheduleAI Quick Overview"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen></iframe>
          </div>
        </div>

        <!-- Video 2 -->
        <div
          class="rounded-3xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-800 overflow-hidden shadow-sm"
        >
          <div class="p-6 pb-4">
            <p class="text-xs font-semibold uppercase tracking-widest text-primary mb-1">Video 2 · 8 min</p>
            <h2 class="text-xl font-bold text-gray-900 dark:text-white">Product Walkthrough</h2>
            <p class="mt-2 text-muted text-sm">
              A walkthrough of the scheduling engine: callouts, shift swaps, audit trail, and the
              generate-in-under-a-minute experience.
            </p>
          </div>
          <div class="aspect-video w-full">
            <iframe
              class="w-full h-full"
              src={`https://www.youtube.com/embed/${videoProductDemo}`}
              title="SimpleScheduleAI Product Walkthrough"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Three ways to help -->
  <section class="bg-page">
    <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <p class="text-xs font-semibold uppercase tracking-widest text-primary mb-3">Three ways to help</p>
        <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">
          Anyone in these categories, we'd love to talk
        </h2>
      </div>

      <div class="grid gap-6 sm:grid-cols-3">
        <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-800 p-6 shadow-sm">
          <div class="mb-4 w-10 h-10 rounded-xl bg-primary/10 dark:bg-[#7BAF9B]/10 flex items-center justify-center">
            <Icon name="tabler:user-heart" class="w-5 h-5 text-primary" />
          </div>
          <h3 class="font-bold text-gray-900 dark:text-white">Nursing managers &amp; DONs</h3>
          <p class="mt-2 text-sm text-muted">
            Anyone close to the scheduling problem at a small rural hospital. We want to understand what's working, what
            isn't, and how we can make this better.
          </p>
        </div>

        <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-800 p-6 shadow-sm">
          <div class="mb-4 w-10 h-10 rounded-xl bg-primary/10 dark:bg-[#7BAF9B]/10 flex items-center justify-center">
            <Icon name="tabler:building-hospital" class="w-5 h-5 text-primary" />
          </div>
          <h3 class="font-bold text-gray-900 dark:text-white">Hospital administrators</h3>
          <p class="mt-2 text-sm text-muted">
            CAH CEOs and administrators interested in our AI-native scheduling service. We handle the scheduling, you
            keep full control.
          </p>
        </div>

        <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-800 p-6 shadow-sm">
          <div class="mb-4 w-10 h-10 rounded-xl bg-primary/10 dark:bg-[#7BAF9B]/10 flex items-center justify-center">
            <Icon name="tabler:trending-up" class="w-5 h-5 text-primary" />
          </div>
          <h3 class="font-bold text-gray-900 dark:text-white">Early investors</h3>
          <p class="mt-2 text-muted text-sm">
            We're early and raising. If you invest in healthcare operations or rural health infrastructure, we'd love a
            conversation.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Evidence page callout -->
  <section class="bg-white">
    <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
      <div
        class="rounded-3xl border border-primary/20 bg-primary/5 dark:bg-[#7BAF9B]/5 dark:border-[#7BAF9B]/20 p-8 sm:p-10"
      >
        <div class="flex flex-col sm:flex-row sm:items-center gap-6">
          <div
            class="w-12 h-12 shrink-0 rounded-xl bg-primary/10 dark:bg-[#7BAF9B]/10 flex items-center justify-center"
          >
            <Icon name="tabler:clipboard-check" class="w-6 h-6 text-primary" />
          </div>
          <div class="flex-1">
            <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
              Considering an intro to an investor? See the evidence first
            </h2>
            <p class="mt-2 text-muted text-sm sm:text-base">
              A page that lays out exactly what we've built and validated so far: the demand data that led us here,
              direct quotes from the nursing directors and hospitals we've talked to, what's shipped in the product, and
              our content and distribution numbers. Everything in one place, so you (and whoever you introduce us to)
              can see the real picture before a call.
            </p>
            <a
              href="/proof-of-work"
              class="mt-5 inline-flex items-center gap-1.5 rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-white hover:bg-primary/90 transition-colors"
            >
              See the full evidence page
              <Icon name="tabler:arrow-right" class="w-4 h-4" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact / CTA -->
  <section class="bg-[#1A2332] dark:bg-black">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8 text-center">
      <p class="text-xs font-semibold uppercase tracking-widest text-[#7BAF9B] mb-4">Get in touch</p>
      <h2 class="text-3xl font-bold tracking-tight text-white">If you know someone, I'd love to hear from you</h2>
      <p class="mt-4 text-gray-400 max-w-xl mx-auto">
        A quick email or a 15-minute call is all it takes. I'll take it from there.
      </p>

      <div class="mt-10 flex flex-col items-center gap-4">
        <div class="flex items-center gap-3 text-lg font-semibold text-white">
          <Icon name="tabler:user" class="w-5 h-5 text-[#7BAF9B] shrink-0" />
          <span>Gautham</span>
        </div>
        <a href="/contact" class="flex items-center gap-3 text-lg text-[#7BAF9B] hover:text-white transition-colors">
          <Icon name="tabler:mail" class="w-5 h-5 shrink-0" />
          Contact us
        </a>
        <a
          href="tel:+919400474785"
          class="flex items-center gap-3 text-lg text-[#7BAF9B] hover:text-white transition-colors"
        >
          <Icon name="tabler:phone" class="w-5 h-5 shrink-0" />
          +91 94004 74785
        </a>
        <a
          href="https://wa.me/919400474785"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-3 text-lg text-green-400 hover:text-white transition-colors"
        >
          <Icon name="tabler:brand-whatsapp" class="w-5 h-5 shrink-0" />
          WhatsApp me
        </a>
      </div>

      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href={calLink} target="_blank" rel="noopener noreferrer" class="btn-secondary-dark w-full sm:w-auto">
          Or book a 30-min call with our team
        </a>
      </div>
    </div>
  </section>
</Layout>
