---
import Layout from '~/layouts/PageLayout.astro';
import SchemaOrg from '~/components/common/SchemaOrg.astro';
import DarkHero from '~/components/widgets/DarkHero.astro';
import SchedulerDemoSection from '~/components/widgets/SchedulerDemoSection.astro';
import ProductFlow from '~/components/widgets/ProductFlow.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Product Tour | AI Nurse Scheduling Software',
  description:
    'AI-native nurse scheduling software for Texas Critical Access Hospitals: three schedule draft modes, 21 automated rule checks, callout replacement shortlists, PDF and Excel exports.',
  robots: { index: false, follow: true },
  canonical: 'https://simplescheduleai.com/product',
};

const ctaLink = 'https://cal.com/gautham-8bdvdx/30min';

const tiers = [
  {
    name: 'Monthly',
    price: '$10',
    cadence: 'per user / month',
    roster: 'Every nurse and manager on the roster is a user',
    note: 'Month to month, cancel anytime.',
    featured: false,
  },
  {
    name: 'Annual',
    price: '$100',
    cadence: 'per user / year',
    roster: 'Every nurse and manager on the roster is a user',
    note: 'Two months free against monthly billing.',
    featured: true,
  },
];

const softwareAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'SimpleScheduleAI',
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: 'Healthcare Scheduling Software',
  operatingSystem: 'Web',
  url: 'https://simplescheduleai.com/product',
  description:
    'AI-native nurse scheduling software for critical access hospitals. Generates balanced, fairness-optimized, and cost-optimized schedule drafts, ranks callout replacements, tracks FLSA overtime thresholds, and exports post-ready PDF and Excel schedules.',
  audience: {
    '@type': 'Audience',
    audienceType: 'Nurse Managers, Directors of Nursing, CAH Administrators',
  },
  featureList: [
    'AI-generated nurse schedules',
    'Three draft options: balanced, fairness-optimized, cost-optimized',
    'Real-time callout replacement shortlist',
    'Excel roster upload',
    'FLSA overtime threshold tracking',
    'Audit trail logging',
  ],
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'USD',
    lowPrice: '10',
    highPrice: '100',
    offerCount: '2',
    description: 'Per-user pricing: $10 per user per month, or $100 per user per year',
  },
};
---

<Layout metadata={metadata}>
  <SchemaOrg slot="head" schema={[softwareAppSchema]} />

  <!-- Product hero -->
  <DarkHero
    badge="Nurse scheduling software"
    title='Stop Building the Nurse Schedule by Hand. <span class="text-[#7BAF9B]">Approve It Instead.</span>'
    subtitle="The AI builds it, 21 rule checks validate it, you approve it. In the browser, nothing to install."
    actions={[
      { text: 'Try the interactive demo', href: '/simulator', variant: 'primary' },
      { text: 'Book a call with our team', href: ctaLink, variant: 'secondary' },
    ]}
  >
    <p class="text-sm text-[#FAF7F2]/50">The demo runs in your browser. No signup, no sales call first.</p>
  </DarkHero>

  <!-- Trust row: pre-launch credibility via what it plugs into and what it checks -->
  <section class="bg-page border-b border-hairline">
    <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm text-muted" data-reveal>
        <span class="flex items-center gap-2"
          ><span class="h-1.5 w-1.5 rounded-full bg-primary"></span>Excel roster in, PDF + Excel out</span
        >
        <span class="flex items-center gap-2"
          ><span class="h-1.5 w-1.5 rounded-full bg-primary"></span>21 automated rule checks per draft</span
        >
        <span class="flex items-center gap-2"
          ><span class="h-1.5 w-1.5 rounded-full bg-primary"></span>Runs in the browser, nothing to install</span
        >
        <span class="flex items-center gap-2"
          ><span class="h-1.5 w-1.5 rounded-full bg-primary"></span>Built for Texas Critical Access Hospitals</span
        >
        <span class="flex items-center gap-2"
          ><span class="h-1.5 w-1.5 rounded-full bg-primary"></span>$10 per user per month, no setup fees</span
        >
      </div>
    </div>
  </section>

  <!-- System flow widget: how the product works end to end -->
  <ProductFlow />

  <!-- See it work: four product frames, sample data -->
  <section class="bg-page">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
      <div class="max-w-2xl" data-reveal>
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-primary">The screens</p>
        <h2 class="font-heading text-3xl font-semibold tracking-tight sm:text-4xl">Four screens run your week</h2>
      </div>

      <div class="mx-auto mt-10 grid max-w-5xl gap-6 sm:grid-cols-2" data-reveal-group>
        {/* Frame 1: draft picker */}
        <div class="flex flex-col">
          <div
            class="rounded-xl border border-hairline bg-white shadow-[0_14px_40px_-28px_rgb(26_35_50/0.22)] overflow-hidden flex-1 flex flex-col"
          >
            <div class="bg-primary px-4 py-3">
              <p class="text-xs font-semibold text-white/70 uppercase tracking-wider">Cycle drafts</p>
              <p class="text-sm font-bold text-white mt-0.5">Week of Jul 13 · Pick one of three</p>
            </div>
            <div class="p-4 space-y-3 flex-1">
              <div class="rounded-lg border-2 border-primary bg-primary/5 p-3">
                <div class="flex items-center justify-between">
                  <p class="text-sm font-semibold">Balanced</p>
                  <span class="rounded bg-green-100 px-1.5 py-0.5 text-[10px] font-bold text-green-700">Selected</span>
                </div>
                <p class="mt-1 text-xs text-muted">Coverage 100% · Fairness 92 · Overtime 0h</p>
              </div>
              <div class="rounded-lg border border-hairline p-3">
                <p class="text-sm font-semibold">Fairness-optimized</p>
                <p class="mt-1 text-xs text-muted">Coverage 100% · Fairness 97 · Overtime 4h</p>
              </div>
              <div class="rounded-lg border border-hairline p-3">
                <p class="text-sm font-semibold">Cost-optimized</p>
                <p class="mt-1 text-xs text-muted">Coverage 100% · Fairness 88 · Overtime 0h · Lowest premium hours</p>
              </div>
            </div>
            <div class="border-t border-hairline px-4 py-2.5 bg-[#FAF7F2]">
              <span class="text-xs text-muted">Every draft covers every shift. You pick the trade-off.</span>
            </div>
          </div>
          <p class="mt-3 text-center text-xs text-muted">The AI builds three complete drafts each cycle.</p>
        </div>

        {/* Frame 2: rule check scan */}
        <div class="flex flex-col">
          <div
            class="rounded-xl border border-hairline bg-white shadow-[0_14px_40px_-28px_rgb(26_35_50/0.22)] overflow-hidden flex-1 flex flex-col"
          >
            <div class="bg-primary px-4 py-3 flex items-center justify-between">
              <div>
                <p class="text-xs font-semibold text-white/70 uppercase tracking-wider">Rule checks</p>
                <p class="text-sm font-bold text-white mt-0.5">Draft validation</p>
              </div>
              <span class="rounded-full bg-white/20 border border-white/30 px-2.5 py-1 text-xs font-semibold text-white"
                >21 / 21</span
              >
            </div>
            <div class="p-4 space-y-2.5 text-xs flex-1">
              <div class="flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-green-500 shrink-0"></span><span>Charge nurse on every shift</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-green-500 shrink-0"></span><span
                  >Skill mix holds on nights and weekends</span
                >
              </div>
              <div class="flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-green-500 shrink-0"></span><span
                  >FLSA overtime thresholds clear</span
                >
              </div>
              <div class="rounded-lg bg-amber-50 border border-amber-200 p-2.5">
                <p class="font-semibold text-amber-800">Caught before posting</p>
                <p class="mt-0.5 text-amber-700">
                  Dan B. was headed to 41h. Swapped Thursday night to Emma C., zero overtime.
                </p>
              </div>
              <div class="flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-green-500 shrink-0"></span><span
                  >Rest gaps between 12-hour stretches</span
                >
              </div>
              <div class="flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-green-500 shrink-0"></span><span>16 more checks, all passing</span>
              </div>
            </div>
            <div class="border-t border-hairline px-4 py-2.5 bg-[#FAF7F2]">
              <span class="text-xs text-muted">No rule can be quietly skipped.</span>
            </div>
          </div>
          <p class="mt-3 text-center text-xs text-muted">21 automated checks validate every draft before you see it.</p>
        </div>

        {/* Frame 3: callout shortlist */}
        <div class="flex flex-col">
          <div
            class="rounded-xl border border-hairline bg-white shadow-[0_14px_40px_-28px_rgb(26_35_50/0.22)] overflow-hidden flex-1 flex flex-col"
          >
            <div class="bg-primary px-5 py-4 flex items-center justify-between">
              <div>
                <p class="text-xs font-semibold text-white/70 uppercase tracking-wider">Callout logged · Night shift</p>
                <p class="text-sm font-bold text-white mt-0.5">Tue 02:14 AM · Replacement shortlist</p>
              </div>
              <span class="rounded-full bg-white/20 border border-white/30 px-3 py-1 text-xs font-semibold text-white"
                >3 candidates</span
              >
            </div>

            <div class="divide-y divide-gray-100 px-5 flex-1">
              <div class="py-4">
                <div class="flex items-center justify-between">
                  <p class="font-semibold text-sm">1. Jessica R. <span class="text-muted font-normal">RN</span></p>
                  <span class="rounded bg-green-100 px-1.5 py-0.5 text-[10px] font-bold text-green-700">Best fit</span>
                </div>
                <p class="mt-1 text-xs text-muted">
                  Night-qualified · 24h this week, no overtime risk · 2 weekends below rotation average
                </p>
              </div>
              <div class="py-4">
                <div class="flex items-center justify-between">
                  <p class="font-semibold text-sm">2. Michael B. <span class="text-muted font-normal">RN</span></p>
                  <span class="rounded bg-amber-100 px-1.5 py-0.5 text-[10px] font-bold text-amber-700"
                    >Watch hours</span
                  >
                </div>
                <p class="mt-1 text-xs text-muted">
                  Night-qualified · 34h this week, overtime if extended · charge-eligible backup
                </p>
              </div>
              <div class="py-4">
                <div class="flex items-center justify-between">
                  <p class="font-semibold text-sm">3. Amanda W. <span class="text-muted font-normal">LVN</span></p>
                  <span class="rounded bg-gray-100 px-1.5 py-0.5 text-[10px] font-bold text-gray-600">Role check</span>
                </div>
                <p class="mt-1 text-xs text-muted">
                  Available · skill mix holds only if paired with the on-shift RN · 18h this week
                </p>
              </div>
            </div>

            <div class="flex items-center justify-between border-t border-hairline px-5 py-3 bg-[#FAF7F2]">
              <div class="flex items-center gap-1.5">
                <span class="h-2 w-2 rounded-full bg-green-500"></span>
                <span class="text-xs text-muted">FLSA thresholds checked · charge coverage holds</span>
              </div>
              <span class="text-xs font-medium text-primary">Ranked in 4s</span>
            </div>
          </div>

          <p class="mt-3 text-center text-xs text-muted">A 2 AM callout returns a ranked shortlist with reasons.</p>
        </div>

        {/* Frame 4: swap approval */}
        <div class="flex flex-col">
          <div
            class="rounded-xl border border-hairline bg-white shadow-[0_14px_40px_-28px_rgb(26_35_50/0.22)] overflow-hidden flex-1 flex flex-col"
          >
            <div class="bg-primary px-4 py-3 flex items-center justify-between">
              <div>
                <p class="text-xs font-semibold text-white/70 uppercase tracking-wider">Swap request</p>
                <p class="text-sm font-bold text-white mt-0.5">Fri night · Awaiting your call</p>
              </div>
              <span class="rounded-full bg-white/20 border border-white/30 px-2.5 py-1 text-xs font-semibold text-white"
                >Pre-checked</span
              >
            </div>
            <div class="p-4 space-y-2.5 text-xs flex-1">
              <div class="rounded-lg border border-hairline p-2.5">
                <p class="text-sm font-semibold">
                  Sarah C. gives away <span class="text-muted font-normal">Fri 19:00 to 07:00</span>
                </p>
                <p class="mt-0.5 text-muted">Requested from her phone, Tue 8:52 PM</p>
              </div>
              <div class="rounded-lg border border-hairline p-2.5">
                <p class="text-sm font-semibold">
                  Emily D. takes it <span class="text-muted font-normal">RN, night-qualified</span>
                </p>
                <p class="mt-0.5 text-muted">Accepted Wed 6:15 AM</p>
              </div>
              <div class="flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-green-500 shrink-0"></span><span
                  >Skill mix holds on both shifts</span
                >
              </div>
              <div class="flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-green-500 shrink-0"></span><span>No overtime created</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="h-2 w-2 rounded-full bg-green-500 shrink-0"></span><span>Rest gaps preserved</span>
              </div>
            </div>
            <div class="border-t border-hairline px-4 py-2.5 bg-[#FAF7F2]">
              <span class="text-xs text-muted">One tap to approve; the schedule updates itself.</span>
            </div>
          </div>
          <p class="mt-3 text-center text-xs text-muted">Swaps arrive pre-checked against the same rules.</p>
        </div>
      </div>

      <p class="mt-8 text-center text-xs text-muted" data-reveal>
        Illustrative screens with sample data, matching the engine in the <a
          href="/simulator"
          class="text-primary underline">interactive demo</a
        >.
      </p>
    </div>
  </section>

  <!-- Interactive demo (same engine as /simulator) -->
  <SchedulerDemoSection
    tagline="Try it yourself"
    title="Watch it fill a week."
    subtitle="The engine fills every slot against 21 rule checks, right in your browser. No signup."
    ctaText="Try the interactive demo"
    ctaHref="/simulator"
  />

  <!-- Guided setup: four-week visual timeline -->
  <section class="bg-page">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
      <div class="max-w-2xl" data-reveal>
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-primary">Guided setup</p>
        <h2 class="font-heading text-3xl font-semibold tracking-tight sm:text-4xl">
          Four weeks to go-live. Most of it is ours.
        </h2>
      </div>

      {/* Mobile/tablet: the four weeks stack vertically. Copy must mirror the desktop grid below. */}
      <div class="mt-10 space-y-4 lg:hidden" data-reveal>
        <div class="rounded-2xl border border-hairline bg-white overflow-hidden">
          <div
            class="border-b border-hairline bg-[#FAF7F2] px-4 py-3 text-xs font-semibold uppercase tracking-wider text-muted"
          >
            Week 1
          </div>
          <div class="px-4 py-4">
            <p class="text-xs font-semibold uppercase tracking-wider text-muted">We do</p>
            <p class="mt-1 text-sm">Set up your hospital's workspace, import the roster</p>
            <p class="mt-4 text-xs font-semibold uppercase tracking-wider text-primary">You do</p>
            <p class="mt-1.5 inline-block rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary">
              Send the staff Excel you already keep
            </p>
          </div>
        </div>
        <div class="rounded-2xl border border-hairline bg-white overflow-hidden">
          <div
            class="border-b border-hairline bg-[#FAF7F2] px-4 py-3 text-xs font-semibold uppercase tracking-wider text-muted"
          >
            Week 2
          </div>
          <div class="px-4 py-4">
            <p class="text-xs font-semibold uppercase tracking-wider text-muted">We do</p>
            <p class="mt-1 text-sm">Map your units and rules with you: charge coverage, skill mix, on-call limits</p>
            <p class="mt-4 text-xs font-semibold uppercase tracking-wider text-primary">You do</p>
            <p class="mt-1.5 inline-block rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary">
              One rules session
            </p>
          </div>
        </div>
        <div class="rounded-2xl border border-hairline bg-white overflow-hidden">
          <div
            class="border-b border-hairline bg-[#FAF7F2] px-4 py-3 text-xs font-semibold uppercase tracking-wider text-muted"
          >
            Week 3
          </div>
          <div class="px-4 py-4">
            <p class="text-xs font-semibold uppercase tracking-wider text-muted">We do</p>
            <p class="mt-1 text-sm">Run test cycles against your real roster until every rule holds</p>
            <p class="mt-4 text-xs font-semibold uppercase tracking-wider text-primary">You do</p>
            <p class="mt-1 text-xs text-muted italic">Nothing. We are testing.</p>
          </div>
        </div>
        <div class="rounded-2xl border border-primary/40 bg-white overflow-hidden">
          <div
            class="border-b border-hairline bg-[#FAF7F2] px-4 py-3 text-xs font-semibold uppercase tracking-wider text-primary"
          >
            Week 4 · Go live
          </div>
          <div class="px-4 py-4">
            <p class="text-xs font-semibold uppercase tracking-wider text-muted">We do</p>
            <p class="mt-1 text-sm">Train your Director of Nursing on a full live cycle</p>
            <p class="mt-4 text-xs font-semibold uppercase tracking-wider text-primary">You do</p>
            <p class="mt-1.5 inline-block rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary">
              One training session, then approve your first schedule
            </p>
          </div>
        </div>
      </div>

      {/* Desktop: two-swimlane week grid */}
      <div class="mt-10 hidden overflow-x-auto lg:block" data-reveal>
        <div class="min-w-[52rem] rounded-2xl border border-hairline bg-white overflow-hidden">
          {/* Week rail */}
          <div class="grid grid-cols-[7rem_repeat(4,1fr)] border-b border-hairline bg-[#FAF7F2]">
            <div class="px-4 py-3"></div>
            <div class="px-4 py-3 text-xs font-semibold uppercase tracking-wider text-muted border-l border-hairline">
              Week 1
            </div>
            <div class="px-4 py-3 text-xs font-semibold uppercase tracking-wider text-muted border-l border-hairline">
              Week 2
            </div>
            <div class="px-4 py-3 text-xs font-semibold uppercase tracking-wider text-muted border-l border-hairline">
              Week 3
            </div>
            <div class="px-4 py-3 text-xs font-semibold uppercase tracking-wider text-primary border-l border-hairline">
              Week 4 · Go live
            </div>
          </div>

          {/* Our lane: dense */}
          <div class="grid grid-cols-[7rem_repeat(4,1fr)] border-b border-hairline">
            <div class="px-4 py-5 text-sm font-semibold">We do</div>
            <div class="px-4 py-5 border-l border-hairline">
              <p class="text-sm">Set up your hospital's workspace, import the roster</p>
            </div>
            <div class="px-4 py-5 border-l border-hairline">
              <p class="text-sm">Map your units and rules with you: charge coverage, skill mix, on-call limits</p>
            </div>
            <div class="px-4 py-5 border-l border-hairline">
              <p class="text-sm">Run test cycles against your real roster until every rule holds</p>
            </div>
            <div class="px-4 py-5 border-l border-hairline">
              <p class="text-sm">Train your Director of Nursing on a full live cycle</p>
            </div>
          </div>

          {/* Your lane: deliberately sparse — that is the argument */}
          <div class="grid grid-cols-[7rem_repeat(4,1fr)]">
            <div class="px-4 py-5 text-sm font-semibold text-primary">You do</div>
            <div class="px-4 py-5 border-l border-hairline">
              <p class="inline-block rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary">
                Send the staff Excel you already keep
              </p>
            </div>
            <div class="px-4 py-5 border-l border-hairline">
              <p class="inline-block rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary">
                One rules session
              </p>
            </div>
            <div class="px-4 py-5 border-l border-hairline">
              <p class="text-xs text-muted italic">Nothing. We are testing.</p>
            </div>
            <div class="px-4 py-5 border-l border-hairline">
              <p class="inline-block rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary">
                One training session, then approve your first schedule
              </p>
            </div>
          </div>
        </div>
      </div>
      <p class="mt-6 text-center text-sm text-muted" data-reveal>
        No installation, no integration project. After go-live, our support team stays a call away.
      </p>
    </div>
  </section>

  <!-- Pricing -->
  <section class="bg-page">
    <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
      <div class="max-w-2xl" data-reveal>
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-primary">Pricing</p>
        <h2 class="font-heading text-3xl font-semibold tracking-tight sm:text-4xl">Simple per-user pricing</h2>
        <p class="mt-4 text-lg text-muted">
          $10 per user per month, or $100 per user per year. Every nurse and manager on the roster is a user. No setup
          fees.
        </p>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-2" data-reveal-group>
        {
          tiers.map((tier) => (
            <div
              class={`rounded-2xl border p-8 ${tier.featured ? 'border-primary/50 bg-primary/5' : 'border-hairline bg-white dark:bg-slate-800'}`}
            >
              <h3 class="text-xl font-bold">{tier.name}</h3>
              <p class="mt-4 text-4xl font-bold">
                {tier.price}
                <span class="text-base font-medium text-muted">{tier.cadence}</span>
              </p>
              <p class="mt-1 text-sm font-medium text-primary">{tier.roster}</p>
              <p class="mt-2 text-sm text-muted">{tier.note}</p>
            </div>
          ))
        }
      </div>

      <p class="mt-6 text-center text-sm text-muted">
        Billed to the facility, cancel anytime. Users are added or removed as your roster changes. Multi-facility
        groups,
        <a href={ctaLink} class="text-primary underline">talk to us</a>.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <FAQs
    title="Questions about the product"
    tagline="Common questions"
    items={[
      {
        title: 'How long does it take to get started?',
        description:
          'About four weeks, and every step is accounted for: we collect your staff Excel, set up your workspace, import the roster, configure your units and rules with you in a guided setup session, train your DON, and go live.<br /><br />From that point the weekly cycle is yours to run, and our support team stays a call away whenever you need us. No installation, no integration project.',
      },
      {
        title: 'Do my nurses need to create accounts or download anything?',
        description:
