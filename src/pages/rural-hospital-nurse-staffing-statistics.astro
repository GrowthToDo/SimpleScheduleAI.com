---
import Layout from '~/layouts/PageLayout.astro';
import SchemaOrg from '~/components/common/SchemaOrg.astro';
import DarkHero from '~/components/widgets/DarkHero.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { PAGE_URL, sections, lastUpdated, lastUpdatedISO, allStats } from '~/data/staffing-stats';

const metadata = {
  title: 'Rural Hospital & CAH Nurse Staffing Statistics (2026)',
  description:
    'Sourced 2026 statistics on rural and Critical Access Hospital nurse staffing: RN turnover, vacancy, cost of turnover, rural density, wages, and the Texas CAH picture. Each figure is citable and embeddable.',
};

// Build the copy-to-clipboard embed HTML for each stat once, at build time.
const embedFor = (stat) =>
  `<blockquote style="font-family:system-ui,-apple-system,sans-serif;border-left:4px solid #1A2332;margin:16px 0;padding:8px 16px;">` +
  `<span style="font-size:1.6em;font-weight:700;color:#1A2332;">${stat.value}</span> ` +
  `&mdash; ${stat.label}. ` +
  `<span style="font-size:.85em;color:#555;">Source: <a href="${PAGE_URL}#${stat.anchor}">SimpleScheduleAI</a>, via ${stat.source}.</span>` +
  `</blockquote>`;

// Paste-ready citation. Journalists and bloggers want one string they can drop
// into a piece without composing it themselves.
const citationText = `SimpleScheduleAI (${lastUpdated.split(' ').pop()}). Rural Hospital & Critical Access Hospital Nurse Staffing Statistics. Updated ${lastUpdated}. ${PAGE_URL}`;

const datasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  '@id': `${PAGE_URL}#dataset`,
  name: 'Rural Hospital and Critical Access Hospital Nurse Staffing Statistics (2026)',
  description:
    'A sourced collection of 2026 nurse staffing statistics for rural and Critical Access Hospitals: RN turnover, vacancy, cost of turnover, rural workforce density, registered-nurse wages, and Texas-specific CAH figures.',
  url: PAGE_URL,
  keywords: [
    'critical access hospital',
    'rural hospital',
    'nurse staffing',
    'RN turnover',
    'RN vacancy',
    'nurse shortage',
    'Texas',
  ],
  creator: {
    '@type': 'Organization',
    '@id': 'https://simplescheduleai.com/#organization',
    name: 'SimpleScheduleAI',
  },
  isAccessibleForFree: true,
  license: 'https://creativecommons.org/licenses/by/4.0/',
  dateModified: lastUpdatedISO,
  variableMeasured: allStats.map((s) => s.label),
  distribution: [
    {
      '@type': 'DataDownload',
      encodingFormat: 'text/csv',
      contentUrl: `${PAGE_URL}.csv`,
    },
    {
      '@type': 'DataDownload',
      encodingFormat: 'application/json',
      contentUrl: `${PAGE_URL}.json`,
    },
  ],
};

const faqItems = [
  {
    title: 'How many Critical Access Hospitals are there in the United States?',
    description:
      'There were 1,383 certified Critical Access Hospitals as of April 2026, per the Flex Monitoring Team. These are rural hospitals of 25 or fewer acute-care beds.',
  },
  {
    title: 'What is the average hospital RN turnover rate?',
    description:
      'Average hospital RN turnover was 17.6% (18.6% median) in the 2026 NSI report, which covers calendar-year 2025 data from 527 hospitals across 40 states.',
  },
  {
    title: 'How much does it cost to replace a hospital nurse?',
    description:
      'The 2026 NSI report puts the cost of turning over one bedside RN at $60,090. At that rate, the average hospital loses $4.2M to $6.2M a year to RN turnover.',
  },
  {
    title: 'How many Critical Access Hospitals does Texas have?',
    description:
      'Texas has 91 Critical Access Hospitals today (Rural Health Information Hub, 2026). In the 2024 Texas DSHS study, which counted 86 CAHs at the time, CAH RN vacancy (11.6%) was lower than at other hospital types, but CAH RN turnover (18.2%) was the highest.',
  },
  {
    title: 'Can I reuse these statistics?',
    description:
      'Yes. Every figure is licensed CC BY 4.0. Use the "Copy embed" button on any card to grab a ready-made snippet, or cite the primary source listed on the card and link back to this page.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({
    '@type': 'Question',
    name: f.title,
    acceptedAnswer: { '@type': 'Answer', text: f.description },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://simplescheduleai.com' },
    { '@type': 'ListItem', position: 2, name: 'Rural Hospital & CAH Nurse Staffing Statistics', item: PAGE_URL },
  ],
};
---

<Layout metadata={metadata}>
  <SchemaOrg slot="head" schema={[datasetSchema, faqSchema, breadcrumbSchema]} />

  <DarkHero
    badge="Nurse Staffing Statistics"
    title="Rural Hospital & Critical Access Hospital Nurse Staffing Statistics"
    subtitle="A sourced 2026 reference on RN turnover, vacancy, cost of turnover, rural workforce density, wages, and the Texas CAH picture. Every figure is citable and embeddable."
    actions={[
      { text: 'Explore the statistics', href: '#cah-landscape', variant: 'primary' },
      { text: 'Book a call with our team', href: 'https://cal.com/gautham-8bdvdx/30min', variant: 'secondary' },
    ]}
  />

  <section class="bg-page py-10 md:py-14">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <p class="text-sm text-slate-600 dark:text-slate-400 mb-8">
        Compiled by <a href="/about/pradeep-pandey" class="underline decoration-dotted">Pradeep Pandey</a> · Updated{
          ' '
        }
        {lastUpdated} · Figures verified against primary sources (listed on each card and in
        <a href="#sources" class="underline decoration-dotted">Sources</a>).
      </p>

      <div class="not-prose mb-10 rounded-xl border border-hairline bg-white/60 dark:bg-slate-900/40 p-5">
        <p class="text-xs font-semibold uppercase tracking-widest text-primary mb-2">The short version</p>
        <p class="text-sm leading-relaxed text-slate-800 dark:text-slate-200 m-0">
          Rural and Critical Access Hospitals staff against the same national shortage as everyone else, from a thinner
          workforce and with almost no back office. There are 1,383 CAHs in the U.S.; average hospital RN turnover is
          17.6% and each departure costs about $60,090. In Texas specifically, CAHs run a lower RN vacancy (11.6%) but
          the highest RN turnover (18.2%) of any hospital type, staffed by a nurse workforce that is only 61% RN. The
          cards below are individually sourced and embeddable.
        </p>
      </div>

      {
        sections.map((section) => (
          <div class="mb-14 scroll-mt-24" id={section.id}>
            <h2 class="text-2xl md:text-3xl font-heading font-semibold tracking-tight text-slate-900 dark:text-slate-100 mb-3">
              {section.heading}
            </h2>
            <p
              class="text-slate-600 dark:text-slate-300 mb-4 max-w-3xl [&_a]:text-primary [&_a]:underline"
              set:html={section.intro}
            />
            <blockquote class="not-prose mb-6 max-w-3xl border-l-4 border-primary pl-4 font-heading text-lg md:text-xl font-medium leading-snug text-slate-900 dark:text-slate-100">
              {section.takeaway}
            </blockquote>
            <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {section.stats.map((stat) => (
                <figure
                  id={stat.anchor}
                  class="scroll-mt-24 flex flex-col rounded-xl border border-hairline bg-white dark:bg-slate-900/60 p-5 shadow-sm"
                >
                  <div class="font-heading text-3xl md:text-4xl font-bold tracking-tight text-primary">
                    {stat.value}
                  </div>
                  <figcaption class="mt-2 text-sm font-semibold text-slate-900 dark:text-slate-100">
                    {stat.label}
                  </figcaption>
                  <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400 grow">{stat.context}</p>
                  <div class="mt-4 flex items-center justify-between gap-3 border-t border-hairline pt-3">
                    <a
                      href={stat.url}
                      rel="noopener nofollow"
                      target="_blank"
                      class="text-xs text-slate-500 dark:text-slate-400 underline decoration-dotted hover:text-primary"
                    >
                      {stat.source}
                    </a>
                    <button
                      type="button"
                      class="stat-embed-btn shrink-0 rounded-md border border-hairline px-2.5 py-1 text-xs font-medium text-slate-600 dark:text-slate-300 hover:border-primary hover:text-primary transition-colors"
                      data-embed={embedFor(stat)}
                    >
                      Copy embed
                    </button>
                  </div>
                </figure>
              ))}
            </div>
          </div>
        ))
      }

      <div class="not-prose rounded-xl border border-hairline bg-slate-50 dark:bg-slate-900/40 p-6 mb-14">
        <h2 class="text-xl font-heading font-semibold text-slate-900 dark:text-slate-100 mb-2">
          How to cite and embed these statistics
        </h2>
        <p class="text-sm leading-relaxed text-slate-700 dark:text-slate-300 m-0">
          Every figure on this page is released under a
          <a
            href="https://creativecommons.org/licenses/by/4.0/"
            rel="noopener"
            target="_blank"
            class="text-primary underline">Creative Commons BY 4.0</a
          >
          license. Press <strong>Copy embed</strong> on any card to copy a ready-made HTML snippet you can paste into your
          own page; it carries the number, its plain-language label, and a link back here. Prefer to write your own? Cite
          the primary source shown on the card and link to this page as the collection.
        </p>

        <div id="cite" class="mt-5 scroll-mt-24">
          <p class="text-xs font-semibold uppercase tracking-widest text-primary mb-2">Cite this page</p>
          <div class="flex flex-col gap-2 sm:flex-row sm:items-start">
            <code
              id="citation-text"
              class="flex-1 rounded-lg border border-hairline bg-white/70 dark:bg-slate-900/60 px-3 py-2 text-xs leading-relaxed text-slate-800 dark:text-slate-200 break-words"
              >{citationText}</code
            >
            <button
              type="button"
              data-copy-citation
              class="shrink-0 rounded-lg border border-primary/40 px-3 py-2 text-xs font-semibold text-primary hover:bg-primary/5 transition-colors"
              >Copy citation</button
            >
          </div>
        </div>

        <div id="download" class="mt-5 scroll-mt-24">
          <p class="text-xs font-semibold uppercase tracking-widest text-primary mb-2">Download the dataset</p>
          <p class="text-sm leading-relaxed text-slate-700 dark:text-slate-300 m-0">
            Every figure on this page, with its primary source and a permalink, as
            <a href="/rural-hospital-nurse-staffing-statistics.csv" class="text-primary underline">CSV</a> or
            <a href="/rural-hospital-nurse-staffing-statistics.json" class="text-primary underline">JSON</a>. Same
            numbers as the cards above.
          </p>
        </div>
      </div>

      <div
        id="press"
        class="not-prose scroll-mt-24 rounded-xl border border-hairline bg-slate-50 dark:bg-slate-900/40 p-6 mb-14"
      >
        <h2 class="text-xl font-heading font-semibold text-slate-900 dark:text-slate-100 mb-2">For journalists</h2>
        <p class="text-sm leading-relaxed text-slate-700 dark:text-slate-300 mb-3">
          If you are writing about rural hospital staffing and want the reasoning behind any figure here, or a comment
          on what these numbers look like inside a 25-bed hospital, Pradeep Pandey is available. He is the co-founder of
          SimpleScheduleAI, Deputy General Manager of Operations at Apollo Hospitals, and has run more than 30 in-depth
          interviews with nurse managers and chief nursing officers at Texas Critical Access Hospitals.
        </p>
        <p class="text-sm leading-relaxed text-slate-700 dark:text-slate-300 m-0">
          Email <a href="mailto:support@simplescheduleai.com" class="text-primary underline"
            >support@simplescheduleai.com</a
          >, or reach him directly on
          <a
            href="https://www.linkedin.com/in/pradeep-pandeyji/"
            rel="noopener"
            target="_blank"
            class="text-primary underline">LinkedIn</a
          >.
        </p>
      </div>

      <div class="not-prose rounded-xl border border-hairline p-6 mb-4">
        <h2 class="text-xl font-heading font-semibold text-slate-900 dark:text-slate-100 mb-3">Related guides</h2>
        <ul class="grid gap-2 sm:grid-cols-2 text-sm">
          <li>
            <a href="/critical-access-hospital-scheduling" class="text-primary underline"
              >Critical Access Hospital scheduling: the complete guide</a
            >
          </li>
          <li>
            <a href="/nurse-scheduling-software" class="text-primary underline"
              >Nurse scheduling software for small hospitals</a
            >
          </li>
          <li><a href="/ai-nurse-scheduling" class="text-primary underline">AI nurse scheduling: how it works</a></li>
          <li>
            <a href="/blog/nurse-staffing-ratios-critical-access-hospital" class="text-primary underline"
              >Nurse staffing ratios at a CAH</a
            >
          </li>
        </ul>
      </div>
    </div>
  </section>

  <FAQs title="Frequently Asked Questions" subtitle="Rural and CAH nurse staffing, in numbers." items={faqItems} />

  <section class="bg-page pb-14" id="sources">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-xl font-heading font-semibold text-slate-900 dark:text-slate-100 mb-3">Sources</h2>
      <p class="text-sm text-slate-600 dark:text-slate-400 mb-4 max-w-3xl">
        National figures use the 2026 NSI report (calendar-year 2025 data). Texas figures use the Texas DSHS 2024
        Hospital Nurse Staffing Study (spring-2024 survey, published February 2025). Wage figures reflect BLS May 2025
        OEWS data republished by O*NET and sit at the median position. The CAH CEO recruiting figures are from a
        March–May 2022 survey.
      </p>
      <ol
        class="list-decimal space-y-1.5 pl-5 text-sm text-slate-600 dark:text-slate-400 [&_a]:text-primary [&_a]:underline [&_a]:decoration-dotted"
      >
        <li>
          Flex Monitoring Team, Historical CAH Data. <a
            href="https://www.flexmonitoring.org/historical-cah-data-0"
            rel="noopener"
            target="_blank">flexmonitoring.org</a
          >.
        </li>
        <li>
          UNC Sheps Center, Rural Hospital Closures Tracker. <a
            href="https://www.shepscenter.unc.edu/programs-projects/rural-health/rural-hospital-closures/"
            rel="noopener"
            target="_blank">shepscenter.unc.edu</a
          >.
        </li>
        <li>
          Flex Monitoring Team, CAH workforce policy brief (February 2023). <a
            href="https://www.flexmonitoring.org/sites/flexmonitoring.umn.edu/files/media/CAH_workforce_during_COVID_Barriers_and_facilitators_for_recruiting_and_retaining_staff_2025.pdf"
            rel="noopener"
            target="_blank">flexmonitoring.org (PDF)</a
          >.
        </li>
        <li>
          2026 NSI National Health Care Retention &amp; RN Staffing Report. <a
            href="https://www.nsinursingsolutions.com/documents/library/nsi_national_health_care_retention_report.pdf"
            rel="noopener"
            target="_blank">nsinursingsolutions.com (PDF)</a
          >.
        </li>
        <li>
          Rural Health Information Hub, Health Care Workforce. <a
            href="https://www.ruralhealthinfo.org/topics/health-care-workforce"
            rel="noopener"
            target="_blank">ruralhealthinfo.org</a
          >.
        </li>
        <li>
          HRSA / National Center for Health Workforce Analysis, workforce projections (December 2025). <a
            href="https://bhw.hrsa.gov/data-research/projecting-health-workforce-supply-demand"
            rel="noopener"
            target="_blank">bhw.hrsa.gov</a
          >.
        </li>
        <li>
          O*NET OnLine, 29-1141.00 local wages (BLS May 2025 OEWS). <a
            href="https://www.onetonline.org/link/localwages/29-1141.00?st=TX"
            rel="noopener"
            target="_blank">onetonline.org</a
          >.
        </li>
        <li>
          Texas DSHS 2024 Hospital Nurse Staffing Study, Rural/CAH factsheet. <a
            href="https://www.dshs.texas.gov/sites/default/files/chs/cnws/HNSS/2024/2024_HNSS_RuralCAH_accessible.pdf"
            rel="noopener"
            target="_blank">dshs.texas.gov (PDF)</a
          >.
        </li>
        <li>
          Texas DSHS 2024 Hospital Nurse Staffing Study, Highlights factsheet. <a
            href="https://www.dshs.texas.gov/sites/default/files/chs/cnws/HNSS/2024/2024_HNSS_Highlights_accessible.pdf"
            rel="noopener"
            target="_blank">dshs.texas.gov (PDF)</a
          >.
        </li>
      </ol>
    </div>
  </section>

  <CallToAction
    title="Staffing a rural hospital against these numbers?"
    subtitle="SimpleScheduleAI is an AI-native nurse scheduling service built for Texas Critical Access Hospitals: the schedule built, callouts ranked, and CMS documentation maintained, so the nurse manager gets time back."
    actions={[
      { text: 'See how it works', href: '/how-it-works', variant: 'primary' },
      { text: 'Book a call with our team', href: 'https://cal.com/gautham-8bdvdx/30min', variant: 'secondary' },
    ]}
  />
</Layout>

<script>
  // Citation copy button. Same fallback shape as the per-card embed buttons below.
  document.querySelectorAll('[data-copy-citation]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = document.getElementById('citation-text')?.textContent?.trim() || '';
      const original = btn.textContent;
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = 'Copied ✓';
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try {
          document.execCommand('copy');
          btn.textContent = 'Copied ✓';
        } catch {
          btn.textContent = 'Copy failed';
        }
        ta.remove();
      }
      setTimeout(() => {
        btn.textContent = original;
      }, 2000);
    });
  });

  document.querySelectorAll('.stat-embed-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const snippet = btn.getAttribute('data-embed') || '';
      const original = btn.textContent;
      try {
        await navigator.clipboard.writeText(snippet);
        btn.textContent = 'Copied ✓';
      } catch {
        // Clipboard API unavailable (e.g. insecure context): fall back to a textarea select.
        const ta = document.createElement('textarea');
        ta.value = snippet;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try {
          document.execCommand('copy');
          btn.textContent = 'Copied ✓';
        } catch {
          btn.textContent = 'Copy failed';
        }
        ta.remove();
      }
      setTimeout(() => {
        btn.textContent = original;
      }, 1800);
    });
  });
</script>
