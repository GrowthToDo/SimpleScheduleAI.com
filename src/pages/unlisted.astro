---
import Layout from '~/layouts/PageLayout.astro';

// Private directory of every unlisted surface on this site. This page is
// itself unlisted: noindex + excluded from the sitemap (astro.config.ts).
// Add a row here whenever a new unlisted page ships.
const metadata = {
  title: 'Unlisted Pages | SimpleScheduleAI',
  description: 'Private directory of unlisted SimpleScheduleAI pages.',
  robots: { index: false, follow: false },
};

const pages = [
  {
    href: '/slides',
    title: 'Pitch Deck',
    desc: 'The product deck, for buyers. What SimpleScheduleAI is and why a hospital should use it.',
  },
  {
    href: '/proof-of-work/slides',
    title: 'Proof of Work · Deck',
    desc: 'The progress deck, for investors and helpers. What we have done, with the receipts.',
  },
  {
    href: '/proof-of-work',
    title: 'Proof of Work · Evidence Page',
    desc: 'The full evidence document behind the deck.',
  },
  {
    href: '/product',
    title: 'Product Positioning Page',
    desc: 'Positioning experiment, internal for now.',
  },
  {
    href: '/ask',
    title: 'Warm Intro Request',
    desc: 'The "how you can help" page, for friends of the company.',
  },
];
---

<Layout metadata={metadata}>
  <section class="bg-page">
    <div class="mx-auto max-w-3xl px-4 pt-14 pb-16 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white">Unlisted pages.</h1>
      <p class="mt-3 text-muted">Shared by link only. Not in search, not in the sitemap.</p>

      <ul class="mt-10 divide-y divide-gray-200 dark:divide-gray-700">
        {
          pages.map((p) => (
            <li>
              <a href={p.href} class="group flex items-baseline gap-4 py-5">
                <span class="text-2xl font-bold text-primary group-hover:underline whitespace-nowrap">
                  {p.title} &rarr;
                </span>
                <span class="hidden sm:inline font-mono text-sm text-muted">{p.href}</span>
              </a>
              <p class="-mt-3 pb-5 text-sm text-muted">{p.desc}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>
