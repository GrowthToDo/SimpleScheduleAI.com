---
// Proof of Work: standalone slide deck, no site layout.
// Fixed 1280x720 canvas + viewport scaler, same architecture as /slides.
// Unlisted: noindex + covered by the '/proof-of-work' sitemap exclusion.
// Visual-first build (26 Jul 2026): the GSC momentum chart and buyer-intent
// lollipop are ported from /proof-of-work and restyled for the dark canvas;
// slide text is stripped to captions.
import '@fontsource-variable/fraunces';

// Live content counts, computed at build so the deck's numbers never go stale.
const pMods = import.meta.glob('../../data/post/*.md', { eager: true });
const aMods = import.meta.glob('../../data/article/*.md', { eager: true });
const allDocs: any[] = [...Object.values(pMods), ...Object.values(aMods)];
const liveCount = allDocs.filter((m) => m.frontmatter?.draft === false).length;
const draftCount = allDocs.filter((m) => m.frontmatter?.draft === true).length;
const authoredCount = liveCount + draftCount;

// --- Momentum chart data (same series as /proof-of-work, GSC API, weekly) ---
const momentum = [
  { wk: 'Apr 16', imp: 750, pos: 50.5 },
  { wk: 'Apr 23', imp: 1219, pos: 31.8 },
  { wk: 'Apr 30', imp: 1320, pos: 24.2 },
  { wk: 'May 7', imp: 1714, pos: 20.9 },
  { wk: 'May 14', imp: 2085, pos: 18.0 },
  { wk: 'May 21', imp: 1920, pos: 19.8 },
  { wk: 'May 28', imp: 1488, pos: 15.3 },
  { wk: 'Jun 4', imp: 1465, pos: 15.1 },
  { wk: 'Jun 11', imp: 1394, pos: 19.2 },
  { wk: 'Jun 18', imp: 1285, pos: 16.9 },
  { wk: 'Jun 25', imp: 1735, pos: 16.3 },
  { wk: 'Jul 2', imp: 1841, pos: 13.8 },
  { wk: 'Jul 9', imp: 2053, pos: 14.7 },
];
const mN = momentum.length;
const plotL = 40,
  plotR = 1064;
const xAt = (i: number) => plotL + (i * (plotR - plotL)) / (mN - 1);
const barW = 42;
const fmtK = (n: number) => (n >= 1000 ? `${Math.floor(n / 1000)},${String(n % 1000).padStart(3, '0')}` : String(n));
// Impressions panel (bars, labelled above each bar).
const iTop = 26,
  iBot = 148,
  iMax = 2300;
const iY = (v: number) => iBot - (v / iMax) * (iBot - iTop);
const iBars = momentum.map((d, i) => ({
  x: xAt(i) - barW / 2,
  y: iY(d.imp),
  h: iBot - iY(d.imp),
  cx: xAt(i),
  val: d.imp,
}));
// Position panel (inverted scale: a rising line is an improving rank).
const pTop = 30,
  pBot = 138,
  pMin = 10,
  pMax = 52;
const pY = (v: number) => pTop + ((v - pMin) / (pMax - pMin)) * (pBot - pTop);
const pLine = momentum.map((d, i) => `${xAt(i).toFixed(1)},${pY(d.pos).toFixed(1)}`).join(' ');
const pDots = momentum.map((d, i) => ({ x: xAt(i), y: pY(d.pos), pos: d.pos }));
const mLabels = momentum.map((d, i) => ({ x: xAt(i), wk: d.wk, show: i % 2 === 0 }));

// --- Buyer-intent ranking lollipop (Google + Bing, 28 days to 10 Jul 2026) ---
const rankData = [
  { q: 'best software for nurse scheduling', pos: 1, engine: 'Bing' },
  { q: 'ai healthcare scheduling tool not ukg not qgenda', pos: 1, engine: 'Bing' },
  { q: 'replacements for qgenda', pos: 1, engine: 'Bing' },
  { q: 'best nurse scheduling software for small hospitals', pos: 2, engine: 'Bing' },
  { q: 'best aladtec alternatives', pos: 2.5, engine: 'Google' },
  { q: 'nurse scheduling software', pos: 3, engine: 'Bing' },
  { q: 'alternatives to aladtec', pos: 4.8, engine: 'Google' },
  { q: 'best nurse scheduling software 2026', pos: 6.7, engine: 'Google' },
  { q: 'alternatives to smartlinx software', pos: 7.5, engine: 'Google' },
  { q: 'best alternatives to qgenda for ambulatory practice', pos: 8.7, engine: 'Google' },
  { q: 'alternatives to shiftwizard software', pos: 9.9, engine: 'Google' },
  { q: 'what is the best alternative to qgenda', pos: 10.4, engine: 'Google' },
  { q: 'nurse scheduling software pricing', pos: 11.2, engine: 'Google' },
];
const rankPct = (p: number) => (((p - 1) / 11) * 100).toFixed(1);

// --- AI answer engine verdicts (logged probes, 22 Jul 2026) ---
const aiCites = [
  { engine: 'Perplexity', model: 'Sonar Pro', result: 'Named us on all three buyer prompts, citing four pages.' },
  { engine: 'ChatGPT', model: 'GPT-5.5', result: 'Named us the best fit for a small CAH in Texas.' },
  { engine: 'Google AI Overview', model: '', result: 'Named SimpleScheduleAI the first of three picks.' },
  { engine: 'Gemini', model: '2.5 Flash', result: 'Named us on two of three buyer prompts.' },
];

// --- Problem slide: stylized Excel grid with conflicts ---
const gridCols = 8,
  gridRows = 7,
  cellW = 62,
  cellH = 40,
  gridX = 10,
  gridY = 34;
const conflictCells = [
  { c: 2, r: 1 },
  { c: 5, r: 2 },
  { c: 3, r: 4 },
  { c: 6, r: 5 },
];
const warnCells = [
  { c: 1, r: 3 },
  { c: 4, r: 0 },
  { c: 7, r: 3 },
  { c: 0, r: 5 },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Proof of Work | SimpleScheduleAI</title>
    <meta name="robots" content="noindex" />
    <meta name="description" content="Proof-of-work slide deck: what SimpleScheduleAI has built and shipped." />
    <link rel="canonical" href="https://simplescheduleai.com/proof-of-work/slides" />
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      :root {
        --bg: #131c2b;
        --bg-deep: #0d141f;
        --surface: rgba(255, 255, 255, 0.035);
        --border: rgba(123, 175, 155, 0.16);
        --hairline: rgba(255, 255, 255, 0.08);
        --accent: #7baf9b;
        --accent-bright: #9ecfbb;
        --amber: #d9a441;
        --red: #d96a5a;
        --text: #f2f5f4;
        --muted: #92a2b3;
        --serif: 'Fraunces Variable', Georgia, serif;
        --sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
        --slide-w: 1280px;
        --slide-h: 720px;
      }

      html,
      body {
        width: 100%;
        height: 100%;
        background: #090e16;
        font-family: var(--sans);
        color: var(--text);
        overflow: hidden;
        user-select: none;
      }

      /* ── Viewport scaler ── */
      #scaler {
        position: fixed;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      #deck {
        position: relative;
        width: var(--slide-w);
        height: var(--slide-h);
        transform-origin: center center;
        box-shadow: 0 40px 120px rgba(0, 0, 0, 0.55);
      }

      /* ── Slides ── */
      .slide {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 72px 88px;
        background:
          radial-gradient(1000px 600px at 85% -10%, rgba(123, 175, 155, 0.1) 0%, transparent 55%),
          radial-gradient(800px 500px at -10% 110%, rgba(123, 175, 155, 0.06) 0%, transparent 55%),
          linear-gradient(160deg, var(--bg) 0%, var(--bg-deep) 100%);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.5s ease;
        overflow: hidden;
      }
      .slide.active {
        opacity: 1;
        pointer-events: auto;
      }
      /* faint blueprint grid */
      .slide::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
        background-size: 64px 64px;
        pointer-events: none;
      }

      /* ghost section number */
      .ghost {
        position: absolute;
        right: 40px;
        bottom: -60px;
        font-family: var(--serif);
        font-weight: 300;
        font-size: 380px;
        line-height: 1;
        color: rgba(123, 175, 155, 0.07);
        pointer-events: none;
        letter-spacing: -0.04em;
      }

      /* ── Slide furniture ── */
      .brand {
        position: absolute;
        top: 36px;
        left: 88px;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.04em;
      }
      .brand span {
        color: var(--accent);
      }
      .section-label {
        position: absolute;
        top: 36px;
        right: 88px;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .kicker {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 24px;
      }
      .kicker::before {
        content: '';
        width: 28px;
        height: 1px;
        background: var(--accent);
      }

      h1 {
        font-family: var(--serif);
        font-weight: 470;
        font-size: 84px;
        line-height: 1.02;
        letter-spacing: -0.015em;
      }
      h2 {
        font-family: var(--serif);
        font-weight: 460;
        font-size: 56px;
        line-height: 1.06;
        letter-spacing: -0.01em;
        max-width: 20ch;
      }
      h2.compact {
        font-size: 44px;
      }
      .accent {
        color: var(--accent-bright);
      }
      em {
        font-style: italic;
      }

      .lead {
        font-size: 23px;
        line-height: 1.6;
        color: var(--muted);
        max-width: 62ch;
        margin-top: 22px;
      }
      .lead strong {
        color: var(--text);
        font-weight: 600;
      }

      /* caption under a chart */
      .caption {
        margin-top: 18px;
        font-size: 16px;
        line-height: 1.5;
        color: var(--muted);
      }
      .caption b {
        color: var(--text);
        font-weight: 600;
      }

      /* stage line on title */
      .stage {
        position: absolute;
        left: 88px;
        right: 88px;
        bottom: 56px;
        display: flex;
        gap: 16px;
        align-items: flex-start;
        border-top: 1px solid var(--hairline);
        padding-top: 20px;
        font-size: 17px;
        line-height: 1.55;
        color: var(--muted);
      }
      .stage b {
        color: var(--text);
        font-weight: 600;
        white-space: nowrap;
      }

      /* ── Cards & grids ── */
      .grid {
        display: grid;
        gap: 18px;
        margin-top: 40px;
      }
      .grid.cols-3 {
        grid-template-columns: repeat(3, 1fr);
      }
      .grid.cols-2 {
        grid-template-columns: repeat(2, 1fr);
      }
      .card {
        position: relative;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 26px 28px;
        backdrop-filter: blur(2px);
      }
      .card h3 {
        font-size: 20px;
        font-weight: 700;
        margin-bottom: 8px;
      }
      .card p {
        font-size: 16.5px;
        line-height: 1.55;
        color: var(--muted);
      }
      .card .figure {
        font-family: var(--serif);
        font-weight: 430;
        font-size: 54px;
        line-height: 1.1;
        color: var(--accent-bright);
        margin-bottom: 6px;
      }

      /* stat tiles */
      .stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0;
        margin-top: 44px;
        border: 1px solid var(--hairline);
        border-radius: 20px;
        overflow: hidden;
      }
      .stat {
        padding: 30px 30px 26px;
        border-right: 1px solid var(--hairline);
        border-bottom: 1px solid var(--hairline);
        background: rgba(255, 255, 255, 0.02);
      }
      .stat:nth-child(3n) {
        border-right: none;
      }
      .stat:nth-child(n + 4) {
        border-bottom: none;
      }
      .stat .num {
        font-family: var(--serif);
        font-weight: 400;
        font-size: 64px;
        line-height: 1;
        color: var(--accent-bright);
      }
      .stat .num small {
        font-size: 32px;
      }
      .stat p {
        margin-top: 10px;
        font-size: 15.5px;
        line-height: 1.5;
        color: var(--muted);
      }

      /* ── Chart panels ── */
      .panel {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 20px 24px 14px;
        margin-top: 20px;
      }
      .panel .panel-title {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        font-size: 16px;
        font-weight: 700;
        margin-bottom: 4px;
      }
      .panel .panel-title span {
        font-size: 14px;
        font-weight: 500;
        color: var(--muted);
      }
      .panel svg {
        width: 100%;
        display: block;
      }
      .chart-bar {
        fill: rgba(123, 175, 155, 0.55);
      }
      .chart-bar-label {
        fill: var(--muted);
        font-size: 14px;
        font-weight: 600;
      }
      .chart-axis {
        fill: rgba(146, 162, 179, 0.7);
        font-size: 14px;
      }
      .chart-line {
        stroke: var(--accent-bright);
        stroke-width: 3;
        fill: none;
        stroke-linecap: round;
        stroke-linejoin: round;
      }
      .chart-dot {
        fill: var(--accent-bright);
        stroke: var(--bg);
        stroke-width: 2;
      }
      .chart-dot-label {
        fill: var(--accent-bright);
        font-size: 14px;
        font-weight: 700;
      }

      /* lollipop ranking rows */
      .ranks {
        margin-top: 28px;
        display: flex;
        flex-direction: column;
        gap: 7px;
      }
      .rank-row {
        display: flex;
        align-items: center;
        gap: 16px;
      }
      .rank-row .q {
        width: 420px;
        flex-shrink: 0;
        font-size: 15.5px;
        color: var(--muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        text-align: right;
      }
      .rank-row .q b {
        color: var(--text);
        font-weight: 600;
      }
      .rank-row .track {
        position: relative;
        flex: 1;
        height: 18px;
        border-radius: 9px;
        background: rgba(255, 255, 255, 0.045);
      }
      .rank-row .dot {
        position: absolute;
        top: 50%;
        transform: translate(-50%, -50%);
        width: 13px;
        height: 13px;
        border-radius: 50%;
        background: var(--accent-bright);
        box-shadow: 0 0 10px rgba(158, 207, 187, 0.45);
      }
      .rank-row .dot.bing {
        background: var(--amber);
        box-shadow: 0 0 10px rgba(217, 164, 65, 0.4);
      }
      .rank-row .pos {
        width: 48px;
        flex-shrink: 0;
        font-family: var(--serif);
        font-size: 22px;
        font-weight: 500;
        color: var(--text);
        text-align: right;
      }
      .rank-legend {
        display: flex;
        gap: 22px;
        margin-top: 20px;
        font-size: 15px;
        color: var(--muted);
        align-items: center;
      }
      .rank-legend i {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        margin-right: 7px;
      }

      /* AI engine cards */
      .cited {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        background: rgba(123, 175, 155, 0.16);
        border: 1px solid var(--border);
        color: var(--accent-bright);
        font-size: 10.5px;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        padding: 5px 12px;
      }
      .ai-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
      }
      .ai-head h3 {
        font-size: 22px;
      }
      .ai-head h3 small {
        font-size: 14px;
        font-weight: 500;
        color: var(--muted);
        margin-left: 8px;
      }

      /* problem slide: excel grid */
      .split {
        display: grid;
        grid-template-columns: 1fr 480px;
        gap: 48px;
        align-items: center;
        margin-top: 12px;
      }
      .mini-stats {
        display: flex;
        flex-direction: column;
        gap: 18px;
        margin-top: 34px;
      }
      .mini-stat {
        display: flex;
        align-items: baseline;
        gap: 18px;
      }
      .mini-stat .num {
        font-family: var(--serif);
        font-weight: 420;
        font-size: 58px;
        line-height: 1;
        color: var(--accent-bright);
        min-width: 185px;
      }
      .mini-stat .num small {
        font-size: 28px;
      }
      .mini-stat p {
        font-size: 17px;
        line-height: 1.45;
        color: var(--muted);
        max-width: 34ch;
      }
      .excel-frame {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 18px;
      }
      .excel-frame svg {
        width: 100%;
        display: block;
      }
      .excel-caption {
        margin-top: 12px;
        font-size: 15px;
        color: var(--muted);
        text-align: center;
      }

      /* quote slides */
      .quote-mark {
        font-family: var(--serif);
        font-size: 160px;
        line-height: 0.6;
        color: var(--accent);
        opacity: 0.9;
        display: block;
        margin-bottom: 8px;
        font-weight: 300;
      }
      blockquote {
        font-family: var(--serif);
        font-weight: 420;
        font-style: italic;
        font-size: 54px;
        line-height: 1.22;
        letter-spacing: -0.005em;
        max-width: 24ch;
      }
      blockquote .hl {
        color: var(--accent-bright);
      }
      .attribution {
        margin-top: 42px;
        display: flex;
        align-items: center;
        gap: 16px;
        font-size: 17px;
        color: var(--muted);
        line-height: 1.5;
        max-width: 70ch;
      }
      .attribution::before {
        content: '';
        width: 44px;
        height: 1px;
        background: var(--accent);
        flex-shrink: 0;
      }
      .attribution b {
        color: var(--text);
        font-weight: 600;
      }

      /* validation setup slide */
      .mono-date {
        font-family: var(--serif);
        font-size: 30px;
        color: var(--accent-bright);
        font-weight: 450;
      }
      .backers {
        display: flex;
        gap: 14px;
        margin-top: 36px;
      }
      .backers span {
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 10px 22px;
        font-size: 17px;
        font-weight: 600;
        color: var(--text);
        background: var(--surface);
      }

      /* CTA */
      .cta {
        margin-top: 46px;
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
      }
      .cta a {
        display: inline-block;
        padding: 15px 30px;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 700;
        font-size: 16px;
        transition: all 0.2s;
      }
      .cta a.primary {
        background: var(--accent);
        color: #10251d;
      }
      .cta a.primary:hover {
        background: var(--accent-bright);
      }
      .cta a.secondary {
        border: 1px solid var(--border);
        color: var(--text);
      }
      .cta a.secondary:hover {
        border-color: var(--accent);
        color: var(--accent-bright);
      }

      /* ── Reveal animation (kept fast: this deck is for skimming) ── */
      .reveal {
        opacity: 0;
        transform: translateY(18px);
        transition:
          opacity 0.35s ease,
          transform 0.35s ease;
      }
      .slide.active .reveal {
        opacity: 1;
        transform: none;
      }
      .slide.active .reveal:nth-child(1),
      .slide.active .reveal.d1 {
        transition-delay: 0.03s;
      }
      .slide.active .reveal.d2 {
        transition-delay: 0.1s;
      }
      .slide.active .reveal.d3 {
        transition-delay: 0.18s;
      }
      .slide.active .reveal.d4 {
        transition-delay: 0.26s;
      }

      /* rankings callout */
      .rank-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 24px;
        flex-wrap: wrap;
      }
      .rank-callout {
        text-align: right;
      }
      .rank-callout .num {
        font-family: var(--serif);
        font-weight: 420;
        font-size: 58px;
        line-height: 1;
        color: var(--accent-bright);
      }
      .rank-callout p {
        font-size: 14px;
        color: var(--muted);
        margin-top: 6px;
      }

      /* ── Chrome ── */
      #progress {
        position: fixed;
        top: 0;
        left: 0;
        height: 3px;
        background: var(--accent);
        width: 0;
        transition: width 0.35s ease;
        z-index: 20;
      }
      #counter {
        position: fixed;
        bottom: 18px;
        right: 22px;
        font-size: 12px;
        letter-spacing: 0.12em;
        color: var(--muted);
        z-index: 20;
      }
      #hint {
        position: fixed;
        bottom: 18px;
        left: 22px;
        font-size: 12px;
        letter-spacing: 0.06em;
        color: var(--muted);
        opacity: 0.7;
        z-index: 20;
      }

      /* ── Mobile: vertical scroll mode, slides stack as full-width cards ── */
      @media (max-width: 820px) {
        html,
        body {
          overflow: auto;
          height: auto;
          user-select: text;
        }
        #scaler {
          position: static;
          display: block;
        }
        #deck {
          width: 100%;
          height: auto;
          transform: none !important;
          box-shadow: none;
        }
        .slide {
          position: relative;
          inset: auto;
          opacity: 1;
          pointer-events: auto;
          height: auto;
          padding: 36px 22px 48px !important;
          justify-content: flex-start;
