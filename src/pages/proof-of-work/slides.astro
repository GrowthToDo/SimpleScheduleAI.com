    <div id="counter">1 / 11</div>
    <div id="hint">← → to navigate</div>

    <script>
      const slides = Array.from(document.querySelectorAll<HTMLElement>('.slide'));
      const counter = document.getElementById('counter');
      const progress = document.getElementById('progress');
      let index = 0;

      function show(i: number) {
        index = Math.max(0, Math.min(slides.length - 1, i));
        slides.forEach((s, j) => s.classList.toggle('active', j === index));
        if (counter) counter.textContent = `${index + 1} / ${slides.length}`;
        if (progress) progress.style.width = `${((index + 1) / slides.length) * 100}%`;
      }

      document.addEventListener('keydown', (e) => {
        if (['ArrowRight', 'ArrowDown', ' ', 'PageDown', 'Enter'].includes(e.key)) {
          e.preventDefault();
          show(index + 1);
        } else if (['ArrowLeft', 'ArrowUp', 'PageUp'].includes(e.key)) {
          e.preventDefault();
          show(index - 1);
        } else if (e.key === 'Home') {
          show(0);
        } else if (e.key === 'End') {
          show(slides.length - 1);
        }
      });

      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('a')) return;
        show(e.clientX > window.innerWidth / 2 ? index + 1 : index - 1);
      });

      // wheel / trackpad
      let wheelLock = false;
      document.addEventListener(
        'wheel',
        (e) => {
          if (wheelLock || Math.abs(e.deltaY) < 24) return;
          wheelLock = true;
          show(e.deltaY > 0 ? index + 1 : index - 1);
          setTimeout(() => (wheelLock = false), 550);
        },
        { passive: true }
      );

      // touch swipe
      let touchX = 0;
      document.addEventListener('touchstart', (e) => (touchX = e.touches[0].clientX), { passive: true });
      document.addEventListener(
        'touchend',
        (e) => {
          const dx = e.changedTouches[0].clientX - touchX;
          if (Math.abs(dx) > 50) show(dx < 0 ? index + 1 : index - 1);
        },
        { passive: true }
      );

      // viewport scaler
      const deck = document.getElementById('deck');
      function rescale() {
        if (!deck) return;
        const scale = Math.min(window.innerWidth / 1280, window.innerHeight / 720) * 0.96;
        deck.style.transform = `scale(${scale})`;
      }
      window.addEventListener('resize', rescale);
      rescale();
      const fromHash = parseInt(location.hash.slice(1), 10);
      show(Number.isFinite(fromHash) ? fromHash - 1 : 0);
    </script>
  </body>
