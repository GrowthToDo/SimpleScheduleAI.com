---
import Layout from '~/layouts/PageLayout.astro';
import DemoScheduler from '~/components/demo-scheduler/DemoScheduler.svelte';

const metadata = {
  title: 'Try the Nurse Scheduling Demo',
  description:
    'Build a safe ICU week in under a minute. A free, no-signup interactive demo of explainable nurse scheduling — the same safety rules our scheduling team relies on.',
  // Real conversion asset now (was a "coming soon" waitlist). Index it.
  // NOTE: /simulator is currently excluded from the sitemap in astro.config.ts —
  // remove that exclusion to make it discoverable (see README in the demo build).
  robots: { index: true, follow: true },
};
---

<Layout metadata={metadata}>
  <section class="relative overflow-hidden bg-page">
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute -top-24 left-1/2 h-80 w-[52rem] -translate-x-1/2 rounded-full bg-primary/15 blur-3xl"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-4 pb-12 pt-16 sm:px-6 lg:px-8">
      {/* Server-rendered heading: the island below hydrates lazily, so the page's h1 must ship in HTML. */}
      <header class="mx-auto mb-8 max-w-3xl text-center">
        <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-100 sm:text-4xl">
          Interactive Nurse Scheduling Demo
        </h1>
        <p class="mt-3 text-lg text-slate-600 dark:text-slate-400">
          Watch the AI build a compliant ICU week and rank a callout shortlist. Free, in your browser, no signup.
        </p>
      </header>
      {/* Lazy-hydrated island: engine + UI ship as JS only when scrolled into view. */}
      <DemoScheduler client:visible />
    </div>
  </section>
</Layout>
