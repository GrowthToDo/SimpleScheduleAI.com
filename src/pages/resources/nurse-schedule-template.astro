---
import Layout from '~/layouts/PageLayout.astro';
import SchemaOrg from '~/components/common/SchemaOrg.astro';
import DarkHero from '~/components/widgets/DarkHero.astro';
import Image from '~/components/common/Image.astro';
import gridVisual from '~/assets/images/resources/nurse-schedule-template-grid.webp';

const metadata = {
  title: 'Nurse Schedule Template: Free Excel Download & How to Use It',
  description:
    'Download a free Excel nurse schedule template for small hospitals: census-based staffing targets, 8/10/12-hour shift codes, overtime and rest-hour flags, and a live coverage check. A complete nurse scheduling template, no email required.',
};

// Versioned query so download links bypass every cache layer (Cloudflare edge
// caches /downloads/* for 4h); bump the v= value whenever the template updates.
const fileUrl = '/downloads/SimpleScheduleAI-Nurse-Schedule-Template.xlsx?v=20260721b';

const outputs = [
  [
    'Required staff per day and night',
    'Calculated from your census, HPPD, and RN ratios, so you see the target before you assign anyone.',
  ],
  ['Weekly hours per nurse', 'Totalled automatically from the shift codes you assign.'],
  ['Overtime flag', 'OVER appears when a nurse crosses your weekly overtime threshold.'],
  ['Consecutive-days flag', 'OVER appears when a run of worked days passes your max-consecutive rule.'],
  [
    'Rest-hours flag',
    'SHORT appears when back-to-back shifts leave less rest than your rule. A night shift rolling into a day shift is the classic catch.',
  ],
  ['Leave-conflict flag', 'CHECK appears when the grid has someone working on a day the Leave tab says they are off.'],
  [
    'Coverage gap check',
    'Assigned RNs versus required RNs for every day and night. A positive number means you are short.',
  ],
];

const inputs = [
  ['Staff', 'Your roster: name, role (RN, LPN, CNA), FTE, and skill flags.'],
  ['Units', 'HPPD (nursing hours per patient day), day/night split, and the RN share for each unit.'],
  ['Rules', 'Your overtime threshold, minimum rest hours, max consecutive days, and shift length.'],
  ['Census', 'The patient census per unit for each day of the week.'],
  ['Holidays and Leave', 'Public holidays, plus approved PTO, sick, and vacation days.'],
];

const faqs = [
  {
    q: 'Is the nurse schedule template really free?',
    a: 'Yes. It is a direct Excel download with no email signup and no trial. It is the working model our founder built while studying small-hospital scheduling, cleaned up and documented for general use. Every input cell is open; the formula and branding cells are protected so the checks cannot be broken by an accidental keystroke.',
  },
  {
    q: 'Does the template support 8-hour, 10-hour, and 12-hour shifts?',
    a: 'It ships with 12-hour day and night codes, 8-hour day, evening, and night codes, and two 4-hour part-time codes, each carrying real start and end times. A Shift_Basis setting adjusts the staffing math for 8-hour or 12-hour coverage models. Ten-hour patterns can be added on the Shifts tab in about a minute.',
  },
  {
    q: 'Does the template build the schedule automatically?',
    a: 'No, and no spreadsheet honestly can at this level of constraint. You assign each nurse a shift code from a dropdown; the template then calculates required staffing, hours, overtime, rest-hour and consecutive-day compliance, leave conflicts, and coverage gaps. The judgment stays with your nurse manager.',
  },
  {
    q: 'Will it work in Google Sheets?',
    a: 'It is built and tested for Microsoft Excel. The formulas it uses also exist in Google Sheets, so it generally imports, but the conditional-formatting colors may need re-applying after import. For full fidelity, use Excel.',
  },
  {
    q: 'When does a template stop being enough?',
    a: 'When callouts, fairness tracking, and compliance documentation consume more manager time than the template saves. The template flags problems after you assign; it cannot prevent them, remember them across weeks, or find a qualified replacement at 3 AM. That is the point where hospitals move to a scheduling service or software.',
  },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://simplescheduleai.com' },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Free Nurse Schedule Template',
      item: 'https://simplescheduleai.com/resources/nurse-schedule-template',
    },
  ],
};
---

<Layout metadata={metadata}>
  <SchemaOrg slot="head" schema={[breadcrumbSchema]} />

  <DarkHero
    badge="Free download · Excel · No email required"
    title="Free nurse schedule template for small hospitals"
    subtitle="A weekly Excel scheduling worksheet that calculates required staffing from your census, then flags overtime, rest-hour and consecutive-day violations, leave conflicts, and coverage gaps as you assign shifts."
    actions={[{ text: 'Download the template (.xlsx)', href: fileUrl, variant: 'primary' }]}
  />

  <section class="bg-page">
    <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
      <p class="text-lg leading-relaxed text-default/90">
        Most free nurse schedule templates are a blank grid with days across the top. This one is a working nurse
        scheduling template: it computes how many nurses each day and night shift actually needs from your patient
        census, and it checks the schedule you build against your own overtime, rest, and consecutive-day rules. You
        still make every assignment decision. The template does the math and the checking.
      </p>

      <h2 class="mt-12 font-heading text-2xl font-semibold">What does the template calculate for you?</h2>
      <ul class="mt-5 space-y-3">
        {
          outputs.map(([t, d]) => (
            <li class="flex items-start gap-3">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" />
              <span class="text-default/80">
                <strong class="text-default">{t}.</strong> {d}
              </span>
            </li>
          ))
        }
      </ul>

      <h2 class="mt-12 font-heading text-2xl font-semibold">What do you fill in?</h2>
      <p class="mt-3 text-default/80">
        Five input tabs, all marked with orange cells, plus the schedule grid itself. Shift assignments are manual by
        design: you pick a code (D12, N12, D8, E8, N8, part-time, PTO, and so on) for each nurse each day from a
        dropdown, and the checks recalculate as you go.
      </p>
      <div class="mt-5 overflow-hidden rounded-xl border border-hairline">
        <table class="w-full text-sm">
          <tbody>
            {
              inputs.map(([t, d], i) => (
                <tr class={i % 2 ? 'bg-primary/5' : 'bg-white dark:bg-slate-800'}>
                  <td class="w-40 px-4 py-3 font-semibold">{t}</td>
                  <td class="px-4 py-3 text-default/80">{d}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2 class="mt-12 font-heading text-2xl font-semibold">What does it look like?</h2>
      <p class="mt-3 text-default/80">
        The Schedule tab, from the sample week that ships inside the file. Day shifts are gold, nights slate, off days
        grey. The red flags on the right are computed live from the rules you set: David Jones is over the overtime
        threshold, Sarah Garcia has worked six straight days and is scheduled during her approved vacation, and Chris
        Miller's night shift rolls straight into a day shift with zero rest.
      </p>
      <div class="mt-5 overflow-x-auto rounded-xl border border-hairline bg-white p-2">
        <Image
          src={gridVisual}
          alt="Nurse schedule template Excel Schedule tab showing required staffing rows, shift assignment grid with dropdown codes, and overtime, rest-hour, consecutive-day, and leave-conflict flags"
          class="w-full min-w-[720px]"
          widths={[720, 1200, 1600]}
          sizes="(max-width: 900px) 720px, 1200px"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="mt-10 rounded-2xl border border-primary/40 bg-primary/5 p-8 text-center" id="download">
        <h2 class="font-heading text-2xl font-semibold">Download the template</h2>
        <p class="mx-auto mt-2 max-w-xl text-sm text-muted">
          One .xlsx file, about 23 KB. Sample data included so every output is visible on open; replace it with your own
          roster and rules. Built for Microsoft Excel 2016 or later.
        </p>
        <a href={fileUrl} class="btn btn-primary mt-5">Download the template (.xlsx)</a>
        <p class="mt-3 text-xs text-muted">No email. No signup. Not medical, legal, or compliance advice.</p>
        <p class="mt-2 text-sm text-muted">
          Want the full context first? Read the companion guide:
          <a href="/blog/free-nurse-schedule-templates" class="text-primary underline"
            >free nurse schedule templates, what works and what doesn't</a
          >.
        </p>
      </div>

      <h2 class="mt-12 font-heading text-2xl font-semibold">How do you use the template?</h2>
      <ol class="mt-5 list-decimal space-y-2.5 pl-6 text-default/80">
        <li>Fill the Staff, Units, and Rules tabs with your roster and policies. The sample shows the shape.</li>
        <li>On the Schedule tab, pick your unit and set the week's start date.</li>
        <li>Enter that week's expected census on the Census tab, and any approved leave on the Leave tab.</li>
        <li>
          Assign a shift code to each nurse for each day from the dropdowns, watching the required rows at the top.
        </li>
        <li>Fix what the flags catch: clear the OVER, SHORT, and CHECK cells and bring every coverage gap to zero.</li>
      </ol>

      <h2 class="mt-12 font-heading text-2xl font-semibold">What does the template not do?</h2>
      <p class="mt-3 text-default/80">
        It will not build the schedule for you, match skills to shifts, balance weekend and holiday fairness across
        weeks, or find a qualified, non-overtime replacement when a nurse calls out at 3 AM. Its compliance checks see
        one week at a time. Those limits are not template flaws; they are the honest ceiling of what a spreadsheet can
        do, and pushing past that ceiling is why
        <a href="/nurse-scheduling-software" class="text-primary underline">nurse scheduling software</a> and operated scheduling
        services exist. SimpleScheduleAI is the operated version: the AI builds the schedule against all of these rules at
        once, our scheduling team checks it, and your manager approves it.
        <a href="/how-it-works" class="text-primary underline">See how it works</a>.
      </p>

      <h2 class="mt-12 font-heading text-2xl font-semibold">Frequently asked questions</h2>
      <div class="mt-5 space-y-6">
        {
          faqs.map((f) => (
            <div class="border-t border-ink/10 pt-5">
              <h3 class="font-semibold">{f.q}</h3>
              <p class="mt-2 text-default/80">{f.a}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-14 rounded-xl bg-primary/5 border border-primary/20 px-8 py-10 text-center">
        <p class="text-lg font-semibold text-default mb-2">Rather review a finished schedule than build one?</p>
        <p class="text-muted text-sm mb-6">
          Flat monthly pricing for small Texas hospitals. The AI builds the schedule, our scheduling team checks it, you
          approve it.
        </p>
        <a href="/how-it-works" class="btn btn-primary">See how it works →</a>
        <p class="text-sm text-muted mt-4 mb-0">
          <a href="https://cal.com/gautham-8bdvdx/30min" class="text-primary underline">Book a call with our team →</a>
        </p>
      </div>
    </div>
  </section>
</Layout>
