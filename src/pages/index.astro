---
import Layout from '~/layouts/PageLayout.astro';
import SchemaOrg from '~/components/common/SchemaOrg.astro';
import Hero from '~/components/widgets/Hero.astro';
import HeroStationBackdrop from '~/components/widgets/HeroStationBackdrop.astro';
import PainStrip from '~/components/widgets/PainStrip.astro';
import ServiceFlow from '~/components/widgets/ServiceFlow.astro';
import SoftwareVsService from '~/components/widgets/SoftwareVsService.astro';
import OnboardingStrip from '~/components/widgets/OnboardingStrip.astro';
import BuiltForCAHs from '~/components/widgets/BuiltForCAHs.astro';
import WeeklyPackage from '~/components/widgets/WeeklyPackage.astro';
import OutcomeStrip from '~/components/widgets/OutcomeStrip.astro';
import FounderSection from '~/components/widgets/FounderSection.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'SimpleScheduleAI | Nurse Scheduling for Critical Access Hospitals',
  description:
    'Scheduling stress drives your best nurses out and burns your budget. You get a compliant, post-ready schedule every cycle, callout coverage handled.',
  ignoreTitleTemplate: true,
};

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'SimpleScheduleAI',
  url: 'https://simplescheduleai.com',
};

const softwareAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'SimpleScheduleAI',
  url: 'https://simplescheduleai.com',
  applicationCategory: 'HealthcareApplication',
  operatingSystem: 'Web',
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'USD',
    lowPrice: '1000',
    highPrice: '1500',
    offerCount: '2',
    description: 'Flat monthly price per facility, by roster size',
  },
  provider: { '@id': 'https://simplescheduleai.com/#organization' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How long does it take to get started?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Under two weeks. You send us your staff list and shift structure via Excel. We configure the rules, run a test cycle, and hand you a draft schedule for review. No IT involvement required.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do my nurses need to create accounts or download anything?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "No. Your staff never touches the software. You get a PDF and Excel file by Thursday. That's it.",
      },
    },
    {
      '@type': 'Question',
      name: 'What if we already have a scheduling system?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "We are built to replace spreadsheets or a basic tool that doesn't enforce rules. We don't replace your EMR. We deliver the schedule so you don't have to build it.",
      },
    },
    {
      '@type': 'Question',
      name: 'How do you handle our unit-specific rules?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'We configure them before your first cycle. Charge nurse requirements, skill mix ratios, on-call limits: all mapped to your unit. Changes take effect the next cycle.',
      },
    },
    {
      '@type': 'Question',
      name: "Who do we contact when there's a call-out at 2AM?",
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Log the callout with us and the system generates the top 3 replacement candidates with reasons, checked by our scheduling team. You pick, we update the schedule and send the corrected copy. No phone tree, and we're reachable if something unusual comes up.",
      },
    },
  ],
};
---

<Layout metadata={metadata}>
  <SchemaOrg slot="head" schema={[webSiteSchema, softwareAppSchema, faqSchema]} />
  <!-- Hero Section -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Try the interactive demo',
        href: '/simulator',
      },
      {
        variant: 'secondary',
        text: 'Book a call with our team',
        href: 'https://cal.com/gautham-8bdvdx/30min',
      },
    ]}
  >
    <Fragment slot="bg">
      <HeroStationBackdrop />
    </Fragment>
    <Fragment slot="title">
      Stop Rebuilding the Nurse Schedule <span class="text-primary">Every Sunday Night</span>
    </Fragment>

    <Fragment slot="subtitle">
      AI builds the schedule, our scheduling team checks it, you approve.
    </Fragment>

    <Fragment slot="content">
      <p class="mt-4 text-center text-sm text-muted reveal-delay-3" data-reveal>
        Your nurse manager spends a day and a half every week building the schedule. We give it back.
      </p>
      <div class="mx-auto mt-10 max-w-4xl reveal-delay-4" data-reveal>
        <div
          class="overflow-hidden rounded-2xl border border-hairline bg-ink shadow-[0_14px_40px_-28px_rgb(26_35_50/0.35)]"
        >
          <video
            id="hero-launch-video"
            class="aspect-video w-full"
            src="/videos/ssai-launch-landscape.mp4"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="Product overview video: the AI fills a blank nurse schedule, validates 21 rules, and ranks callout replacements"
          ></video>
        </div>
      </div>
      <script is:inline>
        // Respect prefers-reduced-motion: stop the hero video's autoplay loop.
        (function () {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            const v = document.getElementById('hero-launch-video');
            if (v) {
              v.removeAttribute('autoplay');
              v.removeAttribute('loop');
              v.pause();
            }
          }
        })();
      </script>
      <div
        class="mx-auto mt-9 flex max-w-4xl flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm text-muted reveal-delay-4"
        data-reveal
      >
        <span class="flex items-center gap-2"
          ><span class="h-1.5 w-1.5 rounded-full bg-primary"></span>A human checks every schedule</span
        >
        <span class="flex items-center gap-2"
          ><span class="h-1.5 w-1.5 rounded-full bg-primary"></span>Full audit trail on every change</span
        >
        <span class="flex items-center gap-2"
          ><span class="h-1.5 w-1.5 rounded-full bg-primary"></span>Flat monthly pricing</span
        >
      </div>
    </Fragment>
  </Hero>

  <!-- Pain: why this service exists -->
  <PainStrip />

  <!-- Solve: how the service works end to end -->
  <ServiceFlow />

  <!-- Solve, part 2: the receipt — what actually lands each cycle (moved up to follow the promise) -->
  <WeeklyPackage />

  <!-- Quiet inline CTA #1 (founder-approved: text links, no new banners) -->
  <section class="bg-page">
    <div class="mx-auto max-w-7xl px-4 pb-4 sm:px-6 lg:px-8 text-center">
      <a href="/how-it-works" class="font-medium text-primary underline underline-offset-4"
        >See how a full cycle runs, step by step →</a
      >
    </div>
  </section>

  <!-- Category clarity: software vs service comparison -->
  <SoftwareVsService />

  <!-- Built for CAHs -->
  <BuiltForCAHs />

  <!-- Getting started: onboarding chapter (objection: switching cost) -->
  <OnboardingStrip />

  <!-- Strategic outcome: what the deliverables enable -->
  <OutcomeStrip />

  <!-- Quiet inline CTA #2 -->
  <section class="bg-page">
    <div class="mx-auto max-w-7xl px-4 pb-4 sm:px-6 lg:px-8 text-center">
      <a href="https://cal.com/gautham-8bdvdx/30min" class="font-medium text-primary underline underline-offset-4"
        >Talk it through with our team in 30 minutes →</a
      >
    </div>
  </section>

  <!-- Founder Section -->
  <FounderSection />

  <!-- FAQ -->
  <FAQs
    title="Frequently Asked Questions"
    tagline="Common questions"
    items={[
      {
        title: 'How long does it take to get started?',
        description:
          'Under two weeks. You send us your staff list and shift structure via Excel.<br /><br />We configure the rules, run a test cycle, and hand you a draft schedule for review. No IT involvement required.',
      },
      {
        title: 'Do my nurses need to create accounts or download anything?',
        description: "No. Your staff never touches the software. You get a PDF and Excel file by Thursday. That's it.",
      },
      {
        title: 'What if we already have a scheduling system?',
        description:
          "We are built to replace spreadsheets or a basic tool that doesn't enforce rules. We don't replace your EMR. We deliver the schedule so you don't have to build it.",
      },
      {
        title: 'How do you handle our unit-specific rules?',
        description:
          'We configure them before your first cycle. Charge nurse requirements, skill mix ratios, on-call limits: all mapped to your unit. Changes take effect the next cycle.',
      },
      {
        title: "Who do we contact when there's a call-out at 2AM?",
        description:
          "Log the callout with us and the system generates the top 3 replacement candidates with reasons, checked by our scheduling team.<br /><br />You pick, we update the schedule and send the corrected copy. No phone tree, and we're reachable if something unusual comes up.",
      },
    ]}
  />

  <!-- Call to Action -->
  <CallToAction
    title="A compliant, post-ready schedule every cycle.<br/>Flat monthly pricing."
    subtitle="$1,000 to $1,500 a month, by roster size. No IT setup. No per-nurse fees."
    tagline="Simple pricing"
    actions={[
      {
        variant: 'primary',
        text: 'Get your first schedule',
        href: '/contact',
      },
      {
        variant: 'secondary',
        text: 'Try the interactive demo',
        href: '/simulator',
      },
    ]}
  >
    <Fragment slot="content">
      <ul class="mt-4 space-y-3 text-left">
        <li class="flex items-start gap-3">
          <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-sage"></span>
          <span class="text-lg leading-relaxed text-ivory/85"
            >Your Sunday nights back: the week's schedule arrives done</span
          >
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-sage"></span>
          <span class="text-lg leading-relaxed text-ivory/85"
            >No 5 a.m. phone tree: approved replacement candidates in one click</span
          >
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-sage"></span>
          <span class="text-lg leading-relaxed text-ivory/85"
            >Walk into Monday knowing what changed, the budget impact, and what needs your sign-off</span
          >
        </li>
      </ul>

      <p class="mt-6 text-pretty text-base leading-relaxed text-ivory/65">
        Month to month, flat by roster size. No long-term contract. If your team does not save real scheduling time, you
        walk away.
      </p>
    </Fragment>
  </CallToAction>
</Layout>
