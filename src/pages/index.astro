---
import Layout from '~/layouts/PageLayout.astro';
import SchemaOrg from '~/components/common/SchemaOrg.astro';
import Hero from '~/components/widgets/Hero.astro';
import ProductShowcase from '~/components/widgets/ProductShowcase.astro';
import SoftwareVsService from '~/components/widgets/SoftwareVsService.astro';
import BuiltForCAHs from '~/components/widgets/BuiltForCAHs.astro';
import ScheduleStability from '~/components/widgets/ScheduleStability.astro';
import WeeklyPackage from '~/components/widgets/WeeklyPackage.astro';
import QualityChecks from '~/components/widgets/QualityChecks.astro';
import WeeklyCadence from '~/components/widgets/WeeklyCadence.astro';
import CalloutDetail from '~/components/widgets/CalloutDetail.astro';
import FounderSection from '~/components/widgets/FounderSection.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'SimpleScheduleAI — Nurse Scheduling for Critical Access Hospitals',
  description:
    'Scheduling stress drives your best nurses out and burns your budget. You get a compliant, post-ready schedule every week, callout coverage handled.',
  ignoreTitleTemplate: true,
};

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'SimpleScheduleAI',
  url: 'https://simplescheduleai.com',
};

const softwareAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'SimpleScheduleAI',
  url: 'https://simplescheduleai.com',
  applicationCategory: 'HealthcareApplication',
  operatingSystem: 'Web',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    description: 'Free 60-day pilot for Critical Access Hospitals',
  },
  provider: { '@id': 'https://simplescheduleai.com/#organization' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How long does it take to get started?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Under two weeks. You send us your staff list and shift structure via Excel. We configure the rules, run a test cycle, and hand you a draft schedule for review. No IT involvement required.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do my nurses need to create accounts or download anything?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "No. Your staff never touches the software. You get a PDF and Excel file by Thursday. That's it.",
      },
    },
    {
      '@type': 'Question',
      name: 'What if we already have a scheduling system?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Most of our pilots come from teams using spreadsheets or a basic tool that doesn't enforce rules. We don't replace your EMR. We deliver the schedule so you don't have to build it.",
      },
    },
    {
      '@type': 'Question',
      name: 'How do you handle our unit-specific rules?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'We configure them before your first cycle. Charge nurse requirements, skill mix ratios, on-call limits: all mapped to your unit. Changes take effect the next cycle.',
      },
    },
    {
      '@type': 'Question',
      name: "Who do we contact when there's a call-out at 2AM?",
      acceptedAnswer: {
        '@type': 'Answer',
        text: "The system auto-generates replacement candidates as soon as a call-out is logged. You get the top 3 with reasons. One click to approve. You don't have to call us, but we're reachable if something unusual comes up.",
      },
    },
  ],
};
---

<Layout metadata={metadata}>
  <SchemaOrg slot="head" schema={[webSiteSchema, softwareAppSchema, faqSchema]} />
  <!-- Hero Section -->
  <Hero
    announcement="3 CAH pilot spots open. Full managed service, free for 60 days."
    tagline="For Nurse Managers and DONs in Texas"
    actions={[
      {
        variant: 'primary',
        text: 'Claim a Pilot Spot',
        href: '/contact',
      },
      {
        variant: 'secondary',
        text: 'See How It Works',
        href: '/how-it-works',
      },
    ]}
  >
    <Fragment slot="title">
      Stop Losing Nurses to Scheduling Stress: Nurse Scheduling for Critical Access Hospitals
    </Fragment>

    <Fragment slot="subtitle">
      A managed scheduling service. You send a roster, you get back a finished, compliant schedule. Not software to run.
      No more Sunday evenings rebuilding the roster. No more hunting for a replacement when someone calls out. You get a
      compliant, post-ready schedule every cycle, callout coverage already handled.
    </Fragment>
  </Hero>

  <!-- Front-loaded credibility + offer strip -->
  <section class="bg-page -mt-8 sm:-mt-12">
    <div class="mx-auto max-w-7xl px-4 pb-10 sm:px-6 lg:px-8">
      <div class="flex flex-col items-center gap-3 text-center">
        <div class="flex flex-wrap items-center justify-center gap-2">
          <span
            class="inline-flex items-center gap-x-1.5 rounded-full border border-blue-200 dark:border-blue-800/50 bg-blue-50 dark:bg-blue-900/30 px-3 py-1.5 text-xs font-medium text-blue-700 dark:text-blue-300"
            >Free for 60 Days</span
          >
          <span
            class="inline-flex items-center gap-x-1.5 rounded-full border border-blue-200 dark:border-blue-800/50 bg-blue-50 dark:bg-blue-900/30 px-3 py-1.5 text-xs font-medium text-blue-700 dark:text-blue-300"
            >3 Hospitals Only</span
          >
          <span
            class="inline-flex items-center gap-x-1.5 rounded-full border border-blue-200 dark:border-blue-800/50 bg-blue-50 dark:bg-blue-900/30 px-3 py-1.5 text-xs font-medium text-blue-700 dark:text-blue-300"
            >Full Managed Service</span
          >
          <span
            class="inline-flex items-center gap-x-1.5 rounded-full border border-blue-200 dark:border-blue-800/50 bg-blue-50 dark:bg-blue-900/30 px-3 py-1.5 text-xs font-medium text-blue-700 dark:text-blue-300"
            >No IT Setup</span
          >
          <span
            class="inline-flex items-center gap-x-1.5 rounded-full border border-blue-200 dark:border-blue-800/50 bg-blue-50 dark:bg-blue-900/30 px-3 py-1.5 text-xs font-medium text-blue-700 dark:text-blue-300"
            >First Schedule in Under 2 Weeks</span
          >
        </div>
        <p class="text-sm text-muted">
          Built after interviewing 30+ nurse managers before writing a single line of code.
        </p>
      </div>
    </div>
  </section>

  <!-- Product Interface Showcase -->
  <ProductShowcase />

  <!-- Software vs Service Comparison -->
  <SoftwareVsService />

  <!-- Built for CAHs -->
  <BuiltForCAHs />

  <!-- Schedule Stability -->
  <ScheduleStability />

  <!-- Weekly Package -->
  <WeeklyPackage />

  <!-- Quality Checks -->
  <QualityChecks />

  <!-- Weekly Cadence -->
  <WeeklyCadence />

  <!-- Callout Detail -->
  <CalloutDetail />

  <!-- Founder Section -->
  <FounderSection />

  <!-- FAQ -->
  <FAQs
    title="Frequently Asked Questions"
    tagline="Common questions"
    items={[
      {
        title: 'How long does it take to get started?',
        description:
          'Under two weeks. You send us your staff list and shift structure via Excel. We configure the rules, run a test cycle, and hand you a draft schedule for review. No IT involvement required.',
      },
      {
        title: 'Do my nurses need to create accounts or download anything?',
        description: "No. Your staff never touches the software. You get a PDF and Excel file by Thursday. That's it.",
      },
      {
        title: 'What if we already have a scheduling system?',
        description:
          "Most of our pilots come from teams using spreadsheets or a basic tool that doesn't enforce rules. We don't replace your EMR. We deliver the schedule so you don't have to build it.",
      },
      {
        title: 'How do you handle our unit-specific rules?',
        description:
          'We configure them before your first cycle. Charge nurse requirements, skill mix ratios, on-call limits: all mapped to your unit. Changes take effect the next cycle.',
      },
      {
        title: "Who do we contact when there's a call-out at 2AM?",
        description:
          "The system auto-generates replacement candidates as soon as a call-out is logged. You get the top 3 with reasons. One click to approve. You don't have to call us, but we're reachable if something unusual comes up.",
      },
    ]}
  />

  <!-- Call to Action -->
  <CallToAction
    title="A compliant, post-ready schedule every cycle.<br/>Free for 60 days."
    subtitle="3 pilot spots open. No IT setup. No strings attached."
    tagline="Limited availability"
    actions={[
      {
        variant: 'primary',
        text: 'Claim a Pilot Spot',
        href: '/contact',
      },
    ]}
  >
    <Fragment slot="content">
      <ul class="mt-4 space-y-3 text-left">
        <li class="flex items-start gap-3">
          <span class="mt-1 shrink-0 text-blue-400 dark:text-blue-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"></path>
            </svg>
          </span>
          <span class="text-lg leading-relaxed text-gray-300"
            >Your Sunday nights back: the week's schedule arrives done</span
          >
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-1 shrink-0 text-blue-400 dark:text-blue-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"></path>
            </svg>
          </span>
          <span class="text-lg leading-relaxed text-gray-300"
            >No 5 a.m. phone tree: approved replacement candidates in one click</span
          >
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-1 shrink-0 text-blue-400 dark:text-blue-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"></path>
            </svg>
          </span>
          <span class="text-lg leading-relaxed text-gray-300"
            >Walk into Monday knowing what changed, the budget impact, and what needs your sign-off</span
          >
        </li>
      </ul>

      <p class="mt-6 text-pretty text-base leading-relaxed text-gray-400">
        After 60 days, if your team did not save real scheduling time, we part ways. No invoice. No contract. The pilot
        is entirely at our cost.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-2">
        <span
          class="inline-flex items-center gap-x-1.5 rounded-full border border-blue-800/50 bg-blue-900/30 px-3 py-1.5 text-xs font-medium text-blue-300"
          >Free for 60 Days</span
        >
        <span
          class="inline-flex items-center gap-x-1.5 rounded-full border border-blue-800/50 bg-blue-900/30 px-3 py-1.5 text-xs font-medium text-blue-300"
          >3 Hospitals Only</span
        >
        <span
          class="inline-flex items-center gap-x-1.5 rounded-full border border-blue-800/50 bg-blue-900/30 px-3 py-1.5 text-xs font-medium text-blue-300"
          >Full Managed Service</span
        >
        <span
          class="inline-flex items-center gap-x-1.5 rounded-full border border-blue-800/50 bg-blue-900/30 px-3 py-1.5 text-xs font-medium text-blue-300"
          >No IT Setup</span
        >
        <span
          class="inline-flex items-center gap-x-1.5 rounded-full border border-blue-800/50 bg-blue-900/30 px-3 py-1.5 text-xs font-medium text-blue-300"
          >First Schedule in Under 2 Weeks</span
        >
      </div>
    </Fragment>
  </CallToAction>
</Layout>
