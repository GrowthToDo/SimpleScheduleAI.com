---
import Layout from '~/layouts/PageLayout.astro';
import SchemaOrg from '~/components/common/SchemaOrg.astro';
import Hero from '~/components/widgets/Hero.astro';
import SchedulerDemoSection from '~/components/widgets/SchedulerDemoSection.astro';
import SoftwareVsService from '~/components/widgets/SoftwareVsService.astro';
import BuiltForCAHs from '~/components/widgets/BuiltForCAHs.astro';
import ScheduleStability from '~/components/widgets/ScheduleStability.astro';
import WeeklyPackage from '~/components/widgets/WeeklyPackage.astro';
import QualityChecks from '~/components/widgets/QualityChecks.astro';
import WeeklyCadence from '~/components/widgets/WeeklyCadence.astro';
import CalloutDetail from '~/components/widgets/CalloutDetail.astro';
import FounderSection from '~/components/widgets/FounderSection.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'SimpleScheduleAI | Nurse Scheduling for Critical Access Hospitals',
  description:
    'Scheduling stress drives your best nurses out and burns your budget. You get a compliant, post-ready schedule every cycle, callout coverage handled.',
  ignoreTitleTemplate: true,
};

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'SimpleScheduleAI',
  url: 'https://simplescheduleai.com',
};

const softwareAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'SimpleScheduleAI',
  url: 'https://simplescheduleai.com',
  applicationCategory: 'HealthcareApplication',
  operatingSystem: 'Web',
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'USD',
    lowPrice: '1000',
    highPrice: '1500',
    offerCount: '2',
    description: 'Flat monthly price per facility, by roster size',
  },
  provider: { '@id': 'https://simplescheduleai.com/#organization' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How long does it take to get started?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Under two weeks. You send us your staff list and shift structure via Excel. We configure the rules, run a test cycle, and hand you a draft schedule for review. No IT involvement required.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do my nurses need to create accounts or download anything?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "No. Your staff never touches the software. You get a PDF and Excel file by Thursday. That's it.",
      },
    },
    {
      '@type': 'Question',
      name: 'What if we already have a scheduling system?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "We are built to replace spreadsheets or a basic tool that doesn't enforce rules. We don't replace your EMR. We deliver the schedule so you don't have to build it.",
      },
    },
    {
      '@type': 'Question',
      name: 'How do you handle our unit-specific rules?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'We configure them before your first cycle. Charge nurse requirements, skill mix ratios, on-call limits: all mapped to your unit. Changes take effect the next cycle.',
      },
    },
    {
      '@type': 'Question',
      name: "Who do we contact when there's a call-out at 2AM?",
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Log the callout with us and the system generates the top 3 replacement candidates with reasons, checked by our scheduling team. You pick, we update the schedule and send the corrected copy. No phone tree, and we're reachable if something unusual comes up.",
      },
    },
  ],
};
---

<Layout metadata={metadata}>
  <SchemaOrg slot="head" schema={[webSiteSchema, softwareAppSchema, faqSchema]} />
  <!-- Hero Section -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Get your first schedule',
        href: '/contact',
      },
      {
        variant: 'secondary',
        text: 'Book a call with our team',
        href: 'https://cal.com/gautham-8bdvdx/30min',
      },
    ]}
  >
    <Fragment slot="title"> Stop Losing Nurses to <span class="italic">Scheduling Stress</span> </Fragment>

    <Fragment slot="subtitle">
      An AI-native nurse scheduling service for Texas Critical Access Hospitals. AI builds your schedule, our scheduling
      team checks it, you approve. No IT.
    </Fragment>
  </Hero>

  <!-- Front-loaded credibility + offer strip -->
  <section class="bg-page -mt-8 sm:-mt-12">
    <div class="mx-auto max-w-7xl px-4 pb-10 sm:px-6 lg:px-8">
      <div class="flex flex-col items-center gap-3 text-center">
        <p class="text-xs font-medium uppercase tracking-[0.18em] text-primary">
          Texas Critical Access Hospitals · No IT Setup · First Schedule in Under 2 Weeks
        </p>
        <p class="text-sm text-muted">
          Built after interviewing 30+ nurse managers before writing a single line of code.
        </p>
      </div>
    </div>
  </section>

  <!-- Scheduler Demo Widget (animated end-to-end demo + AI engine pitch) -->
  <SchedulerDemoSection />

  <!-- Software vs Service Comparison -->
  <SoftwareVsService />

  <!-- Built for CAHs -->
  <BuiltForCAHs />

  <!-- Schedule Stability -->
  <ScheduleStability />

  <!-- Weekly Package -->
  <WeeklyPackage />

  <!-- Quality Checks -->
  <QualityChecks />

  <!-- Weekly Cadence -->
  <WeeklyCadence />

  <!-- Callout Detail -->
  <CalloutDetail />

  <!-- Founder Section -->
  <FounderSection />

  <!-- FAQ -->
  <FAQs
    title="Frequently Asked Questions"
    tagline="Common questions"
    items={[
      {
        title: 'How long does it take to get started?',
        description:
          'Under two weeks. You send us your staff list and shift structure via Excel. We configure the rules, run a test cycle, and hand you a draft schedule for review. No IT involvement required.',
      },
      {
        title: 'Do my nurses need to create accounts or download anything?',
        description: "No. Your staff never touches the software. You get a PDF and Excel file by Thursday. That's it.",
      },
      {
        title: 'What if we already have a scheduling system?',
        description:
          "We are built to replace spreadsheets or a basic tool that doesn't enforce rules. We don't replace your EMR. We deliver the schedule so you don't have to build it.",
      },
      {
        title: 'How do you handle our unit-specific rules?',
        description:
          'We configure them before your first cycle. Charge nurse requirements, skill mix ratios, on-call limits: all mapped to your unit. Changes take effect the next cycle.',
      },
      {
        title: "Who do we contact when there's a call-out at 2AM?",
        description:
          "Log the callout with us and the system generates the top 3 replacement candidates with reasons, checked by our scheduling team. You pick, we update the schedule and send the corrected copy. No phone tree, and we're reachable if something unusual comes up.",
      },
    ]}
  />

  <!-- Call to Action -->
  <CallToAction
    title="A compliant, post-ready schedule every cycle.<br/>Flat monthly pricing."
    subtitle="$1,000 to $1,500 a month, by roster size. No IT setup. No per-nurse fees."
    tagline="Simple pricing"
    actions={[
      {
        variant: 'primary',
        text: 'Get your first schedule',
        href: '/contact',
      },
    ]}
  >
    <Fragment slot="content">
      <ul class="mt-4 space-y-3 text-left">
        <li class="flex items-start gap-3">
          <span class="mt-1 shrink-0 text-[#7BAF9B]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"></path>
            </svg>
          </span>
          <span class="text-lg leading-relaxed text-[#FAF7F2]/85"
            >Your Sunday nights back: the week's schedule arrives done</span
          >
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-1 shrink-0 text-[#7BAF9B]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"></path>
            </svg>
          </span>
          <span class="text-lg leading-relaxed text-[#FAF7F2]/85"
            >No 5 a.m. phone tree: approved replacement candidates in one click</span
          >
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-1 shrink-0 text-[#7BAF9B]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"></path>
            </svg>
          </span>
          <span class="text-lg leading-relaxed text-[#FAF7F2]/85"
            >Walk into Monday knowing what changed, the budget impact, and what needs your sign-off</span
          >
        </li>
      </ul>

      <p class="mt-6 text-pretty text-base leading-relaxed text-[#FAF7F2]/65">
        Month to month, flat by roster size. No long-term contract. If your team does not save real scheduling time, you
        walk away.
      </p>

      <p class="mt-8 text-center text-xs font-medium uppercase tracking-[0.18em] text-[#7BAF9B]">
        Flat Monthly Price · No Per-Nurse Fees · No IT Setup
      </p>
    </Fragment>
  </CallToAction>
</Layout>
