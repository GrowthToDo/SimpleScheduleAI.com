---
import Layout from '~/layouts/PageLayout.astro';
import SchemaOrg from '~/components/common/SchemaOrg.astro';
import DarkHero from '~/components/widgets/DarkHero.astro';

const metadata = {
  title: 'About',
  description:
    'Assisted nurse scheduling for Critical Access Hospitals in Texas. We reduce scheduling load while your team keeps tools, control, and final approval.',
};

const stats = [
  { label: 'Built for', value: 'Critical Access Hospitals in Texas' },
  { label: 'Works with', value: 'Excel and your current format' },
  { label: 'Designed for', value: 'Nurse managers and leadership' },
  { label: 'Approach', value: 'Assisted, not replacement' },
];

const principles = [
  {
    title: 'You keep control',
    description:
      'Your team owns the rules, the exceptions, and the final approval. We support the work, you decide what goes live.',
  },
  {
    title: 'Fits your current workflow',
    description:
      'No new software rollout. No training burden. We work with the format you already use, including Excel.',
  },
  {
    title: 'Clear handoffs',
    description:
      'You get a review ready schedule, notes on conflicts and assumptions, and a simple validation summary for quick sign off.',
  },
];

const whatWeDo = [
  'A draft schedule built to your rules, so you start from done not blank',
  'Coverage, gaps, and conflicts caught before you ever see them',
  'A clean, review-ready version you can approve in minutes',
];

const whatWeDoNotDo = [
  'We do not publish schedules without your approval',
  'We do not change your policies or override your leadership',
  'We do not replace your staff or act as your HR system',
];

const ctaLink = 'https://cal.com/gautham-8bdvdx/30min';

const aboutBreadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://simplescheduleai.com' },
    { '@type': 'ListItem', position: 2, name: 'About', item: 'https://simplescheduleai.com/about' },
  ],
};
---

<Layout metadata={metadata}>
  <SchemaOrg slot="head" schema={[aboutBreadcrumbSchema]} />
  <!-- Dark Hero -->
  <DarkHero
    badge="About Us"
    title="Built for hospitals where the schedule never stops: a managed nurse-scheduling service for Critical Access Hospitals in Texas"
    subtitle={metadata.description}
    actions={[
      { text: 'See how it works', href: '/how-it-works', variant: 'primary' },
      { text: 'Book a call', href: ctaLink, variant: 'secondary' },
    ]}
  />

  <!-- Stats -->
  <section class="bg-page">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
      <dl class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          stats.map((stat) => (
            <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-slate-800 p-6">
              <dt class="text-xs font-semibold uppercase tracking-widest text-primary">{stat.label}</dt>
              <dd class="mt-3 text-lg font-semibold">{stat.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Why CAHs -->
  <section class="bg-page">
    <div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28 text-center">
      <p class="mb-4 text-xs font-semibold uppercase tracking-widest text-primary">Why this is built for you</p>
      <h2 class="text-balance text-3xl font-bold tracking-tight sm:text-4xl">
        Why Critical Access Hospitals specifically
      </h2>
      <p class="mt-6 text-lg text-muted">
        Most scheduling software was built for 500-nurse hospital systems and scaled down. We started with the 20-bed
        hospital and built up. The nurse manager at a Critical Access Hospital is also the charge nurse, the compliance
        officer, and the person who picks up the phone at 5 AM when someone calls out. She does not have time to learn
        enterprise software or wait on a support ticket queue. That is the operating reality we designed for. Every hour
        she loses to the phone tree is an hour off the floor, and the nurses notice who landed nights again. That is how
        good nurses start leaving.
      </p>
    </div>
  </section>

  <!-- Principles -->
  <section class="bg-gray-50 dark:bg-slate-900">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <p class="mb-4 text-xs font-semibold uppercase tracking-widest text-primary">How this works</p>
        <h2 class="text-balance text-3xl font-bold tracking-tight sm:text-4xl">How this works for you</h2>
        <p class="mt-4 text-lg text-muted">This is a workflow support service, not a software rollout.</p>
      </div>

      <div class="grid gap-6 lg:grid-cols-3">
        {
          principles.map((p) => (
            <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-800 p-7 shadow-sm">
              <h3 class="text-lg font-semibold">{p.title}</h3>
              <p class="mt-3 text-default">{p.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- What we do / do not do -->
  <section class="bg-page">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <p class="mb-4 text-xs font-semibold uppercase tracking-widest text-primary">Scope of service</p>
        <h2 class="text-balance text-3xl font-bold tracking-tight sm:text-4xl">Clear boundaries, by design</h2>
      </div>
      <div class="mx-auto max-w-6xl grid gap-6 lg:grid-cols-2">
        <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-slate-800 p-7">
          <h3 class="text-xl font-semibold">What you get</h3>
          <ul class="mt-4 space-y-3">
            {
              whatWeDo.map((item) => (
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 w-1.5 h-1.5 shrink-0 rounded-full bg-primary" />
                  <span class="text-default">{item}</span>
                </li>
              ))
            }
          </ul>
          <p class="mt-5 text-sm text-muted">You review and approve. Nothing is final until your team signs off.</p>
        </div>

        <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-slate-800 p-7">
          <h3 class="text-xl font-semibold">What never happens without you</h3>
          <ul class="mt-4 space-y-3">
            {
              whatWeDoNotDo.map((item) => (
                <li class="flex items-start gap-3">
                  <span class="mt-1.5 w-1.5 h-1.5 shrink-0 rounded-full bg-gray-400" />
                  <span class="text-default">{item}</span>
                </li>
              ))
            }
          </ul>
          <p class="mt-5 text-sm text-muted">
            We say no to these on purpose. You should know exactly what you are getting, and what you are not.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Founders -->
  <section class="bg-gray-50 dark:bg-slate-900">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <p class="mb-4 text-xs font-semibold uppercase tracking-widest text-primary">The team</p>
        <h2 class="text-balance text-3xl font-bold tracking-tight sm:text-4xl">
          Built by people who have been inside hospital ops
        </h2>
        <p class="mt-4 text-lg text-muted">We interviewed 30+ nurse managers before writing a single line of code.</p>
      </div>
      <div class="flex flex-col items-center justify-center gap-12 sm:flex-row sm:items-start sm:gap-20">
        <div class="flex max-w-xs flex-col items-center text-center">
          <a href="/about/pradeep-pandey">
            <img
              src="/founders/pradeep.webp"
              alt="Pradeep Pandey, Co-founder of SimpleScheduleAI"
              class="h-24 w-24 rounded-full object-cover ring-4 ring-blue-100 dark:ring-blue-900"
              loading="lazy"
              decoding="async"
              width="96"
              height="96"
            />
          </a>
          <h3 class="mt-5 text-lg font-bold">
            <a href="/about/pradeep-pandey" class="hover:text-primary transition-colors">Pradeep Pandey</a>
          </h3>
          <p class="text-sm font-semibold text-primary">Co-founder</p>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            Deputy General Manager of Operations, Apollo Hospitals. 7 years in hospital ops across 2,000+ beds.
          </p>
          <a href="/about/pradeep-pandey" class="mt-3 text-sm text-blue-600 dark:text-blue-400 hover:underline"
            >View profile &rarr;</a
          >
        </div>
        <div class="flex max-w-xs flex-col items-center text-center">
          <img
            src="/founders/gautham.png"
            alt="Gautham, Co-founder of SimpleScheduleAI"
            class="h-24 w-24 rounded-full object-cover ring-4 ring-blue-100 dark:ring-blue-900"
            loading="lazy"
            decoding="async"
            width="96"
            height="96"
          />
          <h3 class="mt-5 text-lg font-bold">Gautham</h3>
          <p class="text-sm font-semibold text-primary">Co-founder</p>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            3x founder, 15 years in tech. Built the system so it works without your nurses touching any software.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Dark CTA -->
  <section class="bg-slate-950 dark:bg-black">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
      <div class="mx-auto max-w-3xl text-center">
        <p class="mb-4 text-xs font-semibold uppercase tracking-widest text-blue-400">Low risk. No obligation.</p>
        <h2 class="text-balance text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Want to sanity check fit before anything else?
        </h2>
        <p class="mt-5 text-lg text-gray-400">
          If scheduling is draining time and attention, the pilot is a practical way to see if assisted scheduling works
          for your unit.
        </p>
        <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
          <a href="/pilot" class="btn btn-primary"> View the pilot </a>
          <a href={ctaLink} class="btn text-white border-white/30 hover:bg-white/10 hover:border-white">
            Book a call
          </a>
        </div>
        <p class="mt-6 text-sm text-gray-500">Simple process. Clear handoffs. Your final approval.</p>
      </div>
    </div>
  </section>
</Layout>
