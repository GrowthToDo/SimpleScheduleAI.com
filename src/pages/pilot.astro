---
import Layout from '~/layouts/PageLayout.astro';
import SchemaOrg from '~/components/common/SchemaOrg.astro';
import DarkHero from '~/components/widgets/DarkHero.astro';

const metadata = {
  title: 'The Pilot',
  description:
    'A 60-day pilot of our AI-native nurse scheduling service for Critical Access Hospitals in Texas. AI builds, our scheduling team checks, you approve. Billed at the flat monthly rate from day one.',
};

const ctaLink = 'https://cal.com/gautham-8bdvdx/30min';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'SimpleScheduleAI Nurse Scheduling Pilot',
  description:
    'AI-native nurse scheduling service for Critical Access Hospitals in Texas. A short pilot on your own roster, then a flat monthly price by roster size.',
  provider: { '@id': 'https://simplescheduleai.com/#organization' },
  serviceType: 'Nurse Scheduling',
  areaServed: { '@type': 'State', name: 'Texas' },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'USD',
    lowPrice: '1000',
    highPrice: '1500',
    offerCount: '2',
    description: 'Flat monthly price per facility, by roster size',
  },
};

const pilotBreadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://simplescheduleai.com' },
    { '@type': 'ListItem', position: 2, name: 'The Pilot', item: 'https://simplescheduleai.com/pilot' },
  ],
};

const pilotFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What does the pilot include?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The pilot runs our AI-native nurse scheduling service on your own roster. It includes complete onboarding support, AI-generated nurse schedules for every scheduling cycle, callout replacement shortlists, Texas compliance tracking, and a dedicated account contact.',
      },
    },
    {
      '@type': 'Question',
      name: 'What happens after the pilot?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'At day 60 we review the results together: time saved, overtime, compliance. If it is working, nothing changes and you continue on the same plan. If not, you cancel and walk away. There is no conversion step and no price change.',
      },
    },
    {
      '@type': 'Question',
      name: 'How quickly can we start?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Onboarding takes 3 to 5 business days. We onboard a limited number of hospitals at a time so each one gets hands-on setup and a first schedule within two weeks.',
      },
    },
    {
      '@type': 'Question',
      name: 'What does onboarding look like?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Onboarding typically takes 3 to 5 business days. You upload your existing nurse roster via Excel, our team configures your shift rules and Texas compliance requirements, and we deliver your first AI-generated schedule for review. No IT integration or technical setup is required.',
      },
    },
    {
      '@type': 'Question',
      name: 'What does the service cost?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'A flat monthly price per facility by roster size: $1,000 per month for up to 20 nurses, $1,500 for 21 to 40. The pilot is billed at the same rate from day one; there is no separate pilot fee, no per-nurse fees, no setup fees, and no long-term contract.',
      },
    },
  ],
};
---

<Layout metadata={metadata}>
  <SchemaOrg slot="head" schema={[serviceSchema, pilotBreadcrumbSchema, pilotFaqSchema]} />
  <!-- Dark Hero -->
  <DarkHero
    badge="Flat monthly price. No IT setup."
    title="Start with a pilot on your own roster"
    subtitle="See what scheduling looks like when you are not building it from scratch. You keep full control. No IT setup. Billed at the same flat monthly rate from day one, cancel anytime."
    actions={[
      { text: 'Get your first schedule', href: '/contact', variant: 'primary' },
      { text: 'Book a call with our team', href: ctaLink, variant: 'secondary' },
    ]}
  />

  <!-- Who this is for -->
  <section class="bg-page">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-start">
        <div>
          <p class="mb-4 text-xs font-semibold uppercase tracking-widest text-primary">Who this is for</p>
          <h2 class="text-balance text-3xl font-bold tracking-tight sm:text-4xl">
            Built for Nurse Managers and DONs drowning in the schedule
          </h2>
          <p class="mt-5 text-lg text-muted">This pilot is a good fit if your hospital:</p>
          <ul class="mt-6 space-y-4">
            <li class="flex items-start gap-3">
              <span class="mt-1.5 w-1.5 h-1.5 shrink-0 rounded-full bg-primary"></span>
              <span class="text-default">Manages nurse schedules primarily in Excel or similar tools</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1.5 w-1.5 h-1.5 shrink-0 rounded-full bg-primary"></span>
              <span class="text-default"
                >Spends significant time fixing coverage gaps, overtime, and fairness complaints</span
              >
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1.5 w-1.5 h-1.5 shrink-0 rounded-full bg-primary"></span>
              <span class="text-default">Needs a more predictable and review-ready scheduling process</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1.5 w-1.5 h-1.5 shrink-0 rounded-full bg-primary"></span>
              <span class="text-default">Wants support without adding new software or training burden for staff</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1.5 w-1.5 h-1.5 shrink-0 rounded-full bg-primary"></span>
              <span class="text-default"
                >Has tried scheduling software before and found it was not built for your size</span
              >
            </li>
          </ul>
          <p class="mt-6 text-muted">
            If scheduling already runs smoothly with minimal effort, this pilot may not be necessary. We will tell you
            quickly if you are not a fit.
          </p>
        </div>

        <div class="space-y-8 lg:pl-12 lg:border-l lg:border-ink/10">
          <div>
            <h3 class="mb-4 text-sm font-semibold uppercase tracking-[0.14em] text-muted">You provide</h3>
            <ul class="divide-y divide-ink/10 border-t border-ink/10">
              <li class="py-3 leading-relaxed text-default/80">Staff availability and coverage requirements</li>
              <li class="py-3 leading-relaxed text-default/80">Your existing scheduling rules and preferences</li>
              <li class="py-3 leading-relaxed text-default/80">Context around constraints and edge cases</li>
            </ul>
          </div>
          <div>
            <h3 class="mb-4 text-sm font-semibold uppercase tracking-[0.14em] text-primary">Handled for you</h3>
            <ul class="divide-y divide-ink/10 border-t border-ink/10">
              <li class="py-3 leading-relaxed text-default">
                The draft schedule built every cycle, so you never start from blank
              </li>
              <li class="py-3 leading-relaxed text-default">
                Coverage, conflicts, and compliance violations caught before you see it
              </li>
              <li class="py-3 leading-relaxed text-default">
                A post-ready schedule in your inbox every Thursday, ready to post
              </li>
            </ul>
          </div>
          <div>
            <h3 class="mb-4 text-sm font-semibold uppercase tracking-[0.14em] text-muted">You retain</h3>
            <ul class="divide-y divide-ink/10 border-t border-ink/10">
              <li class="py-3 leading-relaxed text-default/80">Full authority over the schedule</li>
              <li class="py-3 leading-relaxed text-default/80">Final approval before anything posts</li>
              <li class="py-3 leading-relaxed text-default/80">The ability to modify or reject anything at any time</li>
            </ul>
            <p class="mt-4 text-sm text-muted">Nothing goes live without your sign-off.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How the pilot works -->
  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
      <div class="mx-auto max-w-3xl text-center">
        <p class="mb-4 text-xs font-semibold uppercase tracking-widest text-primary">How it works</p>
        <h2 class="text-balance text-3xl font-bold tracking-tight sm:text-4xl">
          Onboarding in days. Three steps. Zero surprises.
        </h2>
      </div>

      <div class="mx-auto mt-14 max-w-3xl space-y-8">
        <div class="flex items-start gap-6 border-b border-gray-200 dark:border-gray-700 pb-8">
          <span class="w-12 shrink-0 font-heading text-4xl font-semibold leading-none text-primary/40">01</span>
          <div>
            <h3 class="text-xl font-semibold">Initial setup: days 1 to 5</h3>
            <p class="mt-3 text-muted">
              We learn how scheduling currently works in your hospital, including rules, constraints, and pain points.
              You send us your staff roster and we configure everything.
            </p>
          </div>
        </div>
        <div class="flex items-start gap-6 border-b border-gray-200 dark:border-gray-700 pb-8">
          <span class="w-12 shrink-0 font-heading text-4xl font-semibold leading-none text-primary/40">02</span>
          <div>
            <h3 class="text-xl font-semibold">Weekly delivery: week 2 onward</h3>
            <p class="mt-3 text-muted">
              Spend 10 to 15 minutes sending your inputs. Get back a compliant, post-ready schedule every Thursday 3pm,
              nothing left for you to rebuild.
            </p>
          </div>
        </div>
        <div class="flex items-start gap-6">
          <span class="w-12 shrink-0 font-heading text-4xl font-semibold leading-none text-primary/40">03</span>
          <div>
            <h3 class="text-xl font-semibold">Strategic review: Day 60</h3>
            <p class="mt-3 text-muted">
              We sit down for a strategic review: what changed, what the numbers show, and where you want to take it. If
              it is working, nothing changes: you continue on the same flat monthly plan. If not, cancel and walk away.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Cost and obligation -->
  <section class="bg-[#1A2332] dark:bg-black">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
      <div class="grid gap-12 lg:grid-cols-2">
        <div>
          <p class="mb-4 text-xs font-semibold uppercase tracking-widest text-[#7BAF9B]">Transparency</p>
          <h2 class="text-balance text-3xl font-bold tracking-tight text-white sm:text-4xl">What this pilot is not</h2>
          <ul class="mt-8 space-y-4">
            <li class="flex items-start gap-3">
              <span class="mt-1.5 w-1.5 h-1.5 shrink-0 rounded-full bg-gray-500"></span>
              <span class="text-gray-300">A software rollout or EMR replacement</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1.5 w-1.5 h-1.5 shrink-0 rounded-full bg-gray-500"></span>
              <span class="text-gray-300">An automation experiment your nurses have to learn</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1.5 w-1.5 h-1.5 shrink-0 rounded-full bg-gray-500"></span>
              <span class="text-gray-300">A replacement for your existing staff or manager</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1.5 w-1.5 h-1.5 shrink-0 rounded-full bg-gray-500"></span>
              <span class="text-gray-300">A long-term commitment or surprise invoice</span>
            </li>
          </ul>
          <p class="mt-6 text-gray-400">
            It is a structured collaboration to see whether the service reduces effort and stress for your team.
          </p>
        </div>

        <div class="lg:border-l lg:border-white/10 lg:pl-12">
          <h2 class="font-heading text-2xl font-semibold text-white">Pricing and obligation</h2>
          <p class="mt-4 text-gray-300">
            Flat monthly price by roster size: $1,000 up to 20 nurses, $1,500 for 21 to 40. The pilot is billed at the
            same rate from day one.
          </p>
          <p class="mt-4 text-gray-300">
            No per-nurse fees, no setup fees, and no long-term contract to start. If it does not deliver value, you walk
            away.
          </p>
          <p class="mt-4 text-gray-300">
            See full pricing on the <a href="/pricing" class="text-[#7BAF9B] underline">pricing page</a>. You will know
            within a few weeks whether this is right for your unit.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="/pricing" class="btn btn-primary sm:mb-0"> See pricing </a>
            <a href={ctaLink} class="btn text-white border-white/30 hover:bg-white/10 hover:border-white">
              Book a call with our team
            </a>
          </div>
          <p class="mt-6 text-xs font-medium uppercase tracking-[0.18em] text-[#7BAF9B]">
            Flat monthly price · No per-nurse fees · No IT setup
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
