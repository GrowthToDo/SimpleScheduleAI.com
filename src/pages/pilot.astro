---
import Layout from '~/layouts/PageLayout.astro';
import SchemaOrg from '~/components/common/SchemaOrg.astro';
import DarkHero from '~/components/widgets/DarkHero.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'The Pilot',
  description:
    'A short, structured pilot for Critical Access Hospitals in Texas. Assisted nurse scheduling that reduces scheduling load while keeping full control and final approval with your team.',
};

const ctaLink = 'https://cal.com/gautham-8bdvdx/30min';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'SimpleScheduleAI Nurse Scheduling Pilot',
  description:
    'Managed nurse scheduling service for Critical Access Hospitals in Texas. 60-day free pilot includes AI-generated schedules, callout coverage, and Texas compliance tracking.',
  provider: { '@id': 'https://simplescheduleai.com/#organization' },
  serviceType: 'Nurse Scheduling',
  areaServed: { '@type': 'State', name: 'Texas' },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    description: 'Free 60-day pilot for Critical Access Hospitals in Texas',
    availability: 'https://schema.org/LimitedAvailability',
  },
};

const pilotBreadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://simplescheduleai.com' },
    { '@type': 'ListItem', position: 2, name: 'The Pilot', item: 'https://simplescheduleai.com/pilot' },
  ],
};

const pilotFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What does the 60-day pilot include?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The 60-day pilot is a fully managed service at no cost. It includes complete onboarding support, AI-generated nurse schedules for every scheduling cycle, callout replacement shortlists, Texas compliance tracking, and a dedicated account contact throughout the pilot period.',
      },
    },
    {
      '@type': 'Question',
      name: 'What happens after the pilot ends?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "After the 60-day pilot, you can continue as a paid managed service customer. We review the pilot results together, including time saved, overtime reductions, and any compliance improvements, before discussing ongoing pricing tailored to your hospital's size and needs.",
      },
    },
    {
      '@type': 'Question',
      name: 'How many pilot spots are available?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'We currently have 3 pilot spots open for critical access hospitals in Texas. Spots are limited to ensure each pilot hospital receives dedicated onboarding support and hands-on account management during the trial period.',
      },
    },
    {
      '@type': 'Question',
      name: 'What does onboarding look like?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Onboarding typically takes 3–5 business days. You upload your existing nurse roster via Excel, our team configures your shift rules and Texas compliance requirements, and we deliver your first AI-generated schedule for review. No IT integration or technical setup is required.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is there any cost during the pilot?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. The 60-day pilot is completely free. There are no setup fees, no subscription charges, and no commitment required. The pilot exists so you can evaluate real results, including overtime reduction, time saved, and coverage improvements, before making any financial decision.',
      },
    },
  ],
};
---

<Layout metadata={metadata}>
  <SchemaOrg slot="head" schema={[serviceSchema, pilotBreadcrumbSchema, pilotFaqSchema]} />
  <!-- Dark Hero -->
  <DarkHero
    badge="3 spots open. Free for 60 days."
    title="The Pilot Program: a free 60-day managed schedule for your Critical Access Hospital"
    subtitle="See what scheduling looks like when you are not building it from scratch. You keep full control. Free for 60 days. No IT setup. No obligation."
    actions={[
      { text: 'Get a Free Schedule Review', href: '/contact', variant: 'primary' },
      { text: 'Book a call with our team', href: ctaLink, variant: 'secondary' },
    ]}
  />

  <!-- Who this is for -->
  <section class="bg-page">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-start">
        <div>
          <p class="mb-4 text-xs font-semibold uppercase tracking-widest text-primary">Who this is for</p>
          <h2 class="text-balance text-3xl font-bold tracking-tight sm:text-4xl">
            Built for Nurse Managers and DONs drowning in the schedule
          </h2>
          <p class="mt-5 text-lg text-muted">This pilot is a good fit if your hospital:</p>
          <ul class="mt-6 space-y-4">
            <li class="flex items-start gap-3">
              <span class="mt-1.5 w-1.5 h-1.5 shrink-0 rounded-full bg-primary"></span>
              <span class="text-default">Manages nurse schedules primarily in Excel or similar tools</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1.5 w-1.5 h-1.5 shrink-0 rounded-full bg-primary"></span>
              <span class="text-default"
                >Spends significant time fixing coverage gaps, overtime, and fairness complaints</span
              >
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1.5 w-1.5 h-1.5 shrink-0 rounded-full bg-primary"></span>
              <span class="text-default">Needs a more predictable and review-ready scheduling process</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1.5 w-1.5 h-1.5 shrink-0 rounded-full bg-primary"></span>
              <span class="text-default">Wants support without adding new software or training burden for staff</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1.5 w-1.5 h-1.5 shrink-0 rounded-full bg-primary"></span>
              <span class="text-default"
                >Has tried scheduling software before and found it was not built for your size</span
              >
            </li>
          </ul>
          <p class="mt-6 text-muted">
            If scheduling already runs smoothly with minimal effort, this pilot may not be necessary. We will tell you
            quickly if you are not a fit.
          </p>
        </div>

        <div class="space-y-6">
          <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-slate-800 p-7">
            <h3 class="font-bold">You provide</h3>
            <ul class="mt-4 space-y-3">
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-1.5 h-1.5 shrink-0 rounded-full bg-primary"></span>
                <span class="text-default">Staff availability and coverage requirements</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-1.5 h-1.5 shrink-0 rounded-full bg-primary"></span>
                <span class="text-default">Your existing scheduling rules and preferences</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-1.5 h-1.5 shrink-0 rounded-full bg-primary"></span>
                <span class="text-default">Context around constraints and edge cases</span>
              </li>
            </ul>
          </div>
          <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-slate-800 p-7">
            <h3 class="font-bold">Handled for you</h3>
            <ul class="mt-4 space-y-3">
              <li class="flex items-start gap-3">
                <Icon name="tabler:check" class="w-5 h-5 text-primary mt-1 shrink-0" />
                <span class="text-default">The draft schedule built every cycle, so you never start from blank</span>
              </li>
              <li class="flex items-start gap-3">
                <Icon name="tabler:check" class="w-5 h-5 text-primary mt-1 shrink-0" />
                <span class="text-default">Coverage, conflicts, and compliance violations caught before you see it</span
                >
              </li>
              <li class="flex items-start gap-3">
                <Icon name="tabler:check" class="w-5 h-5 text-primary mt-1 shrink-0" />
                <span class="text-default">A post-ready schedule in your inbox every Thursday, ready to post</span>
              </li>
            </ul>
          </div>
          <div class="rounded-2xl border-2 border-primary bg-blue-50 dark:bg-blue-950/30 p-7">
            <h3 class="font-bold">You retain</h3>
            <ul class="mt-4 space-y-3">
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-1.5 h-1.5 shrink-0 rounded-full bg-primary"></span>
                <span class="text-default">Full authority over the schedule</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-1.5 h-1.5 shrink-0 rounded-full bg-primary"></span>
                <span class="text-default">Final approval before anything posts</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="mt-1.5 w-1.5 h-1.5 shrink-0 rounded-full bg-primary"></span>
                <span class="text-default">The ability to modify or reject anything at any time</span>
              </li>
            </ul>
            <p class="mt-4 text-sm text-muted">Nothing goes live without your sign-off.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How the pilot works -->
  <section class="bg-gray-50 dark:bg-slate-900">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
      <div class="mx-auto max-w-3xl text-center">
        <p class="mb-4 text-xs font-semibold uppercase tracking-widest text-primary">How it works</p>
        <h2 class="text-balance text-3xl font-bold tracking-tight sm:text-4xl">
          60 days. Three steps. Zero surprises.
        </h2>
      </div>

      <div class="mx-auto mt-14 max-w-3xl space-y-8">
        <div class="flex items-start gap-6 border-b border-gray-200 dark:border-gray-700 pb-8">
          <span
            class="flex w-16 h-16 shrink-0 items-center justify-center rounded-xl bg-primary text-2xl font-bold text-white"
            >01</span
          >
          <div>
            <h3 class="text-xl font-semibold">Initial setup: Week 1</h3>
            <p class="mt-3 text-muted">
              We learn how scheduling currently works in your hospital, including rules, constraints, and pain points.
              You send us your staff roster and we configure everything.
            </p>
          </div>
        </div>
        <div class="flex items-start gap-6 border-b border-gray-200 dark:border-gray-700 pb-8">
          <span
            class="flex w-16 h-16 shrink-0 items-center justify-center rounded-xl bg-primary text-2xl font-bold text-white"
            >02</span
          >
          <div>
            <h3 class="text-xl font-semibold">Weekly delivery cadence: Weeks 2 to 8</h3>
            <p class="mt-3 text-muted">
              Spend 10 to 15 minutes sending your inputs. Get back a compliant, post-ready schedule every Thursday 3pm,
              nothing left for you to rebuild.
            </p>
          </div>
        </div>
        <div class="flex items-start gap-6">
          <span
            class="flex w-16 h-16 shrink-0 items-center justify-center rounded-xl bg-primary text-2xl font-bold text-white"
            >03</span
          >
          <div>
            <h3 class="text-xl font-semibold">Strategic review: Day 60</h3>
            <p class="mt-3 text-muted">
              We sit down for a strategic review: what changed, what the numbers show, and where you want to take it. If
              it is working and you want to continue, we build a plan together. The pilot itself costs you nothing.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Cost and obligation -->
  <section class="bg-slate-950 dark:bg-black">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
      <div class="grid gap-12 lg:grid-cols-2">
        <div>
          <p class="mb-4 text-xs font-semibold uppercase tracking-widest text-blue-400">Transparency</p>
          <h2 class="text-balance text-3xl font-bold tracking-tight text-white sm:text-4xl">What this pilot is not</h2>
          <ul class="mt-8 space-y-4">
            <li class="flex items-start gap-3">
              <span class="mt-1.5 w-1.5 h-1.5 shrink-0 rounded-full bg-gray-500"></span>
              <span class="text-gray-300">A software rollout or EMR replacement</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1.5 w-1.5 h-1.5 shrink-0 rounded-full bg-gray-500"></span>
              <span class="text-gray-300">An automation experiment your nurses have to learn</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1.5 w-1.5 h-1.5 shrink-0 rounded-full bg-gray-500"></span>
              <span class="text-gray-300">A replacement for your existing staff or manager</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1.5 w-1.5 h-1.5 shrink-0 rounded-full bg-gray-500"></span>
              <span class="text-gray-300">A long-term commitment or surprise invoice</span>
            </li>
          </ul>
          <p class="mt-6 text-gray-400">
            It is a structured collaboration to see whether assisted scheduling reduces effort and stress for your team.
          </p>
        </div>

        <div class="rounded-2xl border border-gray-700 bg-slate-900 dark:bg-black p-8">
          <h2 class="text-2xl font-bold text-white">Cost and obligation</h2>
          <p class="mt-4 text-gray-300">There is no cost for the pilot. Free for 60 days.</p>
          <p class="mt-4 text-gray-300">
            If it does not deliver value, you walk away. No obligation, no pressure to continue.
          </p>
          <p class="mt-4 text-gray-300">
            If it helps, we discuss next steps calmly and clearly. You will know within 6 weeks whether this is right
            for your unit.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="/contact" class="btn btn-primary sm:mb-0"> Get a Free Schedule Review </a>
            <a href={ctaLink} class="btn text-white border-white/30 hover:bg-white/10 hover:border-white">
              Book a call with our team
            </a>
          </div>
          <div class="mt-6 flex flex-wrap gap-2">
            <span
              class="inline-flex items-center gap-x-1.5 rounded-full border border-blue-800/50 bg-blue-900/30 px-3 py-1.5 text-xs font-medium text-blue-300"
              >Free for 60 Days</span
            >
            <span
              class="inline-flex items-center gap-x-1.5 rounded-full border border-blue-800/50 bg-blue-900/30 px-3 py-1.5 text-xs font-medium text-blue-300"
              >3 Hospitals Only</span
            >
            <span
              class="inline-flex items-center gap-x-1.5 rounded-full border border-blue-800/50 bg-blue-900/30 px-3 py-1.5 text-xs font-medium text-blue-300"
              >No IT Setup</span
            >
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
