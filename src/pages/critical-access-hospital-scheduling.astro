                <td class="px-2 py-3 text-center text-default bg-primary/5">4 RN</td>
                <td class="px-2 py-3 text-center text-default bg-primary/5">3 RN</td>
                <td class="px-2 py-3 text-center text-default bg-primary/5">3 RN</td>
              </tr>
              <tr class="border-t border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60">
                <td
                  class="px-3 py-2 text-xs font-semibold text-slate-700 dark:text-slate-300 border-r border-slate-300 dark:border-slate-700"
