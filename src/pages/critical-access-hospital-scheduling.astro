    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 prose dark:prose-invert prose-lg max-w-none">
      <p class="not-prose text-sm text-muted dark:text-slate-400 mb-8">
        By <a href="/about/pradeep-pandey" class="text-muted dark:text-slate-300 underline decoration-dotted"
