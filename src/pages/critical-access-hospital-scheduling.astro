                <th class="px-2 py-3 text-center font-semibold text-primary bg-primary/5 dark:bg-sage/10">Sun Jun 8</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-t border-slate-300 dark:border-slate-700">
                <td
                  class="px-3 py-3 font-medium text-slate-800 dark:text-slate-200 border-r border-slate-300 dark:border-slate-700"
                >
