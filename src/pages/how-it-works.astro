---
import Layout from '~/layouts/PageLayout.astro';
import SchemaOrg from '~/components/common/SchemaOrg.astro';
import DarkHero from '~/components/widgets/DarkHero.astro';
import SchedulerDemoSection from '~/components/widgets/SchedulerDemoSection.astro';
import Steps from '~/components/widgets/Steps.astro';
import WeeklyCadence from '~/components/widgets/WeeklyCadence.astro';
import QualityChecks from '~/components/widgets/QualityChecks.astro';
import ComplianceRules from '~/components/widgets/ComplianceRules.astro';
import CalloutDetail from '~/components/widgets/CalloutDetail.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'How it Works',
  description:
    'How our AI-native nurse scheduling service works for Critical Access Hospitals in Texas: AI builds the schedule, our scheduling team checks it, your manager approves.',
};

const softwareAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'SimpleScheduleAI',
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: 'Healthcare Scheduling Software',
  operatingSystem: 'Web',
  url: 'https://simplescheduleai.com',
  description:
    'AI-powered nurse scheduling software for critical access hospitals. Generates balanced, fair, and cost-optimized nurse schedules, handles callout replacements automatically, and tracks Texas overtime compliance.',
  audience: {
    '@type': 'Audience',
    audienceType: 'Nurse Managers, Directors of Nursing, CAH Administrators',
  },
  featureList: [
    'AI-generated nurse schedules',
    'Three draft options: balanced, fairness-optimized, cost-optimized',
    'Real-time callout replacement shortlist',
    'Excel roster upload',
    'Texas overtime compliance tracking',
    'Audit trail logging',
  ],
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'USD',
    lowPrice: '1000',
    highPrice: '1500',
    offerCount: '2',
    description: 'Flat monthly price per facility, by roster size',
  },
};

const howItWorksBreadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://simplescheduleai.com' },
    { '@type': 'ListItem', position: 2, name: 'How It Works', item: 'https://simplescheduleai.com/how-it-works' },
  ],
};
---

<Layout metadata={metadata}>
  <SchemaOrg slot="head" schema={[softwareAppSchema, howItWorksBreadcrumbSchema]} />
  <!-- Dark Hero -->
  <DarkHero
    badge="Clear workflow. Predictable handoffs."
    title="How it Works"
    subtitle="Our AI builds your schedule. Our scheduling team checks every draft. Your manager approves. Scheduling workload drops from 8 to 12 hours a week to 1 to 2."
    actions={[
      { text: 'Get your first schedule', href: '/contact', variant: 'primary' },
      { text: 'Book a call with our team', href: 'https://cal.com/gautham-8bdvdx/30min', variant: 'secondary' },
    ]}
  />

  <!-- What you send / What you get -->
  <section class="bg-page">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
      <div class="max-w-2xl" data-reveal>
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-primary">Simple handoff</p>
        <h2 class="font-heading text-3xl font-semibold tracking-tight sm:text-4xl">
          What you send us. What you get back.
        </h2>
        <p class="mt-4 text-lg text-muted">
          We work with the format you already use. Excel is fine. No new software for your staff.
        </p>
      </div>

      <div class="mt-10 grid gap-10 md:grid-cols-2 md:gap-0" data-reveal-group>
        <div class="md:pr-12 lg:pr-16">
          <h3 class="mb-5 text-sm font-semibold uppercase tracking-[0.14em] text-muted">What you send us</h3>
          <ul class="divide-y divide-ink/10 border-t border-ink/10">
            <li class="py-3.5 leading-relaxed text-default/80">
              Staff roster via Excel (roles, competency levels, home units)
            </li>
            <li class="py-3.5 leading-relaxed text-default/80">PRN availability submissions and leave requests</li>
            <li class="py-3.5 leading-relaxed text-default/80">
              Unit rules: weekend requirements, escalation order, OT thresholds
            </li>
          </ul>
          <p class="mt-4 text-sm text-muted">Export your current data, edit in Excel, re-import. Simple.</p>
        </div>

        <div class="md:border-l md:border-ink/10 md:pl-12 lg:pl-16">
          <h3 class="mb-5 text-sm font-semibold uppercase tracking-[0.14em] text-primary">What you get back</h3>
          <ul class="divide-y divide-ink/10 border-t border-ink/10">
            <li class="py-3.5 leading-relaxed text-default">
              Compliant, post-ready schedule (21 rules checked automatically)
            </li>
            <li class="py-3.5 leading-relaxed text-default">
              Multiple schedule drafts showing different coverage, cost, and fairness trade-offs
            </li>
            <li class="py-3.5 leading-relaxed text-default">Auto-recommended replacements when leave is approved</li>
            <li class="py-3.5 leading-relaxed text-default">Full audit trail of every change for compliance</li>
          </ul>
          <p class="mt-4 text-sm text-muted">Nothing is final until your team signs off.</p>
          <p class="mt-2 text-sm text-muted">
            <span class="font-semibold text-default">Delivered every Thursday, 3pm.</span> PDF schedule, a manager summary
            with flagged items, and full data for your records, ready for review before posting.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Scheduler Demo Widget (animated end-to-end demo) -->
  <SchedulerDemoSection />

  <!-- 4-step workflow -->
  <Steps
    title="Four steps. No surprises."
    subtitle="A structured collaboration that respects your existing process."
    tagline="The process"
    items={[
      {
        title: 'Kickoff and rules',
        description: 'We document your rules, constraints, and what a good schedule looks like for your unit.',
        icon: 'tabler:number-1',
      },
      {
        title: 'Inputs and handoff',
        description: 'Your team shares availability and coverage requirements in the format you already use.',
        icon: 'tabler:number-2',
      },
      {
        title: 'Build and validate',
        description:
          'Our AI builds the schedule and checks all 21 rules: coverage, safety requirements, fairness, and scheduling conflicts, and our team validates the result.',
        icon: 'tabler:number-3',
      },
      {
        title: 'Your review and approval',
        description: 'Your team reviews, adjusts if needed, and approves. You stay in full control.',
        icon: 'tabler:number-4',
      },
    ]}
  />

  <!-- Weekly cadence: how a week runs once the rules are locked -->
  <WeeklyCadence />

  <!-- 21 automated quality checks (dark band, leads into the full rule list) -->
  <QualityChecks />

  <!-- 13 + 8 Rules Detail -->
  <ComplianceRules id="compliance-rules" />

  <!-- Callout workflow detail (the exception path) -->
  <CalloutDetail />

  <!-- FAQ -->
  <FAQs
    title="Questions about the process"
    tagline="Common questions"
    items={[
      {
        title: 'How do we get our data in?',
        description: 'Excel upload. Export your current data, edit, re-import anytime. No new software for your staff.',
      },
      {
        title: 'What happens when someone calls out?',
        description:
          'The system auto-finds the top 3 replacement candidates with reasons. You approve with one click. You do not have to call us, but we are reachable if something unusual comes up.',
      },
      {
        title: 'How is fairness tracked?',
        description:
          'Weekends (no more than 3 per 6-week period), holidays (tracked annually), overtime, and charge duty distribution. All automatic.',
      },
      {
        title: 'What about compliance and audits?',
        description:
          'Full audit trail of every change: who, what, when. Exportable anytime. Staffing committee packet ready in one click.',
      },
      {
        title: 'What if we already use a scheduling system?',
        description:
          'We do not replace your EMR. We are built to replace spreadsheets or a basic tool that does not enforce rules. We deliver the schedule so you do not have to build it.',
      },
    ]}
  />

  <!-- CTA -->
  <CallToAction
    title="Ready to test this in your hospital?"
    subtitle="See if AI-built, human-checked scheduling reduces the workload on your team. Flat monthly pricing by roster size."
    tagline="Simple pricing"
    actions={[
      { text: 'Get your first schedule', href: '/contact', variant: 'primary' },
      { text: 'Try the interactive demo', href: '/simulator', variant: 'secondary' },
      { text: 'Book a call with our team', href: 'https://cal.com/gautham-8bdvdx/30min', variant: 'secondary' },
    ]}
  />
</Layout>
