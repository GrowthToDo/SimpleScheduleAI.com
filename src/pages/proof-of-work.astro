---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';

// Unlisted evidence page for investors and senior stakeholders.
// noindex + excluded from sitemap (see astro.config.ts filter).
// Placeholder blocks marked "DATA PENDING" must be filled before this URL is shared.
const metadata = {
  title: 'Proof of Work | SimpleScheduleAI',
  description:
    'The evidence behind SimpleScheduleAI: demand data, user research, product, distribution, and unsolicited market validation.',
  robots: { index: false, follow: false },
};

const calLink = 'https://cal.com/gautham-8bdvdx/30min';
const asOf = '2 August 2026';

// Search traction data, pulled directly from Google Search Console and Bing
// Webmaster Tools APIs on 2 August 2026. Positions are the averages those
// tools report; queries shown are a buyer-intent sample (scraper noise excluded).
// Bing's query list carries a large volume of synthetic/bot queries ("4nurse
// alternatives" and similar); those are excluded here. Several Bing positions
// rest on 1-2 impressions in a single week, so they are point-in-time
// observations rather than stable rankings — hence the visible as-of date.
const searchStats = [
  { value: '22,145', label: 'Google impressions in the 90 days to 1 August 2026, with 74 clicks' },
  { value: '~13', label: 'Average Google position in late July, up from the 40s and 50s in mid-April' },
  {
    value: '3 → 47',
    label: 'Monthly Google clicks: 3 in April, 9 in May, 16 in June, 47 in July',
  },
];

// --- Chart data ---------------------------------------------------------
// Weekly Google Search Console series (impressions summed, average position
// as the mean of the week's daily averages), 16 Apr - 29 Jul 2026, pulled
// from the GSC API. Feeds the momentum chart below.
const momentum = [
  { wk: 'Apr 16', imp: 750, pos: 50.5 },
  { wk: 'Apr 23', imp: 1219, pos: 31.8 },
  { wk: 'Apr 30', imp: 1320, pos: 24.2 },
  { wk: 'May 7', imp: 1714, pos: 20.9 },
  { wk: 'May 14', imp: 2085, pos: 18.0 },
  { wk: 'May 21', imp: 1920, pos: 19.8 },
  { wk: 'May 28', imp: 1488, pos: 15.3 },
  { wk: 'Jun 4', imp: 1465, pos: 15.1 },
  { wk: 'Jun 11', imp: 1394, pos: 19.2 },
  { wk: 'Jun 18', imp: 1285, pos: 16.9 },
  { wk: 'Jun 25', imp: 1735, pos: 16.3 },
  { wk: 'Jul 2', imp: 1841, pos: 13.8 },
  { wk: 'Jul 9', imp: 2053, pos: 14.7 },
  { wk: 'Jul 16', imp: 1406, pos: 14.9 },
  { wk: 'Jul 23', imp: 2210, pos: 14.1 },
];
// Two stacked panels share one x-axis (weeks). Every point is labelled with its
// value, so neither panel needs a y-axis, and the two series never collide.
const mN = momentum.length;
const chartPlotL = 32,
  chartPlotR = 728;
const mXAt = (i: number) => chartPlotL + (i * (chartPlotR - chartPlotL)) / (mN - 1);
const mBarW = 26;
const mFmt = (n: number) => (n >= 1000 ? `${Math.floor(n / 1000)},${String(n % 1000).padStart(3, '0')}` : String(n));
// Impressions panel (bars, value labelled above each bar).
const iTop = 30,
  iBot = 140,
  iMax = 2300;
const iY = (v: number) => iBot - (v / iMax) * (iBot - iTop);
const iBars = momentum.map((d, i) => ({
  x: mXAt(i) - mBarW / 2,
  y: iY(d.imp),
  h: iBot - iY(d.imp),
  cx: mXAt(i),
  val: d.imp,
}));
// Position panel (line, value labelled above each dot; drawn on an inverted
// scale so a rising line means an improving rank).
const pTop = 34,
  pBot = 150,
  pMin = 10,
  pMax = 52;
const pY = (v: number) => pTop + ((v - pMin) / (pMax - pMin)) * (pBot - pTop);
const pLine = momentum.map((d, i) => `${mXAt(i).toFixed(1)},${pY(d.pos).toFixed(1)}`).join(' ');
const pDots = momentum.map((d, i) => ({ x: mXAt(i), y: pY(d.pos), pos: d.pos }));
const mLabels = momentum.map((d, i) => ({ x: mXAt(i), wk: d.wk, show: i % 2 === 0 }));

// Combined buyer-intent ranking snapshot for the lollipop chart. Position 1
// (best) sits at the left edge; the number at the right of each row is the
// reported average Google or Bing position for that query.
const rankData = [
  { q: 'best software for nurse scheduling', pos: 1, engine: 'Bing' },
  { q: 'ai healthcare scheduling tool not ukg not qgenda', pos: 1, engine: 'Bing' },
  { q: 'replacements for qgenda', pos: 1, engine: 'Bing' },
  { q: 'best nurse scheduling software for small hospitals', pos: 2, engine: 'Bing' },
  { q: 'best nurse scheduling software for a small critical access hospital in texas', pos: 2, engine: 'Bing' },
  { q: 'best aladtec alternatives', pos: 2.5, engine: 'Google' },
  { q: 'nurse scheduling software', pos: 5, engine: 'Bing' },
  { q: 'alternatives to aladtec', pos: 5.7, engine: 'Google' },
  { q: 'alternatives to shiftwizard software', pos: 8.0, engine: 'Google' },
  { q: 'alternatives to smartlinx software', pos: 8.5, engine: 'Google' },
  { q: 'best alternatives to qgenda for ambulatory practice', pos: 8.8, engine: 'Google' },
  { q: 'best nurse scheduling software 2026', pos: 9.9, engine: 'Google' },
  { q: 'what is the best alternative to qgenda', pos: 10.4, engine: 'Google' },
  { q: 'nurse scheduling software pricing', pos: 13.1, engine: 'Google' },
];
// Derived from the data so a newly-added or drifted position can never overflow
// the bar (a hard-coded divisor of 11 broke when the worst position passed 12).
const rankMax = Math.max(...rankData.map((r) => r.pos));
const rankPct = (p: number) => (((p - 1) / (rankMax - 1)) * 100).toFixed(1);

// Answer engines that name AND cite the site on our core buyer prompts.
// Only engines where we actually appear are listed.
const aiCites = [
  {
    engine: 'Perplexity · Sonar Pro',
    result: 'Named us on all three buyer prompts, citing four pages on the CAH-in-Texas question.',
    date: '22 Jul 2026',
  },
  {
    engine: 'ChatGPT · GPT-5.5',
    result: 'Named us the best fit for a small CAH in Texas, and cited our comparison page.',
    date: '22 Jul 2026',
  },
  {
    engine: 'Gemini · 2.5 Flash',
    result: 'Named us on two of three buyer prompts.',
    date: '22 Jul 2026',
  },
  {
    engine: 'Google AI Overview',
    result: 'Named SimpleScheduleAI the first of three picks, and cited this site.',
    date: '13 Jul 2026',
  },
];

const productStats = [
  { value: '22', label: 'Scheduling rule evaluators, hard and soft, each covered by tests' },
  { value: '3', label: 'Schedule variants per run: balanced, fairness-optimized, cost-optimized' },
  { value: '~590', label: 'Automated tests across the product' },
  { value: '78', label: 'Shipped versions since 12 June 2026' },
  { value: '~50,000', label: 'Lines of TypeScript across the product' },
  { value: '1 min', label: 'From Excel roster to a generated, compliant schedule' },
];

const builtFeatures = [
  'Excel roster import and export, because Excel is what small hospitals actually use',
  'Hard and soft rule engine with violation surfacing and documented rejection reasons',
  'Leave requests, callouts, and qualification-matched replacement finder',
  'Shift-swap validation and census-driven staffing changes',
  'Full audit trail on every schedule change',
  'Nurse-facing portal: shift calendar, leave requests, swap requests',
];

const descoped = [
  {
    what: 'Self-scheduling',
    why: 'Nurse managers want to keep control. Their existing ERP self-scheduling causes problems. A buyer told us directly to leave it out.',
  },
  {
    what: 'Epic / Cerner integration',
    why: 'Small hospitals do not run these systems. Excel is the real interchange format, so Excel is what we built for.',
  },
  {
    what: 'Mobile app',
    why: 'Not a priority yet. The buyer and approver work on desktop, so that came first. A nurse-facing mobile view is on the roadmap if design partners want it.',
  },
];

// Founding keyword research, pulled from Google Keyword Planner 1-3 Sep 2025.
// Numbers logged in the Health Care Business doc; the niche-down decision to
// nurse scheduling was made 2-3 Sep 2025, product work started Dec 2025.
const keywordStats = [
  {
    value: '500,000',
    label:
      'US monthly searches for "employee scheduling software", the generic head term, at low keyword difficulty and up 900% in three months',
  },
  {
    value: '5,000',
    label: 'US monthly searches for "nurse scheduling software", the niche we chose to enter',
  },
  {
    value: '~$40',
    label:
      'What advertisers were paying per click in this category, on sales-led "book a demo" funnels: the budget already existed',
  },
];

// Live content counts, computed at build so these proof numbers never go stale.
const pMods = import.meta.glob('../data/post/*.md', { eager: true });
const aMods = import.meta.glob('../data/article/*.md', { eager: true });
const allDocs: any[] = [...Object.values(pMods), ...Object.values(aMods)];
const liveCount = allDocs.filter((m) => m.frontmatter?.draft === false).length;
const draftCount = allDocs.filter((m) => m.frontmatter?.draft === true).length;
const authoredCount = liveCount + draftCount;

const distribution = [
  { value: String(authoredCount), label: 'Articles authored for the small-hospital scheduling niche' },
  { value: String(liveCount), label: `Published live, with ${draftCount} more in the reviewed pipeline` },
  {
    value: '3',
    label:
      'Self-serve assets a buyer can use: a live scheduling simulator, an ROI calculator, and a free Excel scheduling template',
  },
];

// Section table of contents, used by both the desktop dot-nav and the mobile pill bar below.
const navItems = [
  { id: 'problem-statement', num: '01', label: 'Problem statement' },
  { id: 'voice-of-customer', num: '02', label: 'Voice of customer' },
  { id: 'what-we-built', num: '03', label: 'What we built' },
  { id: 'distribution', num: '04', label: 'Distribution' },
  { id: 'validation', num: '05', label: 'Validation' },
  { id: 'whats-next', num: '06', label: "What's next" },
];
---

<Layout metadata={metadata}>
  <!-- Hero -->
  <section class="bg-page">
    <div class="mx-auto max-w-4xl px-4 pt-14 pb-10 sm:px-6 lg:px-8 text-center">
      <span
        class="inline-block mb-5 rounded-full border border-primary/25 bg-primary/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-primary"
      >
        Proof of Work · as of {asOf}
      </span>
      <h1 class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl">
        The work behind SimpleScheduleAI
      </h1>
      <p class="mt-5 text-lg text-muted max-w-2xl mx-auto">
        We deliver finished nurse schedules to small US hospitals as an outcome. A nursing director hands us a roster
        and constraints; they get back a compliant, fair, fully staffed schedule.
      </p>
      <p class="mt-6 text-sm text-muted max-w-2xl mx-auto">
        Where we are, stated plainly: pre-revenue, no design partner signed yet, with a live pursuit at a ~70-nurse
        hospital in North Carolina. Everything below is what has been done to date.
      </p>
    </div>
  </section>

  <!-- Section navigation: always-visible pill list on desktop (left rail), sticky pill bar on mobile -->
  <nav
    aria-label="Section navigation"
    class="toc-nav hidden lg:flex fixed left-6 top-1/2 z-40 -translate-y-1/2 flex-col items-start gap-2"
  >
    {
      navItems.map((item) => (
        <a
          href={`#${item.id}`}
          data-toc-link
          data-target={item.id}
          class="toc-link toc-pill whitespace-nowrap rounded-full border border-gray-300 dark:border-gray-600 bg-white/90 dark:bg-slate-800/90 px-3.5 py-1.5 text-xs font-semibold text-gray-600 dark:text-gray-300 shadow-sm backdrop-blur transition-colors"
        >
          {item.num} &middot; {item.label}
        </a>
      ))
    }
  </nav>

  <div
    class="toc-nav lg:hidden sticky top-16 z-30 border-b border-hairline bg-page/95 backdrop-blur dark:bg-slate-900/95"
  >
    <div class="mx-auto max-w-4xl overflow-x-auto px-4 py-2 sm:px-6">
      <div class="flex w-max gap-2" role="tablist" aria-label="Section navigation">
        {
          navItems.map((item) => (
            <a
              href={`#${item.id}`}
              data-toc-link
              data-target={item.id}
              class="toc-link toc-pill toc-mobile-pill shrink-0 whitespace-nowrap rounded-full border border-gray-300 dark:border-gray-600 px-3 py-1.5 text-xs font-semibold text-gray-600 dark:text-gray-300 transition-colors"
            >
              {item.num} &middot; {item.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <!-- 1. Demand existed first -->
  <section id="problem-statement" data-toc-section class="bg-white">
    <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6 lg:px-8">
      <p class="text-xs font-semibold uppercase tracking-widest text-primary mb-3">01 · Problem statement</p>
      <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">
        We identified the problem statement through keyword research
      </h2>
      <p class="mt-4 text-muted">
        We found this problem in search data. In early September 2025 we ran keyword research across the
        employee-scheduling category, and within two days made the call to niche down to nurse scheduling (decision
        logged 2&ndash;3 September 2025). Product work started that December, with small and Critical Access Hospitals
        as the first ICP.
      </p>

      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {
          keywordStats.map((s) => (
            <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-page dark:bg-slate-800 p-5 text-center">
              <p class="text-3xl font-bold text-primary">{s.value}</p>
              <p class="mt-2 text-xs text-muted">{s.label}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-3 text-xs text-gray-500 dark:text-gray-400">
        Google Keyword Planner, US, pulled 1&ndash;3 September 2025 and logged in the founding research doc. The
        healthcare-specific cluster ("healthcare staff scheduling software" and variants) sat around 5,000 monthly
        searches globally at low difficulty. The nurse head term was declining year on year in that snapshot; we entered
        anyway, on the strength of the category growth and the ad prices.
      </p>

      <p class="mt-6 text-muted">
        What the data pointed to: small US hospitals still build nurse schedules by hand in Excel. A nurse manager can
        spend a full day every week on it, on top of compliance risk, overtime, and agency-nurse spend.
      </p>
    </div>
  </section>

  <!-- 2. User work -->
  <section id="voice-of-customer" data-toc-section class="bg-page">
    <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6 lg:px-8">
      <p class="text-xs font-semibold uppercase tracking-widest text-primary mb-3">02 · Voice of customer</p>
      <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">What we heard in discovery calls</h2>
      <p class="mt-4 text-muted">
        Conversations with nursing directors, nurse managers, and staffing agency owners across North Carolina, Texas,
        New Jersey, and New Hampshire. The buyer: directors of nursing, 45 to 50+, working in desktop and Excel, put off
        by AI jargon. They want to own an in-house tool with heavy setup and training support, so that is what we sell.
      </p>

      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-800 p-5 shadow-sm">
          <p class="text-sm font-bold text-gray-900 dark:text-white">Shift swaps</p>
          <p class="mt-2 text-sm text-muted">1 to 1.5 hours of manual Excel filtering to validate a single swap.</p>
        </div>
        <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-800 p-5 shadow-sm">
          <p class="text-sm font-bold text-gray-900 dark:text-white">Schedule building</p>
          <p class="mt-2 text-sm text-muted">A nurse manager spending a full day every week building the schedule.</p>
        </div>
        <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-800 p-5 shadow-sm">
          <p class="text-sm font-bold text-gray-900 dark:text-white">Audit trail</p>
          <p class="mt-2 text-sm text-muted">
            Every schedule change must be documented and defensible. Excel cannot do this.
          </p>
        </div>
      </div>
      <p class="mt-3 text-xs text-gray-500 dark:text-gray-400">
        Three pain points that came up consistently in discovery. The product handles all three, verified in a live
        demo.
      </p>

      <blockquote class="mt-8 rounded-2xl border-l-4 border-primary bg-white dark:bg-slate-800 p-6 shadow-sm">
        <p class="text-xl font-semibold text-gray-900 dark:text-white">&ldquo;It's a complete thing already.&rdquo;</p>
        <footer class="mt-3 text-sm text-muted">
          Sharmila Krishnaswamy, Chief of Staff & L&amp;D Leader, Mantravya (North Carolina), after a full live product
          demo on 19 June 2026. She is now actively bringing us into her hospital network.
        </footer>
      </blockquote>

      <div class="mt-6 rounded-2xl border border-gray-200 dark:border-gray-700 bg-page dark:bg-slate-800 p-5">
        <p class="text-xs font-bold uppercase tracking-widest text-primary mb-1">Discovery so far</p>
        <p class="text-sm text-muted">
          Ongoing discovery conversations since September 2025 with bedside and ICU/ED nurses, nurse managers, a
          physician, a UK NHS advanced practitioner, a former nurse now working in health insurance with a
          healthcare-management MBA, and a Chief of Staff at a North Carolina business group who is now actively
          bringing us into her hospital network. Conversations spanned California, North Carolina, New Jersey, Texas,
          and the UK.
        </p>
      </div>
    </div>
  </section>

  <!-- 3. Product -->
  <section id="what-we-built" data-toc-section class="bg-white">
    <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6 lg:px-8">
      <p class="text-xs font-semibold uppercase tracking-widest text-primary mb-3">03 · What we built</p>
      <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">What we've built</h2>
      <p class="mt-4 text-muted">
        The scheduler is a full working application, built and iterated against feedback from nursing professionals
        since December 2025, and demoed live on 19 June 2026.
      </p>

      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {
          productStats.map((s) => (
            <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-page dark:bg-slate-800 p-5 text-center">
              <p class="text-3xl font-bold text-primary">{s.value}</p>
              <p class="mt-2 text-xs text-muted">{s.label}</p>
            </div>
          ))
        }
      </div>

      <ul class="mt-8 grid gap-3 sm:grid-cols-2">
        {
          builtFeatures.map((f) => (
            <li class="flex items-start gap-2 text-sm text-muted">
              <Icon name="tabler:check" class="w-4 h-4 mt-0.5 text-primary shrink-0" />
              <span>{f}</span>
            </li>
          ))
        }
      </ul>

      <h3 class="mt-10 text-xl font-bold text-gray-900 dark:text-white">What we chose not to build</h3>
      <p class="mt-2 text-sm text-muted">Each of these was cut based on what buyers told us.</p>
      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        {
          descoped.map((d) => (
            <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-page dark:bg-slate-800 p-5">
              <p class="text-sm font-bold text-gray-900 dark:text-white">{d.what}</p>
              <p class="mt-2 text-xs text-muted">{d.why}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. Distribution -->
  <section id="distribution" data-toc-section class="bg-page">
    <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6 lg:px-8">
      <p class="text-xs font-semibold uppercase tracking-widest text-primary mb-3">04 · Distribution</p>
      <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">The website and content work</h2>
      <p class="mt-4 text-muted">
        This site is a content and search operation with its own quality gates: every comparison page requires sourced,
        dated review quotes and a minimum depth of niche-specific analysis, enforced in the build pipeline. Content that
        fails the gate cannot ship. The site also publishes structured data for AI answer engines.
      </p>

      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {
          distribution.map((s) => (
            <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-800 p-5 text-center">
              <p class="text-3xl font-bold text-primary">{s.value}</p>
              <p class="mt-2 text-xs text-muted">{s.label}</p>
            </div>
          ))
        }
      </div>

      <p class="mt-6 text-sm text-muted">
        All three are live: the <a href="/simulator" class="text-primary underline">scheduling simulator</a>
        builds a compliant ICU week in your browser, the <a href="/roi" class="text-primary underline">ROI calculator</a
        >
        estimates what manual scheduling currently costs a facility, and the
        <a href="/resources/nurse-schedule-template" class="text-primary underline">free Excel scheduling template</a>
        ships with built-in overtime, rest-hour, and coverage checks.
      </p>

      <h3 class="mt-12 text-xl font-bold text-gray-900 dark:text-white">Search traction</h3>
      <p class="mt-2 text-sm text-muted">
        Numbers pulled directly from the Google Search Console and Bing Webmaster Tools APIs on 2 August 2026. This is
        an early trend, stated plainly: impressions and position are moving fast, clicks are still small.
      </p>

      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        {
          searchStats.map((s) => (
            <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-800 p-5 text-center">
              <p class="text-3xl font-bold text-primary">{s.value}</p>
              <p class="mt-2 text-xs text-muted">{s.label}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-3 text-xs text-gray-500 dark:text-gray-400">
        Daily Google impressions grew from roughly 110 a day in mid-April to roughly 270 a day in early July.
      </p>

      <div class="mt-8 space-y-4">
        <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-800 p-5">
          <p class="text-sm font-bold text-gray-900 dark:text-white">Weekly Google impressions</p>
          <svg
            viewBox="0 0 760 175"
            class="mt-3 w-full"
            role="img"
            aria-label="Weekly Google impressions rising from about 750 to about 2,210 a week between April and July 2026"
          >
            {
              iBars.map((b) => (
                <rect x={b.x} y={b.y} width={mBarW} height={b.h} rx="2" class="fill-primary dark:fill-emerald-700" />
              ))
            }
            {
              iBars.map((b) => (
                <text
                  x={b.cx}
                  y={b.y - 6}
                  text-anchor="middle"
                  font-size="10"
                  class="fill-gray-600 font-semibold dark:fill-gray-200"
                >
                  {mFmt(b.val)}
                </text>
              ))
            }
            {
              mLabels.map(
                (l) =>
                  l.show && (
                    <text x={l.x} y="165" text-anchor="middle" font-size="11" class="fill-gray-500 dark:fill-gray-400">
                      {l.wk}
                    </text>
                  )
              )
            }
          </svg>
        </div>
        <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-800 p-5">
          <div class="flex items-center justify-between gap-2">
            <p class="text-sm font-bold text-gray-900 dark:text-white">Average Google position</p>
            <span class="text-xs text-gray-600 dark:text-gray-300">Lower is better, so a rising line is improving</span>
          </div>
          <svg
            viewBox="0 0 760 185"
            class="mt-3 w-full"
            role="img"
            aria-label="Average Google search position improving from around 50 to around 13 between April and July 2026"
          >
            <polyline
              points={pLine}
              fill="none"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="stroke-emerald-500"></polyline>
            {
