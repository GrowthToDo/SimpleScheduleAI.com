---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';

// Unlisted evidence page for investors and senior stakeholders.
// noindex + excluded from sitemap (see astro.config.ts filter).
// Placeholder blocks marked "DATA PENDING" must be filled before this URL is shared.
const metadata = {
  title: 'Proof of Work | SimpleScheduleAI',
  description:
    'The evidence behind SimpleScheduleAI: demand data, user research, product, distribution, and unsolicited market validation.',
  robots: { index: false, follow: false },
};

const calLink = 'https://cal.com/gautham-8bdvdx/30min';
const asOf = '10 July 2026';

// Search traction data, pulled directly from Google Search Console and Bing
// Webmaster Tools APIs on 10 July 2026. Positions are the averages those
// tools report; queries shown are a buyer-intent sample (scraper noise excluded).
const searchStats = [
  { value: '18,946', label: 'Google impressions in the 90 days to 10 July 2026, with 38 clicks' },
  { value: '~14', label: 'Average Google position in early July, up from the 40s and 50s in mid-April' },
  {
    value: '3 → 16',
    label: 'Monthly Google clicks: 3 in April, 9 in May, 16 in June, 10 in the first nine days of July',
  },
];

const googleQueries = [
  { q: 'best aladtec alternatives', pos: '2.5' },
  { q: 'alternatives to aladtec', pos: '4.8' },
  { q: 'best nurse scheduling software 2026', pos: '6.7' },
  { q: 'alternatives to smartlinx software', pos: '7.5' },
  { q: 'best alternatives to qgenda for ambulatory practice', pos: '8.7' },
  { q: 'alternatives to shiftwizard software', pos: '9.9' },
  { q: 'what is the best alternative to qgenda', pos: '10.4' },
  { q: 'nurse scheduling software pricing', pos: '11.2' },
];

const bingQueries = [
  { q: 'best software for nurse scheduling', pos: '1', when: 'week of 22 May' },
  { q: 'ai healthcare scheduling tool not ukg not qgenda', pos: '1', when: 'week of 12 June' },
  { q: 'replacements for qgenda', pos: '1', when: 'week of 19 June' },
  { q: 'best nurse scheduling software for small hospitals', pos: '2', when: 'week of 5 June' },
  { q: 'nurse scheduling software', pos: '3', when: '84 impressions, week of 5 June' },
];

const productStats = [
  { value: '22', label: 'Scheduling rule evaluators, hard and soft, each covered by tests' },
  { value: '3', label: 'Schedule variants per run: balanced, fairness-optimized, cost-optimized' },
  { value: '~200', label: 'Automated tests on the rules engine and optimizer' },
  { value: '97', label: 'Shipped versions since 12 June 2026' },
  { value: '~50,000', label: 'Lines of TypeScript across the product' },
  { value: '1 min', label: 'From Excel roster to a generated, compliant schedule' },
];

const builtFeatures = [
  'Excel roster import and export, because Excel is what small hospitals actually use',
  'Hard and soft rule engine with violation surfacing and documented rejection reasons',
  'Leave requests, callouts, and qualification-matched replacement finder',
  'Shift-swap validation and census-driven staffing changes',
  'Full audit trail on every schedule change',
  'Nurse-facing portal: shift calendar, leave requests, swap requests',
];

const descoped = [
  {
    what: 'Self-scheduling',
    why: 'Nurse managers want to keep control. Their existing ERP self-scheduling causes problems. A buyer told us directly to leave it out.',
  },
  {
    what: 'Epic / Cerner integration',
    why: 'Small hospitals do not run these systems. Excel is the real interchange format, so Excel is what we built for.',
  },
  { what: 'Mobile app', why: 'The buyer is 45 to 50+, desktop-first. We build for how they actually work.' },
];

const distribution = [
  { value: '113', label: 'Articles authored for the small-hospital scheduling niche' },
  { value: '50', label: 'Published today, with 63 more in the reviewed pipeline' },
  { value: '2', label: 'Interactive tools on the site: a live scheduling simulator and an ROI calculator' },
];
---

<Layout metadata={metadata}>
  <!-- Hero -->
  <section class="bg-page">
    <div class="mx-auto max-w-4xl px-4 pt-14 pb-10 sm:px-6 lg:px-8 text-center">
      <span
        class="inline-block mb-5 rounded-full border border-primary/25 bg-primary/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-primary"
      >
        Proof of Work · as of {asOf}
      </span>
      <h1 class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl">
        The work behind SimpleScheduleAI
      </h1>
      <p class="mt-5 text-lg text-muted max-w-2xl mx-auto">
        We deliver finished nurse schedules to small US hospitals as an outcome. A nursing director hands us a roster
        and constraints; they get back a compliant, fair, fully staffed schedule.
      </p>
      <p class="mt-6 text-sm text-muted max-w-2xl mx-auto">
        Where we are, stated plainly: pre-revenue, no design partner signed yet, with a live pursuit at a ~70-nurse
        hospital in North Carolina. Everything below is what has been done to date.
      </p>
    </div>
  </section>

  <!-- 1. Demand existed first -->
  <section class="bg-white">
    <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6 lg:px-8">
      <p class="text-xs font-semibold uppercase tracking-widest text-primary mb-3">01 · How we arrived at the idea</p>
      <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">
        The idea came from keyword research
      </h2>
      <p class="mt-4 text-muted">
        We found this problem in search data, in December 2025. Keyword volume showed people already searching for nurse
        scheduling help for small and Critical Access Hospitals, and for alternatives to the incumbent platforms.
      </p>
      <p class="mt-4 text-muted">
        What the data pointed to: small US hospitals still build nurse schedules by hand in Excel. A director of nursing
        can spend a full day every week on it, on top of compliance risk, overtime, and agency-nurse spend.
      </p>
      <div class="mt-6 rounded-2xl border border-amber-300 bg-amber-50 dark:bg-amber-900/20 dark:border-amber-700 p-5">
        <p class="text-xs font-bold uppercase tracking-widest text-amber-700 dark:text-amber-400 mb-1">Data pending</p>
        <p class="text-sm text-amber-800 dark:text-amber-300">
          Keyword-volume snapshot from the original Dec 2025 research: target terms, monthly volumes, and the
          incumbent-alternative searches that triggered the decision to build.
        </p>
      </div>
    </div>
  </section>

  <!-- 2. User work -->
  <section class="bg-page">
    <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6 lg:px-8">
      <p class="text-xs font-semibold uppercase tracking-widest text-primary mb-3">02 · Voice of customer</p>
      <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">What we heard in discovery calls</h2>
      <p class="mt-4 text-muted">
        Conversations with nursing directors, nurse managers, and staffing agency owners across North Carolina, Texas,
        New Jersey, and New Hampshire. The buyer: directors of nursing, 45 to 50+, working in desktop and Excel, put off
        by AI jargon. They want to own an in-house tool with heavy setup and training support, so that is what we sell.
      </p>

      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-800 p-5 shadow-sm">
          <p class="text-sm font-bold text-gray-900 dark:text-white">Shift swaps</p>
          <p class="mt-2 text-sm text-muted">1 to 1.5 hours of manual Excel filtering to validate a single swap.</p>
        </div>
        <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-800 p-5 shadow-sm">
          <p class="text-sm font-bold text-gray-900 dark:text-white">Schedule building</p>
          <p class="mt-2 text-sm text-muted">
            A director of nursing spending a full day every week building the schedule.
          </p>
        </div>
        <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-800 p-5 shadow-sm">
          <p class="text-sm font-bold text-gray-900 dark:text-white">Audit trail</p>
          <p class="mt-2 text-sm text-muted">
            Every schedule change must be documented and defensible. Excel cannot do this.
          </p>
        </div>
      </div>
      <p class="mt-3 text-xs text-gray-500 dark:text-gray-400">
        Three pain points that came up consistently in discovery. The product handles all three, verified in a live
        demo.
      </p>

      <blockquote class="mt-8 rounded-2xl border-l-4 border-primary bg-white dark:bg-slate-800 p-6 shadow-sm">
        <p class="text-xl font-semibold text-gray-900 dark:text-white">&ldquo;It's a complete thing already.&rdquo;</p>
        <footer class="mt-3 text-sm text-muted">
          Sharmila Krishnaswamy, nursing operations, Mantravya (North Carolina), after a full live product demo on 19
          June 2026. She is now actively bringing us into her hospital network.
        </footer>
      </blockquote>

      <div class="mt-6 rounded-2xl border border-amber-300 bg-amber-50 dark:bg-amber-900/20 dark:border-amber-700 p-5">
        <p class="text-xs font-bold uppercase tracking-widest text-amber-700 dark:text-amber-400 mb-1">Data pending</p>
        <p class="text-sm text-amber-800 dark:text-amber-300">
          Total discovery-call count and role breakdown ("we have spoken to N nursing directors").
        </p>
      </div>
    </div>
  </section>

  <!-- 3. Product -->
  <section class="bg-white">
    <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6 lg:px-8">
      <p class="text-xs font-semibold uppercase tracking-widest text-primary mb-3">03 · What we built</p>
      <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">What we've built</h2>
      <p class="mt-4 text-muted">
        The scheduler is a full working application, built and iterated against feedback from nursing professionals
        since December 2025, and demoed live on 19 June 2026.
      </p>

      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {
          productStats.map((s) => (
            <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-page dark:bg-slate-800 p-5 text-center">
              <p class="text-3xl font-bold text-primary">{s.value}</p>
              <p class="mt-2 text-xs text-muted">{s.label}</p>
            </div>
          ))
        }
      </div>

      <ul class="mt-8 grid gap-3 sm:grid-cols-2">
        {
          builtFeatures.map((f) => (
            <li class="flex items-start gap-2 text-sm text-muted">
              <Icon name="tabler:check" class="w-4 h-4 mt-0.5 text-primary shrink-0" />
              <span>{f}</span>
            </li>
          ))
        }
      </ul>

      <h3 class="mt-10 text-xl font-bold text-gray-900 dark:text-white">What we chose not to build</h3>
      <p class="mt-2 text-sm text-muted">Each of these was cut based on what buyers told us.</p>
      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        {
          descoped.map((d) => (
            <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-page dark:bg-slate-800 p-5">
              <p class="text-sm font-bold text-gray-900 dark:text-white">{d.what}</p>
              <p class="mt-2 text-xs text-muted">{d.why}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. Distribution -->
  <section class="bg-page">
    <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6 lg:px-8">
      <p class="text-xs font-semibold uppercase tracking-widest text-primary mb-3">04 · Distribution</p>
      <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">The website and content work</h2>
      <p class="mt-4 text-muted">
        This site is a content and search operation with its own quality gates: every comparison page requires sourced,
        dated review quotes and a minimum depth of niche-specific analysis, enforced in the build pipeline. Content that
        fails the gate cannot ship. The site also publishes structured data for AI answer engines.
      </p>

      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {
          distribution.map((s) => (
            <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-800 p-5 text-center">
              <p class="text-3xl font-bold text-primary">{s.value}</p>
              <p class="mt-2 text-xs text-muted">{s.label}</p>
            </div>
          ))
        }
      </div>

      <p class="mt-6 text-sm text-muted">
        Both tools are live: the <a href="/simulator" class="text-primary underline">scheduling simulator</a>
        builds a compliant ICU week in your browser, and the <a href="/roi" class="text-primary underline"
          >ROI calculator</a
        >
        estimates what manual scheduling currently costs a facility.
      </p>

      <h3 class="mt-12 text-xl font-bold text-gray-900 dark:text-white">Search traction</h3>
      <p class="mt-2 text-sm text-muted">
        Numbers pulled directly from the Google Search Console and Bing Webmaster Tools APIs on 10 July 2026. This is an
        early trend, stated plainly: impressions and position are moving fast, clicks are still small.
      </p>

      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        {
          searchStats.map((s) => (
            <div class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-800 p-5 text-center">
              <p class="text-3xl font-bold text-primary">{s.value}</p>
              <p class="mt-2 text-xs text-muted">{s.label}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-3 text-xs text-gray-500 dark:text-gray-400">
        Daily Google impressions grew from roughly 110 a day in mid-April to roughly 270 a day in early July.
      </p>

      <h4 class="mt-8 text-base font-bold text-gray-900 dark:text-white">
        Where buyer-intent searches find us on Google
      </h4>
      <div
        class="mt-3 overflow-x-auto rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-800"
      >
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-200 dark:border-gray-700 text-left">
              <th class="px-4 py-3 font-semibold text-gray-900 dark:text-white">Query</th>
              <th class="px-4 py-3 font-semibold text-gray-900 dark:text-white whitespace-nowrap">Avg. position</th>
            </tr>
          </thead>
          <tbody>
            {
              googleQueries.map((r) => (
                <tr class="border-b border-gray-100 dark:border-gray-700/50 last:border-0">
                  <td class="px-4 py-2.5 text-muted">{r.q}</td>
                  <td class="px-4 py-2.5 font-semibold text-gray-900 dark:text-white">{r.pos}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-gray-500 dark:text-gray-400">
        Google Search Console, 28 days to 10 July 2026. For contrast, the head term "nurse scheduling software" drew 258
        impressions at average position 40 in the same window, and "best nurse scheduling software" sat at 19. Long-tail
        buyer queries rank first; head terms need more domain authority and are still climbing.
      </p>

      <h4 class="mt-8 text-base font-bold text-gray-900 dark:text-white">Bing: small volume, top placements</h4>
      <p class="mt-2 text-sm text-muted">
        Bing traffic is still single-digit clicks, so what matters at this stage is placement. Where the site shows up
        for buyer queries, it shows up near the top:
      </p>
      <div
        class="mt-3 overflow-x-auto rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-800"
      >
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-200 dark:border-gray-700 text-left">
              <th class="px-4 py-3 font-semibold text-gray-900 dark:text-white">Query</th>
              <th class="px-4 py-3 font-semibold text-gray-900 dark:text-white whitespace-nowrap">Position</th>
              <th class="px-4 py-3 font-semibold text-gray-900 dark:text-white whitespace-nowrap">When (2026)</th>
            </tr>
          </thead>
          <tbody>
            {
              bingQueries.map((r) => (
                <tr class="border-b border-gray-100 dark:border-gray-700/50 last:border-0">
                  <td class="px-4 py-2.5 text-muted">{r.q}</td>
                  <td class="px-4 py-2.5 font-semibold text-gray-900 dark:text-white">{r.pos}</td>
                  <td class="px-4 py-2.5 text-muted whitespace-nowrap">{r.when}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h4 class="mt-8 text-base font-bold text-gray-900 dark:text-white">AI answer engines</h4>
      <p class="mt-2 text-sm text-muted">
        Three things are measurable today. First, people are already reaching this site with full-sentence,
        assistant-style questions: Bing logged the site at position 1 for "what are the best nurse scheduling shift
        tools out there with ai?" and position 2 for "can co pilot gernerate a nurses schedule" (query verbatim, week of
        15 May), and Google shows it at positions 6 to 8 on full-question searches such as "is qgenda a good fit for
        physicians and clinical staff needing mobile scheduling access and notification?". Second, Microsoft Copilot
        grounds its web answers in the Bing index, so the position 1 to 3 Bing rankings above are the mechanism by which
        Copilot can cite us.
      </p>

      <p class="mt-4 text-sm text-muted">
        Third, we run dated engine probes with one buyer prompt: "What is the best nurse scheduling software for a small
        critical access hospital in Texas?"
      </p>

      <div class="mt-4 rounded-2xl border-2 border-primary/30 bg-primary/5 p-5">
        <p class="text-xs font-bold uppercase tracking-widest text-primary mb-2">
          Logged probe · Google AI Overview · 13 July 2026
        </p>
        <p class="text-sm text-gray-800 dark:text-gray-200">
          Google's AI Overview named SimpleScheduleAI the <strong>first</strong> of its three picks and cited this site:
          "Best AI-Native Service (Managed): SimpleScheduleAI is purpose-built for Texas Critical Access Hospitals. It eliminates
          complex self-serve software setups by acting as an AI service that handles scheduling, callouts, and Texas compliance
          audit trails automatically." Aladtec and ShiftWizard were listed second and third.
        </p>
      </div>

      <div class="mt-3 rounded-2xl border-2 border-primary/30 bg-primary/5 p-5">
        <p class="text-xs font-bold uppercase tracking-widest text-primary mb-2">
          Logged probe · ChatGPT · 12 July 2026
        </p>
        <p class="text-sm text-gray-800 dark:text-gray-200">
          ChatGPT (GPT-5.5, web search on) named SimpleScheduleAI its best "small CAH-specific emerging option",
          shortlisted it alongside QGenda and Aladtec, and cited this site's nurse-scheduling-software comparison page
          as a source. It also repeated our own caveat back: newer vendor, limited public review history.
        </p>
      </div>

      <p class="mt-3 text-xs text-gray-500 dark:text-gray-400">
        Each is one response, a sample and not a ranking. Probes run monthly; raw output retained with model, prompt,
        and timestamp.
      </p>

      <div class="mt-4 rounded-2xl border border-amber-300 bg-amber-50 dark:bg-amber-900/20 dark:border-amber-700 p-5">
        <p class="text-xs font-bold uppercase tracking-widest text-amber-700 dark:text-amber-400 mb-1">Data pending</p>
        <p class="text-sm text-amber-800 dark:text-amber-300">
          Dated prompt logs for Perplexity and Bing Copilot (ChatGPT and Google AI Overview logging started 12 to 13
          July 2026).
        </p>
      </div>
    </div>
  </section>

  <!-- 5. Market noticed -->
  <section class="bg-white">
    <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6 lg:px-8">
      <p class="text-xs font-semibold uppercase tracking-widest text-primary mb-3">05 · External validation</p>
      <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">
        An unsolicited acquisition inquiry
      </h2>
      <p class="mt-4 text-muted">
        On 16 June 2026 the CEO of a software acquirer backed by Accel, TCV, and Prosus sent us an unsolicited email. He
        had spent the year building an acquisition thesis on nurse scheduling software, found SimpleScheduleAI inside
        it, and asked to start a dialogue. His words:
      </p>

      <div class="mt-6 space-y-4">
        <blockquote class="rounded-2xl border-l-4 border-primary bg-page dark:bg-slate-800 p-6 shadow-sm">
          <p class="text-lg text-gray-900 dark:text-white">
            &ldquo;I spent this year defining our thesis re nurse scheduling software and the value prop you've built at
            SimpleScheduleAI really resonated.&rdquo;
          </p>
        </blockquote>
        <blockquote class="rounded-2xl border-l-4 border-primary bg-page dark:bg-slate-800 p-6 shadow-sm">
          <p class="text-lg text-gray-900 dark:text-white">
            &ldquo;Where the likes of ShiftWizard and UKG have forced lean CAH teams into bloated platforms they must
            operate themselves, your AI-plus-human service model solves the Sunday night rebuild crisis rural nurse
            managers face every week.&rdquo;
          </p>
        </blockquote>
      </div>
      <p class="mt-3 text-xs text-gray-500 dark:text-gray-400">
        Verbatim from the original email, 16 June 2026. Sender identity shared on request.
      </p>

      <p class="mt-6 text-muted">
        He described our positioning back to us, unprompted. We are below their acquisition threshold today, so we are
        treating this as validation and a relationship for later, not a deal. Separately, a team operating in the same
        space reached out about investing, and a healthcare-AI founder with a 100k-user product has offered warm
        introductions to healthcare VCs when we raise.
      </p>
    </div>
  </section>

  <!-- 6. What's next / CTA -->
  <section class="bg-[#1A2332] dark:bg-black">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8 text-center">
      <p class="text-xs font-semibold uppercase tracking-widest text-[#7BAF9B] mb-4">06 · What's next</p>
      <h2 class="text-3xl font-bold tracking-tight text-white">Next: sign the first design partner hospital</h2>
      <p class="mt-4 text-gray-400 max-w-xl mx-auto">
        Run their schedules end to end, learn from it, then repeat. The pipeline for this is live. If you want the
        deeper walkthrough or the numbers behind any claim on this page, talk to us.
      </p>

      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href={calLink}
          target="_blank"
          rel="noopener noreferrer"
          class="btn text-white border-white/30 hover:bg-white/10 hover:border-white w-full sm:w-auto"
        >
          Book 30 minutes with Gautham
        </a>
        <a href="/ask" class="btn text-white border-white/30 hover:bg-white/10 hover:border-white w-full sm:w-auto">
          See how you can help
        </a>
      </div>
      <p class="mt-6 text-sm text-gray-500">Gautham · SimpleScheduleAI.com</p>
    </div>
  </section>

  <style is:global>
    @media print {
      #header,
      footer {
        display: none !important;
      }
      section {
        break-inside: avoid;
      }
    }
  </style>
</Layout>
