---
import Layout from '~/layouts/PageLayout.astro';
import SchemaOrg from '~/components/common/SchemaOrg.astro';
import DarkHero from '~/components/widgets/DarkHero.astro';

const metadata = {
  title: 'Pricing',
  description:
    'Monthly pricing for the SimpleScheduleAI AI-native nurse scheduling service. One price per hospital, not per nurse, set by your roster size.',
};

const ctaLink = 'https://cal.com/gautham-8bdvdx/30min';

// Retainer itemization: what the month buys, grouped so an administrator can
// defend the renewal to their board. Groups: cycle runs / accountability /
// changes included / paper trail.
const monthBuys = [
  {
    title: 'The cycle runs',
    items: [
      'AI-built schedule every cycle, checked by our scheduling team, approved by you',
      'All 21 scheduling rules checked automatically (safety, coverage, fairness)',
      'Excel in, post-ready PDF and Excel out, no software for your staff',
    ],
  },
  {
    title: 'Someone is accountable',
    items: [
      'Ranked callout replacements when a nurse calls out or takes leave, any hour',
      'A named contact with a written escalation protocol: coverage-blocking issues get a response within 1 hour in business hours, 3 hours after',
    ],
  },
  {
    title: 'Changes are included',
    items: [
      'Unit rule updates (charge coverage, skill mix, on-call limits) applied for the next cycle',
      'Roster changes adjust your plan at the next billing cycle, not your workflow',
    ],
  },
  {
    title: 'The paper trail',
    items: [
      'A manager summary of what we did each cycle: drafts built, callouts covered, changes applied',
      'FLSA overtime and CMS staffing documentation (§485.631) maintained for you, with the full audit trail',
    ],
  },
];

const tiers = [
  {
    name: 'Core',
    price: '$1,000',
    roster: 'Up to 20 nurses',
    note: 'For single-unit Critical Access Hospitals.',
    featured: false,
  },
  {
    name: 'Plus',
    price: '$1,500',
    roster: '21 to 40 nurses',
    note: 'For larger or multi-unit rosters.',
    featured: true,
  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'SimpleScheduleAI AI-Native Nurse Scheduling Service',
  description:
    'AI-native nurse scheduling service for Critical Access Hospitals in Texas. Flat monthly price per hospital by roster size.',
  provider: { '@id': 'https://simplescheduleai.com/#organization' },
  serviceType: 'Nurse Scheduling',
  areaServed: { '@type': 'State', name: 'Texas' },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'USD',
    lowPrice: '1000',
    highPrice: '1500',
    offerCount: '2',
    description: 'Flat monthly price per hospital, by roster size',
  },
};

const pricingBreadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://simplescheduleai.com' },
    { '@type': 'ListItem', position: 2, name: 'Pricing', item: 'https://simplescheduleai.com/pricing' },
  ],
};
---

<Layout metadata={metadata}>
  <SchemaOrg slot="head" schema={[serviceSchema, pricingBreadcrumbSchema]} />

  <DarkHero
    badge="One price per hospital, not per nurse."
    title="Simple pricing for Critical Access Hospitals"
    subtitle="One monthly price per hospital, set by your roster size. AI builds your schedule, our scheduling team checks it, you approve. When something slips on our side, you have a name and a number, not a ticket queue."
    actions={[{ text: 'Book a call with our team', href: ctaLink, variant: 'secondary' }]}
  />

  <!-- Pricing tiers -->
  <section class="bg-page">
    <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
      <div class="grid gap-6 md:grid-cols-2">
        {
          tiers.map((tier) => (
            <div
              class={`rounded-2xl border p-8 ${tier.featured ? 'border-primary/50 bg-primary/5' : 'border-hairline bg-white dark:bg-slate-800'}`}
            >
              <div class="flex items-center justify-between">
                <h2 class="text-xl font-bold">{tier.name}</h2>
              </div>
              <p class="mt-4 text-4xl font-bold">
                {tier.price}
                <span class="text-base font-medium text-muted">/month</span>
              </p>
              <p class="mt-1 text-sm font-medium text-primary">{tier.roster}</p>
              <p class="mt-2 text-sm text-muted">{tier.note}</p>
              <a href="/contact" class={`btn mt-6 w-full ${tier.featured ? 'btn-primary' : ''}`}>
                Get your first schedule
              </a>
            </div>
          ))
        }
      </div>

      <p class="mt-6 text-center text-sm text-muted">
        One price per hospital, billed monthly, cancel anytime. No per-nurse fees, no setup fees. If your roster size
        changes, your plan adjusts at the next billing cycle. Rosters above 40 nurses or multi-facility groups,
        <a href={ctaLink} class="text-primary underline">talk to us</a>.
      </p>

      <!-- What the month buys: retainer itemization -->
      <div class="mt-14">
        <h2 class="font-heading text-2xl font-semibold">What the month buys</h2>
        <p class="mt-2 text-muted">The checklist your administrator can put in front of the board at renewal.</p>
        <div class="mt-6 grid gap-x-10 gap-y-8 sm:grid-cols-2">
          {
            monthBuys.map((group) => (
              <div class="border-t border-ink/10 pt-5">
                <h3 class="text-lg font-bold">{group.title}</h3>
                <ul class="mt-3 space-y-2.5">
                  {group.items.map((item) => (
                    <li class="flex items-start gap-3">
                      <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" />
                      <span class="text-default/80">{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <p class="mt-8 text-sm text-muted">
          Onboarding in 3 to 5 business days, no IT setup. The full escalation protocol, response times included, is
          published on <a href="/how-it-works" class="text-primary underline">how it works</a>.
        </p>
      </div>

      <!-- ROI framing -->
      <div class="mt-12 border-t border-ink/10 pt-10 text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">What it replaces</p>
        <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-muted dark:text-slate-300">
          A nurse manager who spends <a href="/blog/nurse-manager-scheduling-time-breakdown" class="underline"
            >8 to 12 hours a week</a
          > building the schedule, working the callout phone tree, and tracking overtime is spending the equivalent of a
          part-time salary on work the AI now does. At an illustrative $50/hr loaded rate, that is roughly $26,000 a year
          in leadership time, most of it returned to patient care.
        </p>
      </div>
    </div>
  </section>
</Layout>
