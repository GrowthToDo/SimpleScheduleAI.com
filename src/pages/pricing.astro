---
import Layout from '~/layouts/PageLayout.astro';
import SchemaOrg from '~/components/common/SchemaOrg.astro';
import DarkHero from '~/components/widgets/DarkHero.astro';

const metadata = {
  title: 'Pricing',
  description:
    'Flat monthly pricing for the SimpleScheduleAI AI-native nurse scheduling service. One price per facility, by roster size. No per-nurse fees, no IT setup.',
};

const ctaLink = 'https://cal.com/gautham-8bdvdx/30min';

const included = [
  'AI-built schedule every cycle, checked by our scheduling team, approved by you',
  'All 21 scheduling rules checked automatically (safety, coverage, fairness)',
  'Ranked callout replacements when a nurse calls out or takes leave',
  'Texas overtime and CMS §485.635 documentation maintained for you',
  'Excel in, post-ready PDF and Excel out, no software for your staff',
  'Onboarding in 3 to 5 business days, no IT setup',
];

const tiers = [
  {
    name: 'Core',
    price: '$1,000',
    roster: 'Up to 20 nurses',
    note: 'For single-unit Critical Access Hospitals.',
    featured: false,
  },
  {
    name: 'Plus',
    price: '$1,500',
    roster: '21 to 40 nurses',
    note: 'For larger or multi-unit rosters.',
    featured: true,
  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'SimpleScheduleAI AI-Native Nurse Scheduling Service',
  description:
    'AI-native nurse scheduling service for Critical Access Hospitals in Texas. Flat monthly price per facility by roster size.',
  provider: { '@id': 'https://simplescheduleai.com/#organization' },
  serviceType: 'Nurse Scheduling',
  areaServed: { '@type': 'State', name: 'Texas' },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'USD',
    lowPrice: '1000',
    highPrice: '1500',
    offerCount: '2',
    description: 'Flat monthly price per facility, by roster size',
  },
};

const pricingBreadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://simplescheduleai.com' },
    { '@type': 'ListItem', position: 2, name: 'Pricing', item: 'https://simplescheduleai.com/pricing' },
  ],
};
---

<Layout metadata={metadata}>
  <SchemaOrg slot="head" schema={[serviceSchema, pricingBreadcrumbSchema]} />

  <DarkHero
    badge="Flat price. No per-nurse fees."
    title="Simple pricing for Critical Access Hospitals"
    subtitle="One flat monthly price per facility, set by your roster size. The AI builds the schedule, our scheduling team checks it, your manager approves. No IT setup, no long-term contract."
    actions={[{ text: 'Book a call with our team', href: ctaLink, variant: 'secondary' }]}
  />

  <!-- Pricing tiers -->
  <section class="bg-page">
    <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
      <div class="grid gap-6 md:grid-cols-2">
        {
          tiers.map((tier) => (
            <div
              class={`rounded-2xl border p-8 ${tier.featured ? 'border-primary/50 bg-primary/5' : 'border-hairline bg-white dark:bg-slate-800'}`}
            >
              <div class="flex items-center justify-between">
                <h2 class="text-xl font-bold">{tier.name}</h2>
              </div>
              <p class="mt-4 text-4xl font-bold">
                {tier.price}
                <span class="text-base font-medium text-muted">/month</span>
              </p>
              <p class="mt-1 text-sm font-medium text-primary">{tier.roster}</p>
              <p class="mt-2 text-sm text-muted">{tier.note}</p>
              <a href="/contact" class={`btn mt-6 w-full ${tier.featured ? 'btn-primary' : ''}`}>
                Get your first schedule
              </a>
            </div>
          ))
        }
      </div>

      <p class="mt-6 text-center text-sm text-muted">
        Flat per-facility price, billed monthly. Every engagement starts with a 60-day pilot on your own roster, billed
        at the same rate from day one, cancel anytime. No per-nurse fees, no setup fees. If your roster size changes,
        your plan adjusts at the next billing cycle. Rosters above 40 nurses or multi-facility groups,
        <a href={ctaLink} class="text-primary underline">talk to us</a>.
      </p>

      <!-- What's included -->
      <div class="mt-14">
        <h2 class="font-heading text-2xl font-semibold">Every plan includes</h2>
        <ul class="mt-6 grid gap-x-10 sm:grid-cols-2">
          {
            included.map((item) => (
              <li class="flex items-start gap-3 border-t border-ink/10 py-3.5">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" />
                <span class="text-default/80">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- ROI framing -->
      <div class="mt-12 border-t border-ink/10 pt-10 text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">What it replaces</p>
        <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-muted dark:text-slate-300">
          A nurse manager who spends 8 to 12 hours a week building the schedule, working the callout phone tree, and
          tracking overtime is spending the equivalent of a part-time salary on work the AI now does. At a $50/hr loaded
          rate, that is roughly $26,000 a year in leadership time, most of it returned to patient care.
        </p>
      </div>
    </div>
  </section>
</Layout>
